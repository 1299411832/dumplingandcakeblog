# ===== 环境变量模板 =====
# 复制此文件为 .env 并填入真实值

# 高德地图 Key
# 申请地址: https://console.amap.com/dev/key/app
PUBLIC_AMAP_KEY=
PUBLIC_AMAP_KEY_PLACES=

# Umami 统计
PUBLIC_UMAMI_BASE=
PUBLIC_UMAMI_USERNAME=
PUBLIC_UMAMI_PASSWORD=
PUBLIC_UMAMI_WEBSITE_ID=

# Waline 评论
PUBLIC_WALINE_SERVER=

# 后台管理密码哈希 (SHA-256)
# 生成方式: echo -n "你的密码" | sha256sum
PUBLIC_ADMIN_PASSWORD_HASH=

# GitHub Token（需要 repo 权限，用于 Vercel 生产环境通过 API 写文件）
# 创建地址: https://github.com/settings/tokens/new?scopes=repo
GITHUB_TOKEN=

# GitHub 仓库信息（Vercel 环境写入 Content Collection 需要）
GITHUB_REPO_OWNER=tianshihao2003
GITHUB_REPO_NAME=dumplingandcakeblog
GITHUB_REPO_BRANCH=main

# 自建 API 后端 JWT Secret（随机生成 64 位 hex 字符串）
# 生成方式: openssl rand -hex 32
ADMIN_JWT_SECRET=

# CloudFlare ImgBed 图床（用于说说/足迹图片上传）
# 部署地址，不带末尾斜杠
PUBLIC_IMAGEBED_URL=
# 上传认证码
PUBLIC_IMAGEBED_AUTH_CODE=
# 上传目录（相对路径，如 "moments"），留空则上传到根目录
PUBLIC_IMAGEBED_FOLDER=手机uu
# API Token（需要 list 权限，用于上传前查重，避免重复上传相同图片）
PUBLIC_IMAGEBED_API_TOKEN=
