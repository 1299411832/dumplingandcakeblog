---
interface Props {
	data: { category: string; amount: number; count: number }[];
	totalCount: number;
	totalIncome: number;
}
const { data, totalCount, totalIncome } = Astro.props;
const fmt = (n: number) => n.toFixed(2);
const icons: Record<string, string> = {
	职业收入: "💼",
	工资: "💼",
	人情收礼: "🙂",
	其他收入: "➕",
};
const subMap: Record<string, string> = {
	职业收入: "收入类别",
	人情收礼: "收入类别",
	其他收入: "收入类别",
};
---
<div class="income-card">
  <div class="income-head">
    <h3 class="income-title">本月分类收入</h3>
    <span class="income-sub">收入笔数 {totalCount} &nbsp; 总收入 <b class="income-total">{fmt(totalIncome)}</b></span>
  </div>
  <div class="income-list">
    {data.map(item => (
      <div class="income-row">
        <span class="income-icon">{icons[item.category] ?? "💰"}</span>
        <div class="income-main">
          <div class="income-cat">{item.category}</div>
          <div class="income-cat-sub">{subMap[item.category] ?? "收入类别"}</div>
        </div>
        <div class="income-amounts">
          <span>收入笔数 {item.count}</span>
          <span>总收入 <b class="income-amt">{fmt(item.amount)}</b></span>
        </div>
      </div>
    ))}
  </div>
</div>
<style>
@reference "../../styles/main.css";
.income-card{ background:#fff; border:1px solid oklch(0 0 0 / 0.06); border-radius:0.75rem; padding:0.7rem 0.85rem 0.55rem; }
:root.dark .income-card{ background: oklch(0.16 0 0 / 0.86); border-color: oklch(1 0 0 / 0.08); }
.income-head{ display:flex; align-items:baseline; justify-content:space-between; gap:0.6rem; margin-bottom:0.4rem; }
.income-title{ font-size:0.82rem; font-weight:700; }
.income-sub{ font-size:0.62rem; color:var(--guestbook-muted); white-space:nowrap; }
.income-total{ color:#ef4444; font-weight:700; }
.income-list{ display:flex; flex-direction:column; }
.income-row{ display:grid; grid-template-columns:1.6rem 1fr auto; gap:0.6rem; align-items:center; padding:0.6rem 0; border-bottom:1px solid oklch(0 0 0 / 0.06); }
:root.dark .income-row{ border-color: oklch(1 0 0 / 0.06); }
.income-row:last-child{ border-bottom:none; }
.income-icon{ width:1.5rem; height:1.5rem; display:flex; align-items:center; justify-content:center; background:#fef2f2; border:1px solid #fee2e2; border-radius:0.4rem; font-size:0.85rem; }
:root.dark .income-icon{ background: oklch(0.25 0.12 25 / 0.2); border-color: transparent; }
.income-main{ min-width:0; }
.income-cat{ font-size:0.78rem; font-weight:600; }
.income-cat-sub{ font-size:0.62rem; color:var(--guestbook-muted); }
.income-amounts{ display:flex; flex-direction:column; align-items:flex-end; font-size:0.62rem; color:var(--guestbook-muted); gap:0.1rem; }
.income-amt{ color:#ef4444; font-weight:700; }
</style>
