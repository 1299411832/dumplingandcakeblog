---
interface Props {
  today: { income: number; expense: number; label: string };
  month: { income: number; expense: number; label: string };
  year: { income: number; expense: number; label: string };
}
const { today, month, year } = Astro.props;
const fmt = (n: number) => n.toFixed(2);
const rows = [
  { key: "今天", sub: today.label, income: today.income, expense: today.expense, icon: "▤", iconClass: "icon--today" },
  { key: "本月", sub: month.label, income: month.income, expense: month.expense, icon: "▦", iconClass: "icon--month" },
  { key: "本年", sub: year.label, income: year.income, expense: year.expense, icon: "▧", iconClass: "icon--year" },
];
---
<div class="period-card">
  {rows.map(r => (
    <div class="period-row">
      <span class={`period-icon ${r.iconClass}`}>{r.icon}</span>
      <div class="period-main">
        <div class="period-key">{r.key}</div>
        <div class="period-sub">{r.sub}</div>
      </div>
      <div class="period-amounts">
        <span class="period-amt">总收入 <b class="amt-income">{fmt(r.income)}</b></span>
        <span class="period-amt">总支出 <b class="amt-expense">{fmt(r.expense)}</b></span>
      </div>
    </div>
  ))}
</div>
<style>
@reference "../../styles/main.css";
.period-card{ background:#fff; border:1px solid oklch(0 0 0 / 0.06); border-radius:0.75rem; padding:0.55rem 0.9rem; display:flex; flex-direction:column; }
:root.dark .period-card{ background: oklch(0.16 0 0 / 0.86); border-color: oklch(1 0 0 / 0.08); }
.period-row{ display:grid; grid-template-columns:1.7rem 1fr auto; gap:0.6rem; align-items:center; padding:0.65rem 0; }
.period-row + .period-row{ border-top:1px solid oklch(0 0 0 / 0.06); }
:root.dark .period-row + .period-row{ border-color: oklch(1 0 0 / 0.06); }
.period-icon{ width:1.55rem; height:1.55rem; display:flex; align-items:center; justify-content:center; border-radius:0.35rem; font-size:0.85rem; border:1px solid transparent; }
.icon--today{ background:#e8f2ff; color:#3b82f6; border-color:#dbeafe; }
.icon--month{ background:#e6f7f0; color:#10b981; border-color:#d1fae5; }
.icon--year{ background:#fef9e7; color:#d97706; border-color:#fef3c7; }
:root.dark .icon--today{ background: oklch(0.22 0.4 250 / 0.25); color:#93c5fd; border-color: transparent; }
:root.dark .icon--month{ background: oklch(0.22 0.4 160 / 0.25); color:#6ee7b7; }
:root.dark .icon--year{ background: oklch(0.22 0.6 80 / 0.2); color:#fcd34d; }
.period-main{ min-width:0; }
.period-key{ font-size:0.82rem; font-weight:700; line-height:1.1; }
.period-sub{ font-size:0.68rem; color:var(--guestbook-muted); margin-top:0.1rem; }
.period-amounts{ display:flex; flex-direction:column; align-items:flex-end; gap:0.08rem; font-size:0.68rem; color:var(--guestbook-muted); }
.period-amt{ white-space:nowrap; }
.amt-income{ color:#ef4444; font-weight:600; margin-left:0.2rem; }
.amt-expense{ color:#0e7490; font-weight:600; margin-left:0.2rem; }
</style>
