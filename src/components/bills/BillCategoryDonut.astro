---
interface Props {
	data: Map<string, number>;
}
const { data } = Astro.props;
const entries = [...data.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6);
const total = [...data.values()].reduce((a, b) => a + b, 0) || 1;
---
<div class="bill-donut">
  <h3 class="bill-donut__title">分类占比</h3>
  <div class="bill-donut__list">
    {entries.map(([k,v]) => (
      <div class="bill-donut__row"><span>{k}</span><span>¥{v}</span><span>{Math.round(v/total*100)}%</span></div>
    ))}
  </div>
  {entries.length===0 && <p class="bill-donut__empty">暂无数据</p>}
</div>
<style>
@reference "../../styles/main.css";
.bill-donut{ background: oklch(1 0 0 / 0.72); backdrop-filter: blur(22px) saturate(1.4); border:1px solid oklch(1 0 0 / 0.55); border-radius:0.75rem; padding:1rem; }
:root.dark .bill-donut{ background: oklch(0.16 0 0 / 0.72); border-color: oklch(1 0 0 / 0.12); }
.bill-donut__title{ font-size:0.85rem; font-weight:700; margin:0 0 0.6rem; }
.bill-donut__row{ display:grid; grid-template-columns:1fr auto auto; gap:0.6rem; font-size:0.8rem; padding:0.25rem 0; border-bottom:1px solid var(--guestbook-line); }
.bill-donut__empty{ color:var(--guestbook-muted); font-size:0.8rem; }
</style>
