---
import type { BillEntry } from "@/utils/bill-adapter";

interface Props {
	groups: Map<string, BillEntry[]>;
}
const { groups } = Astro.props;
---
<div class="bill-list">
  {[...groups.entries()].map(([day, items]) => (
    <section class="bill-day">
      <h3 class="bill-day__head">{day}</h3>
      <div class="bill-day__items">
        {items.map(e => (
          <div class="bill-row">
            <span class="bill-row__cat">{e.data.category}</span>
            <span class="bill-row__desc">{e.data.description || e.data.title || e.data.category}</span>
            <span class="bill-row__acc">{e.data.account}</span>
            <b class="bill-row__amt" data-type={e.data.type}>{e.data.type==='income'?`+${e.data.amount}`:`${e.data.amount}`}</b>
          </div>
        ))}
      </div>
    </section>
  ))}
  {groups.size===0 && <p class="bill-list__empty">暂无流水</p>}
</div>
<style>
@reference "../../styles/main.css";
.bill-day{ margin-bottom:1rem; }
.bill-day__head{ position:sticky; top:0; background: var(--page-bg); font-size:0.78rem; color:var(--guestbook-muted); padding:0.2rem 0; margin:0 0 0.4rem; }
.bill-day__items{ display:flex; flex-direction:column; gap:0.4rem; }
.bill-row{ display:grid; grid-template-columns:auto 1fr auto auto; gap:0.6rem; align-items:center; padding:0.6rem 0.8rem; background: oklch(1 0 0 / 0.72); backdrop-filter: blur(16px); border:1px solid oklch(1 0 0 / 0.45); border-radius:0.6rem; font-size:0.82rem; }
:root.dark .bill-row{ background: oklch(0.16 0 0 / 0.62); border-color: oklch(1 0 0 / 0.1); }
.bill-row__cat{ font-weight:700; }
.bill-row__desc{ color:var(--deep-text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.bill-row__acc{ color:var(--guestbook-muted); font-size:0.72rem; }
.bill-row__amt[data-type="income"]{ color: #15803d; }
.bill-row__amt[data-type="expense"]{ color: #dc2626; }
.bill-list__empty{ color:var(--guestbook-muted); font-size:0.85rem; text-align:center; padding:1rem; }
</style>
