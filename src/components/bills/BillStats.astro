---
interface Props {
	stats: {
		income: number;
		expense: number;
		balance: number;
		asset: number;
		liability: number;
		netAsset: number;
	};
}
const { stats } = Astro.props;
const fmt = (n: number) => `¥${n.toLocaleString("zh-CN")}`;
---
<div class="bill-stats">
  <div class="bill-stat"><span class="bill-stat__label">总资产</span><b class="bill-stat__value">{fmt(stats.asset)}</b><small>收入累计</small></div>
  <div class="bill-stat"><span class="bill-stat__label">负债</span><b class="bill-stat__value">{fmt(stats.liability)}</b><small>待还</small></div>
  <div class="bill-stat"><span class="bill-stat__label">净资产</span><b class="bill-stat__value">{fmt(stats.netAsset)}</b><small>资产-负债</small></div>
  <div class="bill-stat"><span class="bill-stat__label">当月结余</span><b class="bill-stat__value">{fmt(stats.balance)}</b><small>收入-支出</small></div>
</div>
<style>
@reference "../../styles/main.css";
.bill-stats{ display:grid; grid-template-columns:repeat(2,1fr); gap:0.75rem; }
@media(min-width:1024px){ .bill-stats{ grid-template-columns:repeat(4,1fr); } }
.bill-stat{ background: oklch(1 0 0 / 0.72); backdrop-filter: blur(22px) saturate(1.4); -webkit-backdrop-filter: blur(22px) saturate(1.4); border:1px solid oklch(1 0 0 / 0.55); border-radius:0.75rem; padding:0.9rem 1rem; box-shadow:0 8px 32px oklch(0 0 0 / 0.08); }
:root.dark .bill-stat{ background: oklch(0.16 0 0 / 0.72); border-color: oklch(1 0 0 / 0.12); }
.bill-stat__label{ display:block; font-size:0.72rem; color:var(--guestbook-muted); }
.bill-stat__value{ display:block; font-size:1.05rem; margin:0.2rem 0; }
.bill-stat small{ color:var(--guestbook-muted); font-size:0.7rem; }
</style>
