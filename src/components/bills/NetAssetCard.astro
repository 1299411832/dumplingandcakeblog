---
interface Props {
	netAsset: number;
	asset: number;
	liability: number;
}
const { netAsset, asset, liability } = Astro.props;
const fmt = (n: number) => n.toFixed(2);
---
<div class="net-asset">
  <div class="net-asset__bg" aria-hidden="true"></div>
  <div class="net-asset__overlay"></div>
  <div class="net-asset__content">
    <div class="net-asset__label">净资产</div>
    <div class="net-asset__value">
      <span class="net-asset__num">{fmt(netAsset)}</span>
      <span class="net-asset__eye" aria-hidden="true">◉</span>
    </div>
    <div class="net-asset__sub">
      <span>总资产 {fmt(asset)}</span>
      <span class="net-asset__divider">|</span>
      <span>负债 {fmt(liability)}</span>
    </div>
  </div>
</div>
<style>
@reference "../../styles/main.css";
.net-asset{ position:relative; height:10.2rem; border-radius:0.75rem; overflow:hidden; background:#87c7e8; }
.net-asset__bg{ position:absolute; inset:0; background-image:url("https://img.tsh520.cn/file/blog/随机封面图/1787466729659_【哲风壁纸】奶牛-树木-牛.webp"); background-size:cover; background-position:center 35%; }
.net-asset__overlay{ position:absolute; inset:0; background: linear-gradient(90deg, oklch(0 0 0 / 0.28) 0%, oklch(0 0 0 / 0.06) 45%, transparent 65%); }
.net-asset__content{ position:relative; z-index:1; height:100%; display:flex; flex-direction:column; justify-content:center; gap:0.35rem; padding:1.1rem 1.2rem; color:#fff; }
.net-asset__label{ font-size:0.72rem; opacity:0.92; letter-spacing:0.04em; }
.net-asset__value{ display:flex; align-items:center; gap:0.45rem; line-height:1; }
.net-asset__num{ font-size:1.9rem; font-weight:800; letter-spacing:-0.02em; text-shadow:0 1px 8px oklch(0 0 0 / 0.18); }
.net-asset__eye{ font-size:0.95rem; opacity:0.9; }
.net-asset__sub{ display:flex; align-items:center; gap:0.5rem; font-size:0.7rem; opacity:0.92; margin-top:0.15rem; }
.net-asset__divider{ opacity:0.6; }
@media(max-width:768px){
  .net-asset{ height:9rem; }
  .net-asset__num{ font-size:1.6rem; }
}
</style>
