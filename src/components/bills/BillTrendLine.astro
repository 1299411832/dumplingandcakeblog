---
interface Props {
	data: { month: string; balance: number }[];
}
const { data } = Astro.props;
const max = Math.max(...data.map((d) => Math.abs(d.balance)), 1);
---
<div class="bill-trend">
  <h3 class="bill-trend__title">近 6 月结余</h3>
  <div class="bill-trend__bars">
    {data.map(d => (
      <div class="bill-trend__col">
        <div class="bill-trend__bar" style={`height:${Math.round(Math.abs(d.balance)/max*64+8)}px; background:${d.balance>=0?'var(--guestbook-muted)':'oklch(0.55 0.12 25)'}`}></div>
        <small>{d.month.slice(5)}</small><small>{d.balance>=0?`+${d.balance}`:d.balance}</small>
      </div>
    ))}
  </div>
</div>
<style>
@reference "../../styles/main.css";
.bill-trend{ background: oklch(1 0 0 / 0.72); backdrop-filter: blur(22px) saturate(1.4); border:1px solid oklch(1 0 0 / 0.55); border-radius:0.75rem; padding:1rem; }
:root.dark .bill-trend{ background: oklch(0.16 0 0 / 0.72); border-color: oklch(1 0 0 / 0.12); }
.bill-trend__title{ font-size:0.85rem; font-weight:700; margin:0 0 0.6rem; }
.bill-trend__bars{ display:grid; grid-template-columns:repeat(6,1fr); gap:0.5rem; align-items:end; }
.bill-trend__col{ display:flex; flex-direction:column; align-items:center; gap:0.2rem; }
.bill-trend__bar{ width:100%; border-radius:0.4rem; }
.bill-trend__col small{ font-size:0.68rem; color:var(--guestbook-muted); }
</style>
