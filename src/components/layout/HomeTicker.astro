---
import { getCollection } from "astro:content";
import { announcementConfig } from "@/config";
import { externalBangumiConfig } from "@/config/externalBangumiConfig";


const bangumiGistId = externalBangumiConfig.enable ? externalBangumiConfig.gistId : "";

// 收集统计
const summaryParts: string[] = [];

// 欢迎语（位置由客户端 JS 填入）
summaryParts.push("[欢迎] 欢迎来自远方的朋友！");

// 公告
if (announcementConfig.content) {
	summaryParts.push(`[公告] ${announcementConfig.content}`);
}

// 最近三天更新统计
const threeDaysAgo = new Date();
threeDaysAgo.setDate(threeDaysAgo.getDate() - 3);

const updateParts: string[] = [];

try {
	const posts = await getCollection("posts", ({ data }) =>
		import.meta.env.PROD ? data.draft !== true : true,
	);
	const count = posts.filter(
		(p) => new Date(p.data.published) >= threeDaysAgo,
	).length;
	if (count > 0) updateParts.push(`${count} 篇文章`);
} catch {}

try {
	const moments = await getCollection("moments");
	const count = moments.filter(
		(m) => new Date(m.data.published) >= threeDaysAgo,
	).length;
	if (count > 0) updateParts.push(`${count} 条动态`);
} catch {}

try {
	const bangumi = await getCollection("bangumi");
	const count = bangumi.filter(
		(b) => b.data.published && new Date(b.data.published) >= threeDaysAgo,
	).length;
	if (count > 0) updateParts.push(`${count} 部影视`);
} catch {}

try {
	const notebooks = await getCollection("notebooks");
	const count = notebooks.filter(
		(n) =>
			!n.id.includes("_index") &&
			n.data.date &&
			new Date(n.data.date) >= threeDaysAgo,
	).length;
	if (count > 0) updateParts.push(`${count} 篇笔记`);
} catch {}

try {
	const changelog = await getCollection("changelog");
	const count = changelog.filter(
		(c) => new Date(c.data.date) >= threeDaysAgo,
	).length;
	if (count > 0) updateParts.push(`${count} 条日志`);
} catch {}

if (updateParts.length > 0) {
	summaryParts.push(`[更新] 最近三天更新了 ${updateParts.join("、")}`);
} else {
	summaryParts.push("[更新] 最近三天暂无更新");
}

const tickerContent = summaryParts.join(" \u00d7 ");
---

{
	tickerContent && (
		<section class="home-ticker" aria-label="公告跑马灯" id="home-ticker" data-bangumi-gist={bangumiGistId}>
			<div class="home-ticker__inner">
				<div class="home-ticker__track">
					<span class="home-ticker__text">{tickerContent}</span>
					<span class="home-ticker__text" aria-hidden="true">{tickerContent}</span>
					<span class="home-ticker__text" aria-hidden="true">{tickerContent}</span>
				</div>
			</div>
		</section>
	)
}

<script>
	function updateTickerLocation() {
		if (!navigator.onLine) return;
		fetch("https://api.bigdatacloud.net/data/reverse-geocode-client?localityLanguage=zh")
			.then((r) => r.json())
			.then((data) => {
				const parts = [data.principalSubdivision, data.city].filter(Boolean);
				const loc = parts.slice(0, 2).join(" ");
				if (!loc) return;
				document.querySelectorAll(".home-ticker__text").forEach((el) => {
					el.textContent = (el.textContent || "").replace(/欢迎来自远方的朋友/g, `欢迎来自 ${loc} 的朋友`);
				});
			})
			.catch(() => {});
	}

	function updateTickerBangumi() {
		var gistId = document.getElementById("home-ticker")?.getAttribute("data-bangumi-gist");
		if (!gistId) return;

		fetch("https://api.github.com/gists/" + gistId, {
			headers: { "Accept": "application/vnd.github+json" }
		})
			.then(function(r) { if (!r.ok) return null; return r.json(); })
			.then(function(gist) {
				var file = gist.files["bangumi.json"];
				if (!file) return;
				var items: any[] = [];
				try { items = JSON.parse(file.content || "[]"); } catch(e) { return; }
				if (!Array.isArray(items) || !items.length) return;

				var threeDaysAgo = new Date();
				threeDaysAgo.setDate(threeDaysAgo.getDate() - 3);
				var count = items.filter(function(item) {
					return item.updated_at && new Date(item.updated_at) >= threeDaysAgo;
				}).length;

				if (count <= 0) return;

				document.querySelectorAll(".home-ticker__text").forEach(function(el) {
					var text = el.textContent || "";
					if (text.indexOf("部影视") !== -1) return;
					if (text.indexOf("[更新]") !== -1) {
						text = text.replace(/(\[更新\] 最近三天更新了 )/, "$1" + count + " 部影视、");
						text = text.replace(/、\s*×/g, " ×");
						el.textContent = text;
					}
				});
			})
			.catch(function() {});
	}

	updateTickerLocation();
	updateTickerBangumi();
	document.addEventListener("astro:page-load", () => {
		updateTickerLocation();
		updateTickerBangumi();
	});
</script>
