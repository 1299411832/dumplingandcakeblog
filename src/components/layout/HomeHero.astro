---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { profileConfig, siteConfig } from "@/config";
import { readdirSync, existsSync } from "node:fs";
import { join } from "node:path";

const workHours = siteConfig.workHours ?? {
	start: 9,
	end: 18,
	workDays: [1, 2, 3, 4, 5],
};

const imageFiles = import.meta.glob<ImageMetadata>(
	"../../assets/images/**/*.{png,jpg,jpeg,webp,avif,gif}",
	{
		import: "default",
	},
);

async function optimizeHeroImage(image: ImageMetadata) {
	const optimized = await getImage({
		src: image,
		format: "webp",
		widths: [320],
	});
	return optimized.src;
}

async function resolveHeroImage(src?: string) {
	if (!src) return "";
	if (
		src.startsWith("/") ||
		src.startsWith("http://") ||
		src.startsWith("https://") ||
		src.startsWith("data:")
	) {
		return src;
	}

	const normalizedPath = `../../${src}`.replace(/\\/g, "/");
	const loadImage = imageFiles[normalizedPath];
	if (!loadImage) {
		return `/${src}`;
	}

	const image = await loadImage();
	return optimizeHeroImage(image);
}

const workAvatarEntries = Object.entries(imageFiles)
	.filter(([filePath]) => filePath.includes("/avatar_sb/"))
	.sort(([a], [b]) => a.localeCompare(b));

const workAvatarUrls = await Promise.all(
	workAvatarEntries.map(async ([, loadImage]) =>
		optimizeHeroImage(await loadImage()),
	),
);

const avatarUrl =
	workAvatarUrls[0] ?? (await resolveHeroImage(profileConfig.avatar));
const avatarOffUrl = profileConfig.avatarOffWork
	? await resolveHeroImage(profileConfig.avatarOffWork)
	: avatarUrl;

const heroBioText = Array.isArray(profileConfig.bio)
	? profileConfig.bio[0] || ""
	: profileConfig.bio || "";

const nameLetters = Array.from(profileConfig.displayName || "");

// 主页桌面端背景图片随机方案（自动扫描 home 文件夹）
// 只需在 public/assets/images/home/ 下添加 home1、home2、home3... 文件夹即可
const homeDir = join(process.cwd(), "public/assets/images/home");
const homeSchemes: { bg: string; decoration: string }[] = [];

try {
	const entries = readdirSync(homeDir, { withFileTypes: true });
	for (const entry of entries) {
		if (entry.isDirectory() && /^home\d+$/.test(entry.name)) {
			const bgPath = `/assets/images/home/${entry.name}/home.webp`;
			const decorationPath = `/assets/images/home/${entry.name}/home2.webp`;
			if (existsSync(join(homeDir, entry.name, "home.webp"))) {
				homeSchemes.push({
					bg: bgPath,
					decoration: decorationPath,
				});
			}
		}
	}
} catch (e) {
	// fallback
	homeSchemes.push({
		bg: "/assets/images/home/home1/home.webp",
		decoration: "/assets/images/home/home1/home2.webp",
	});
}

// 构建时随机选一张（每次构建结果不同，无需客户端切换）
const randomScheme = homeSchemes[Math.floor(Math.random() * homeSchemes.length)] || homeSchemes[0];

// 移动端背景图随机选择
const mobileBgDir = join(process.cwd(), "public/assets/images/mobile-bg");
const mobileBgs: string[] = [];
try {
	const mobileEntries = readdirSync(mobileBgDir);
	for (const file of mobileEntries) {
		if (/\.(webp|png|jpg|jpeg|avif)$/i.test(file)) {
			mobileBgs.push(`/assets/images/mobile-bg/${file}`);
		}
	}
} catch (e) {
	// ignore
}
---

<section class="home-hero" id="home-hero"
	data-avatar={avatarUrl}
	data-avatar-pool={JSON.stringify(workAvatarUrls)}
	data-avatar-off={avatarOffUrl}
	data-work-hours={JSON.stringify(workHours)}
>
	<img class="home-hero__video hidden md:block" src={randomScheme.bg} alt="" id="desktop-bg" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;" />
	<img class="home-hero__video block md:hidden" src={mobileBgs[Math.floor(Math.random() * mobileBgs.length)] || "/assets/images/home/18188682411036032.webp"} alt="" id="mobile-bg" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0;" />

	<div class="home-hero__canvas-container" id="main-canvas">
		<div class="home-hero__bracket home-hero__bracket--tl"></div>
		<div class="home-hero__bracket home-hero__bracket--br"></div>
		<div class="home-hero__bottom-line" aria-hidden="true"></div>
		<div class="home-hero__left-line" aria-hidden="true"></div>

		<section class="home-hero__left-panel">
			<div class="home-hero__profile">
				<div class="home-hero__identity-row">
					<div class="home-hero__name-group">
						{profileConfig.occupation && (
							<p class="home-hero__occupation">{profileConfig.occupation}</p>
						)}
						{profileConfig.displayName && (
							<h1 class="home-hero__name home-hero__name--rainbow">
								{nameLetters.map((letter, i) => (
									<span class="home-hero__name-letter" data-letter-index={i}>{letter}</span>
								))}
							</h1>
						)}
						<div class="home-hero__name-badge">{siteConfig.title}</div>
					</div>

					<div class="home-hero__avatar-group">
						<div class="home-hero__avatar-wrapper">
							<img
								src={avatarUrl}
								alt="avatar"
								class="home-hero__avatar"
								id="hero-avatar"
								loading="eager"
							/>
						</div>
						<div class="home-hero__status-badge" id="work-status">
							<span class="home-hero__status-dot"></span>
							<span class="home-hero__status-text">上班中</span>
						</div>
					</div>
				</div>

				{heroBioText && (
					<div class="home-hero__motto-wrapper">
						<p class="home-hero__motto-text">{heroBioText}</p>
					</div>
				)}
			</div>
		</section>

		<section class="home-hero__center-panel">
			<div class="home-hero__art-window"></div>
			<div class="home-hero__character-root" id="character-layer">
				<div class="home-hero__character-reveal">
					<div class="home-hero__character-motion">
						<img
							src={randomScheme.decoration}
							alt="character"
							class="home-hero__character-img" id="desktop-decoration"
							loading="eager"
						/>
					</div>
				</div>
			</div>
			<div class="home-hero__speech" aria-label="Character message">
				<p class="home-hero__speech-text">
					<span class="home-hero__speech-type">团子和蛋糕？</span>
				</p>
				<p class="home-hero__speech-en">
					<span class="home-hero__speech-type">Welcome to my blog, enjoy your stay!</span>
				</p>
				<img
					src="/assets/images/home/home2-1.webp"
					alt=""
					class="home-hero__speech-accent"
					loading="eager"
					aria-hidden="true"
				/>
			</div>
		</section>

		<aside class="home-hero__right-panel">
			<div class="home-hero__pill">BLOG</div>
			<div class="home-hero__vertical-wrap">
				<span class="home-hero__v-title">博客</span>
				<span class="home-hero__v-sub">{profileConfig.name || ""}</span>
				<span class="home-hero__diamond">✦</span>
				<span class="home-hero__v-sub">CREATIVE</span>
			</div>
			<div class="home-hero__panel-footer">
				<div class="home-hero__footer-line"></div>
				<p class="home-hero__micro-text">システム起動完了</p>
			</div>
		</aside>
	</div>
</section>

<script>
	// 背景图已由服务端构建时随机选择（见 frontmatter），无需客户端切换 src

	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { VFX } from "@vfx-js/core";
	import { waitForPageLoaderHidden } from "@/utils/page-loader-controller.js";
	import { HatchEffect } from "@/utils/hatch-effect.ts";

	gsap.registerPlugin(ScrollTrigger);

	let workStatusTimer: number | null = null;
	let heroOpeningTimeline: ReturnType<typeof gsap.timeline> | null = null;
	let vfxInstance: VFX | null = null;
	let heroHatchEffect: HatchEffect | null = null;

	// ============================================
	// 玻璃雨珠 + 撞击水花（Canvas 2D）
	// ============================================
	type RainDrop = { x: number; y: number; r: number; vy: number; len: number; alpha: number };
	type SplashParticle = { x: number; y: number; vx: number; vy: number; life: number; maxLife: number; r: number };
	type HitEdge = { x1: number; x2: number; y: number };
	let rainCanvas: HTMLCanvasElement | null = null;
	let rainCtx: CanvasRenderingContext2D | null = null;
	let rainRaf = 0;
	let rainDrops: RainDrop[] = [];
	let rainSplashes: SplashParticle[] = [];
	let rainEdges: HitEdge[] = [];
	let rainResizeHandler: (() => void) | null = null;
	let rainEdgeTimer = 0;
	let rainDpr = 1;
	const rainIntensity = 0.6;

	// 轻量伪随机
	let vfxSeed = 20260712;
	function vfxRand() {
		vfxSeed = (vfxSeed * 1664525 + 1013904223) % 4294967296;
		return vfxSeed / 4294967296;
	}

	function rainStroke() {
		return "255, 255, 255";
	}

	function collectRainEdges(hero: HTMLElement) {
		const heroRect = hero.getBoundingClientRect();
		const edges: HitEdge[] = [];
		// 聊天框和装饰角标作为撞击线
		const selectors = [
			".home-hero__speech",
			".home-hero__bracket",
		];
		for (const selector of selectors) {
			hero.querySelectorAll<HTMLElement>(selector).forEach((el) => {
				const rect = el.getBoundingClientRect();
				if (rect.width < 2 || rect.height < 2) return;
				edges.push({
					x1: rect.left - heroRect.left,
					x2: rect.right - heroRect.left,
					y: rect.top - heroRect.top,
				});
			});
		}
		rainEdges = edges;
	}

	function spawnSplash(x: number, y: number) {
		if (rainSplashes.length > 90) return;
		const count = 6 + Math.floor(vfxRand() * 4);
		for (let i = 0; i < count; i++) {
			const angle = -Math.PI / 2 + (vfxRand() - 0.5) * 1.9;
			const speed = 1.1 + vfxRand() * 2.2;
			rainSplashes.push({
				x,
				y,
				vx: Math.cos(angle) * speed,
				vy: Math.sin(angle) * speed,
				life: 0,
				maxLife: 22 + Math.floor(vfxRand() * 16),
				r: 0.8 + vfxRand() * 1.1,
			});
		}
	}

	function makeDrop(w: number, h: number, fromTop: boolean): RainDrop {
		return {
			x: vfxRand() * w,
			y: fromTop ? -vfxRand() * h * 0.5 : vfxRand() * h,
			r: 0.9 + vfxRand() * 1.4,
			vy: 2.4 + vfxRand() * 3.2,
			len: 9 + vfxRand() * 16,
			alpha: 0.12 + vfxRand() * 0.2,
		};
	}

	function initHeroRain() {
		const hero = document.getElementById("home-hero");
		if (!hero) return;
		if (prefersReducedMotion() || isMobile()) return;

		destroyHeroRain();

		const canvas = document.createElement("canvas");
		canvas.className = "home-hero__rain-canvas";
		canvas.setAttribute("aria-hidden", "true");
		hero.appendChild(canvas);
		const ctx = canvas.getContext("2d");
		if (!ctx) {
			canvas.remove();
			return;
		}
		rainCanvas = canvas;
		rainCtx = ctx;
		rainDpr = Math.min(window.devicePixelRatio || 1, 1.5);

		function resize() {
			if (!rainCanvas || !rainCtx || !hero) return;
			const rect = hero.getBoundingClientRect();
			rainCanvas.width = Math.round(rect.width * rainDpr);
			rainCanvas.height = Math.round(rect.height * rainDpr);
			rainCtx.setTransform(rainDpr, 0, 0, rainDpr, 0, 0);
			const target = Math.round((20 + rainIntensity * 40) * Math.min(1, rect.width / 1280));
			rainDrops = Array.from({ length: target }, () => makeDrop(rect.width, rect.height, false));
			collectRainEdges(hero);
		}
		resize();
		rainResizeHandler = resize;
		window.addEventListener("resize", resize);
		rainEdgeTimer = window.setInterval(() => collectRainEdges(hero), 500);

		function frame() {
			if (!rainCanvas || !rainCtx) return;
			const w = rainCanvas.width / rainDpr;
			const h = rainCanvas.height / rainDpr;
			rainCtx.clearRect(0, 0, w, h);
			const rgb = rainStroke();

			// 雨珠 + 水痕拖尾
			for (const d of rainDrops) {
				const prevY = d.y;
				d.y += d.vy;

				// 撞击检测
				let consumed = false;
				for (const e of rainEdges) {
					if (prevY < e.y && d.y >= e.y && d.x >= e.x1 && d.x <= e.x2) {
						spawnSplash(d.x, e.y);
						d.y = -vfxRand() * 40;
						d.x = vfxRand() * w;
						consumed = true;
						break;
					}
				}
				// 落到底部同样迸溅
				if (!consumed && prevY < h && d.y >= h) {
					spawnSplash(d.x, h - 1);
					d.y = -vfxRand() * 40;
					d.x = vfxRand() * w;
				}

				// 竖向水痕
				rainCtx.strokeStyle = `rgba(${rgb}, ${d.alpha})`;
				rainCtx.lineWidth = d.r;
				rainCtx.beginPath();
				rainCtx.moveTo(d.x, d.y - d.len);
				rainCtx.lineTo(d.x, d.y);
				rainCtx.stroke();
				// 珠头高光
				rainCtx.fillStyle = `rgba(${rgb}, ${Math.min(0.5, d.alpha + 0.18)})`;
				rainCtx.beginPath();
				rainCtx.arc(d.x, d.y, d.r * 0.9, 0, Math.PI * 2);
				rainCtx.fill();
			}

			// 水花粒子
			for (let i = rainSplashes.length - 1; i >= 0; i--) {
				const p = rainSplashes[i];
				p.life++;
				p.vy += 0.16;
				p.x += p.vx;
				p.y += p.vy;
				const t = 1 - p.life / p.maxLife;
				if (t <= 0) {
					rainSplashes.splice(i, 1);
					continue;
				}
				rainCtx.fillStyle = `rgba(${rgb}, ${0.4 * t})`;
				rainCtx.beginPath();
				rainCtx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
				rainCtx.fill();
			}

			rainRaf = requestAnimationFrame(frame);
		}
		rainRaf = requestAnimationFrame(frame);
	}

	function destroyHeroRain() {
		if (rainRaf) {
			cancelAnimationFrame(rainRaf);
			rainRaf = 0;
		}
		if (rainEdgeTimer) {
			window.clearInterval(rainEdgeTimer);
			rainEdgeTimer = 0;
		}
		if (rainResizeHandler) {
			window.removeEventListener("resize", rainResizeHandler);
			rainResizeHandler = null;
		}
		if (rainCanvas) {
			rainCanvas.remove();
			rainCanvas = null;
		}
		rainCtx = null;
		rainDrops = [];
		rainSplashes = [];
		rainEdges = [];
	}

	function prefersReducedMotion() {
		return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	}

	function isMobile() {
		return window.matchMedia("(max-width: 768px)").matches;
	}

	function killHomeMotion() {
		if (heroOpeningTimeline) {
			heroOpeningTimeline.kill();
			heroOpeningTimeline = null;
		}
		ScrollTrigger.getAll().forEach((trigger) => {
			const id = String(trigger.vars.id || "");
			if (id.startsWith("home-motion-")) trigger.kill();
		});
	}

	function initHeroOpening() {
		const hero = document.getElementById("home-hero");
		if (!hero) return;
		// 跳过入口动画，直接显示所有元素
		hero.classList.remove("home-hero--motion-pending");
		hero.classList.add("home-hero--motion-ready");
	}

	function initHomeScrollMotion() {
		if (prefersReducedMotion()) {
			document.querySelector(".home-page--motion-pending")?.classList.remove("home-page--motion-pending");
			return;
		}

		const sections = Array.from(document.querySelectorAll<HTMLElement>(
			".home-page > :not(#home-hero), .home-status, .home-pending-layer",
		)).filter((section, index, list) => list.indexOf(section) === index);

		sections.forEach((section, index) => {
			const title = section.querySelector(".home-section-title, [data-motion-title]");
			const cards = section.querySelectorAll(".card-base, .post-card-wrapper, .home-pending, .stats-container, [data-motion-card]");
			const images = section.querySelectorAll("img, [data-motion-image]");
			if (!title && cards.length === 0 && images.length === 0) return;

			const tl = gsap.timeline({
				scrollTrigger: {
					id: `home-motion-section-${index}`,
					trigger: section,
					start: "top 78%",
					once: true,
				},
				defaults: { ease: "power4.out" },
			});

			if (title) {
				tl.fromTo(title, {
					autoAlpha: 0,
					y: 110,
					scale: 0.82,
					clipPath: "inset(0 0 100% 0)",
				}, {
					autoAlpha: 1,
					y: 0,
					scale: 1,
					clipPath: "inset(0 0 0% 0)",
					duration: 1.05,
					ease: "expo.out",
				});
			}

			if (cards.length > 0) {
				tl.fromTo(cards, {
					autoAlpha: 0,
					y: 86,
					rotateX: 12,
					filter: "blur(12px)",
					transformOrigin: "50% 100%",
				}, {
					autoAlpha: 1,
					y: 0,
					rotateX: 0,
					filter: "blur(0px)",
					duration: 1.05,
					stagger: 0.12,
					ease: "expo.out",
				}, title ? "-=0.38" : 0);
			}

			if (images.length > 0) {
				tl.fromTo(images, {
					clipPath: "inset(0 0 100% 0)",
					scale: 1.1,
				}, {
					clipPath: "inset(0 0 0% 0)",
					scale: 1,
					duration: 1.18,
					stagger: 0.1,
					ease: "expo.out",
				}, "-=0.74");

				images.forEach((image, imageIndex) => {
					gsap.to(image, {
						yPercent: -5,
						ease: "none",
						scrollTrigger: {
							id: `home-motion-image-${index}-${imageIndex}`,
							trigger: image,
							start: "top bottom",
							end: "bottom top",
							scrub: 0.9,
						},
					});
				});
			}
		});

		document.querySelector(".home-page--motion-pending")?.classList.remove("home-page--motion-pending");
	}

	let rafId: number | null = null;
	let mouseX = 0;
	let mouseY = 0;
	let charX = 0;
	let charY = 0;
	let mouseMoveHandler: ((e: MouseEvent) => void) | null = null;

	function initParallax() {
		if (isMobile()) return;
		const charLayer = document.getElementById("character-layer");
		if (!charLayer) return;

		mouseMoveHandler = (e: MouseEvent) => {
			mouseX = (e.clientX - window.innerWidth / 2) / (window.innerWidth / 2);
			mouseY = (e.clientY - window.innerHeight / 2) / (window.innerHeight / 2);
		};

		document.addEventListener("mousemove", mouseMoveHandler);

		function update() {
			const targetX = mouseX * 18;
			const targetY = mouseY * 12;

			charX += (targetX - charX) * 0.08;
			charY += (targetY - charY) * 0.08;

			if (charLayer) {
				charLayer.style.transform = `translate(${charX}px, ${charY}px)`;
			}
			rafId = requestAnimationFrame(update);
		}

		rafId = requestAnimationFrame(update);
	}

	function destroyParallax() {
		if (mouseMoveHandler) {
			document.removeEventListener("mousemove", mouseMoveHandler);
			mouseMoveHandler = null;
		}
		if (rafId) {
			cancelAnimationFrame(rafId);
			rafId = null;
		}
	}

	function initWorkStatus() {
		if (workStatusTimer) {
			window.clearInterval(workStatusTimer);
			workStatusTimer = null;
		}

		const hero = document.getElementById("home-hero");
		const avatar = document.getElementById("hero-avatar") as HTMLImageElement | null;
		const badge = document.getElementById("work-status");
		const statusText = badge?.querySelector(".home-hero__status-text");
		if (!hero || !avatar || !badge || !statusText) return;
		const heroEl = hero;
		const avatarEl = avatar;
		const badgeEl = badge;
		const statusTextEl = statusText;
		let selectedWorkAvatar = "";

		function getWorkAvatarUrl() {
			if (selectedWorkAvatar) return selectedWorkAvatar;
			try {
				const pool = JSON.parse(heroEl.dataset.avatarPool || "[]");
				if (Array.isArray(pool) && pool.length > 0) {
					selectedWorkAvatar = pool[Math.floor(Math.random() * pool.length)];
					return selectedWorkAvatar;
				}
			} catch {
				// Keep the configured avatar fallback when the pool data is malformed.
			}
			selectedWorkAvatar = heroEl.dataset.avatar || "";
			return selectedWorkAvatar;
		}

		const workHoursData = heroEl.dataset.workHours;
		let workHours = { start: 9, end: 18, workDays: [1, 2, 3, 4, 5] };
		if (workHoursData) {
			try {
				workHours = JSON.parse(workHoursData);
			} catch {
				// Keep defaults when config data is malformed.
			}
		}

		function updateStatus() {
			const now = new Date();
			const hour = now.getHours() + now.getMinutes() / 60;
			const day = now.getDay();
			const isWorkday = workHours.workDays.includes(day);
			const isWorking = isWorkday && hour >= workHours.start && hour < workHours.end;
			const nextAvatar = isWorking ? getWorkAvatarUrl() : heroEl.dataset.avatarOff;

			if (nextAvatar && avatarEl.getAttribute("src") !== nextAvatar) {
				avatarEl.setAttribute("src", nextAvatar);
			}
			statusTextEl.textContent = isWorking ? "上班中" : "下班";
			badgeEl.classList.toggle("is-off-work", !isWorking);
		}

		updateStatus();
		workStatusTimer = window.setInterval(updateStatus, 60_000);
	}

	function destroyWorkStatus() {
		if (workStatusTimer) {
			window.clearInterval(workStatusTimer);
			workStatusTimer = null;
		}
	}

	async function initHeroHatch() {
		const nameEl = document.querySelector<HTMLElement>(".home-hero__name");
		if (!nameEl) return;
		if (prefersReducedMotion()) return;

		if (!document.contains(nameEl)) return;

		destroyHeroHatch();

		const heroEl = document.getElementById("home-hero") ?? undefined;
		const vfx = VFX.init({
			pixelRatio: Math.min(window.devicePixelRatio, 1.5),
			zIndex: 10,
			wrapper: heroEl,
		});
		if (!vfx) return;
		vfxInstance = vfx;

		heroHatchEffect = new HatchEffect({
			color: "#ffffff",
			angle: 45,
			spacing: 2.5,
			lineWidth: 2,
			angleJitter: 0.5,
			offsetJitter: 2,
			spacingJitter: 0.5,
			seed: 0,
			speed: 8,
			roundCap: true,
			soft: 0,
			originalColor: true,
			bypass: false,
		});

		try {
			await vfx.addHTML(nameEl, { effect: heroHatchEffect });
		} catch (err) {
			console.error("[Hatch] name addHTML failed:", err);
		}
	}

	function destroyHeroHatch() {
		if (vfxInstance) {
			const nameEl = document.querySelector<HTMLElement>(".home-hero__name");
			if (nameEl) {
				try { vfxInstance.remove(nameEl); } catch { /* ignore */ }
			}
		}
		if (heroHatchEffect) {
			heroHatchEffect.dispose();
			heroHatchEffect = null;
		}
		if (vfxInstance) {
			vfxInstance.destroy();
			vfxInstance = null;
		}
	}

	let initToken = 0;

	function init() {
		cleanup();
		initHeroOpening();
		initParallax();
		initWorkStatus();
		// initHeroRain(); // 已关闭雨滴特效
		void initHeroHatch();

		requestAnimationFrame(() => {
			initHomeScrollMotion();
		});
	}

	function cleanup() {
		killHomeMotion();
		destroyParallax();
		destroyWorkStatus();
		// destroyHeroRain(); // 已关闭雨滴特效
		destroyHeroHatch();
	}

	async function scheduleHomeInit() {
		const token = ++initToken;
		cleanup();
		if (!document.getElementById("home-hero")) return;

		await waitForPageLoaderHidden();
		if (token !== initToken || !document.getElementById("home-hero")) return;

		init();
	}

	void scheduleHomeInit();

	document.addEventListener("astro:page-load", () => {
		const hero = document.getElementById("home-hero");
		if (hero) {
			void scheduleHomeInit();
		} else {
			initToken += 1;
			cleanup();
		}
	});
</script>
