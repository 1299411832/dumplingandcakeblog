---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { commentConfig } from "@/config";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";

// 构建时获取文章数
const allPosts = await getCollection("posts", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});
const postCount = allPosts.length;

// 建站天数
const startDate = new Date(siteConfig.siteStartDate || Date.now());
const now = new Date();
const siteDays = Math.max(
	1,
	Math.floor((now.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24)),
);

// Waline serverURL（用于客户端获取评论数）
const walineServerURL =
	commentConfig.type === "waline" ? commentConfig.waline?.serverURL || "" : "";

// 菜单项 — 与 navBarConfig + link-presets 对齐
const menuItems = [
	{
		icon: "material-symbols:article-outline",
		label: "文章列表",
		url: "/posts/",
	},
	{ icon: "material-symbols:folder-open", label: "分类", url: "/categories/" },
	{ icon: "material-symbols:archive", label: "归档", url: "/archive/" },
	{
		icon: "material-symbols:chat-bubble-outline",
		label: "说说",
		url: "/moments/",
	},
	{
		icon: "material-symbols:photo-album-outline",
		label: "相册",
		url: "/album/",
	},
	{ icon: "material-symbols:chat", label: "留言板", url: "/guestbook/" },
	{
		icon: "material-symbols:menu-book-outline",
		label: "笔记",
		url: "/life/notebooks/",
	},
	{ icon: "material-symbols:public", label: "朋友圈", url: "/circle/" },
	{ icon: "material-symbols:book-5", label: "书架", url: "/books/" },
	{ icon: "material-symbols:music-note", label: "音乐", url: "/music/" },
	{ icon: "material-symbols:movie", label: "影视", url: "/movies-games/" },
	{ icon: "material-symbols:location-on", label: "足迹", url: "/life/places/" },
	{ icon: "material-symbols:history", label: "更新日志", url: "/changelog/" },
	{ icon: "material-symbols:apps", label: "应用展示", url: "/apps/" },
	{ icon: "material-symbols:person", label: "关于", url: "/about/" },
	{ icon: "material-symbols:group", label: "友链", url: "/friends/" },
	{ icon: "material-symbols:favorite", label: "赞助", url: "/sponsor/" },
	{ icon: "material-symbols:public", label: "导航", url: "/projects/" },
	{
		icon: "simple-icons:tencentqq",
		label: "QQ群",
		url: "https://qm.qq.com/q/FjkXxV9Hmo",
	},
];
---

<!-- 遮罩 -->
<div class="menu-sheet-overlay" id="menu-sheet-overlay" aria-hidden="true"></div>

<!-- Bottom Sheet -->
<div class="menu-sheet" id="menu-sheet" role="dialog" aria-label="菜单">
  <!-- 拖拽指示条（纯装饰） -->
  <div class="menu-sheet__drag-bar">
    <div class="menu-sheet__drag-handle"></div>
  </div>

  <!-- 顶部标题区 -->
  <div class="menu-sheet__header">
    <div class="menu-sheet__header-left">
      <div class="menu-sheet__title">MENU</div>
      <div class="menu-sheet__subtitle">Explore your world</div>
    </div>
    <!-- 关闭按钮（内联 SVG） -->
    <button class="menu-sheet__close" id="menu-sheet-close" aria-label="关闭" type="button">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M6.4 19L5 17.6L10.6 12L5 6.4L6.4 5L12 10.6L17.6 5L19 6.4L13.4 12L19 17.6L17.6 19L12 13.4L6.4 19Z" fill="currentColor"/>
      </svg>
    </button>
  </div>

  <!-- 功能网格 — 4列 -->
  <div class="menu-sheet__grid">
    {menuItems.map((item, i) => (
      <a
        href={item.url}
        class="menu-sheet__grid-item"
        style={`animation-delay: ${i * 12}ms`}
      >
        <span class="menu-sheet__grid-icon">
          <Icon name={item.icon} />
        </span>
        <span class="menu-sheet__grid-label">{item.label}</span>
      </a>
    ))}
  </div>
</div>

<script is:inline define:vars={{ walineServerURL }}>
(function() {
  // 动态获取 Waline 评论数
  if (walineServerURL) {
    fetch(walineServerURL + "/api/comment?type=count")
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var count = typeof data === "number" ? data : (data && data.data);
        if (count !== undefined) {
          var el = document.getElementById("menu-sheet-comment-count");
          if (el) el.textContent = count;
        }
      })
      .catch(function() {});
  }
})();
</script>
