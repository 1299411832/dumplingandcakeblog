---
export interface Props {
	title: string;
	href: string;
	imgurl: string;
	desc: string;
	tags?: string[];
}

const { title, href, imgurl, desc, tags = [] } = Astro.props;

const tagLabels: Record<string, string> = {
	AI: "AI",
	工具: "工具",
	效率: "效率",
};

const primaryTag = tags[0] || "应用";
const tagLabel = tagLabels[primaryTag] || primaryTag;

const initial = title.trim().slice(0, 1);
---

<a
  class="app-card-link"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  title={desc}
>
  {/* 顶部标签：胶带样式 */}
  <span class="app-card-tab">{tagLabel}</span>

  {/* 头像 */}
  <div class="app-card-avatar" data-initial={initial}>
    <span class="app-card-avatar__face" aria-hidden="true"></span>
    <img
      alt={title}
      class="app-card-avatar__img"
      data-src={imgurl}
    />
  </div>

  {/* 名字 */}
  <h3 class="app-card-name">{title}</h3>

  {/* 介绍框 */}
  <div class="app-card-intro">
    <p class="app-card-intro__text">{desc}</p>
  </div>
</a>
