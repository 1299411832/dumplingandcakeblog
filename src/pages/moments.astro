---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import CommentModal from "@/components/comment/CommentModal.svelte";
import MomentCard from "@/components/moments/MomentCard.astro";
import MomentsCover from "@/components/moments/MomentsCover.astro";
import { commentConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const walineServerURL = commentConfig.waline?.serverURL || "";

const moments = await getCollection("moments");
const sortedMoments = moments
	.filter((m) => !m.data.pinned)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

// 置顶说说
const pinnedMoments = moments
	.filter((m) => m.data.pinned)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

// 获取 moments 资产目录下的所有图片
const momentAssets = import.meta.glob<{ default: ImageMetadata }>(
	"../content/moments/assets/*.{jpeg,jpg,png,gif,webp,avif}",
	{ eager: true },
);

// 解析图片路径
const parseImages = (
	imagesData: (ImageMetadata | string)[] | string | undefined,
): (string | ImageMetadata)[] => {
	let rawPaths: string[] = [];
	if (Array.isArray(imagesData)) {
		rawPaths = imagesData.map((img) =>
			typeof img === "string" ? img : img.src || img,
		);
	} else if (typeof imagesData === "string" && imagesData.trim()) {
		rawPaths = imagesData
			.split(/[,;]/)
			.map((img) => img.trim())
			.filter((img) => img);
	}

	return Array.from(new Set(rawPaths))
		.map((img) => {
			if (
				img.startsWith("http://") ||
				img.startsWith("https://") ||
				img.startsWith("/")
			) {
				return img;
			}
			const cleanPath = img.replace(/^\.\//, "");
			if (cleanPath.startsWith("assets/")) {
				const fileName = cleanPath.replace("assets/", "");
				for (const path in momentAssets) {
					if (path.endsWith(fileName)) {
						return momentAssets[path].default;
					}
				}
			}
			return img;
		})
		.filter((img) => img);
};

// 预处理置顶说说
const pinnedData = pinnedMoments.map((m) => ({
	images: parseImages(m.data.images),
	body: m.body || "",
	date: m.data.published,
}));
---

<MainGridLayout title="动态" description="记录生活中的点点滴滴">
  <!-- 微信朋友圈风格封面 -->
  <MomentsCover />

  <!-- 置顶说说（始终渲染容器，JS 可动态追加外部置顶） -->
  <a href="/moments/pinned/" class="wx-pinned" id="pinned-block" style={pinnedData.length === 0 ? 'display:none' : ''}>
    <div class="wx-pinned-tag">
      <span>置顶</span>
    </div>
    <div class="wx-pinned-items" id="pinned-items">
      {pinnedData.map((item) => (
        <div class="wx-pinned-preview">
          {item.images.length > 0 ? (
            <div class={`wx-pimgs wx-pimgs-${Math.min(item.images.length, 9)}`}>
              {item.images.slice(0, 9).map((img) => (
                typeof img === "string" ? (
                  <img src={img} alt="" class="wx-pinned-img" loading="lazy" />
                ) : (
                  <Image src={img} alt="" class="wx-pinned-img" loading="lazy" />
                )
              ))}
            </div>
          ) : (
            <p class="wx-ptxt">{item.body.slice(0, 60)}{item.body.length > 60 ? '...' : ''}</p>
          )}
        </div>
      ))}
    </div>
  </a>

  <!-- 说说列表（本地 + 外部合并，按时间排序） -->
  <div class="wx-feed" id="moments-feed">
    {sortedMoments.length > 0 ? (
      sortedMoments.map((moment, index) => (
        <div
          class={`wx-feed-item ${index >= 5 ? 'wx-feed-hidden' : ''}`}
          data-published={moment.data.published.toISOString()}
          data-index={index}
        >
          <MomentCard moment={moment} />
        </div>
      ))
    ) : (
      <div class="wx-empty" id="moments-empty">
        <div class="wx-empty-icon">
          <Icon name="material-symbols:sentiment-neutral-outline" />
        </div>
        <h3>还没有发布任何说说</h3>
        <p>快去记录你的生活点滴吧</p>
      </div>
    )}
  </div>

  <!-- 加载更多指示器 -->
  <div id="load-more-sentinel" class="load-more-sentinel">
    <div class="load-more-spinner">
      <div class="spinner"></div>
      <span>加载中...</span>
    </div>
  </div>

  <!-- 评论弹窗 -->
  <CommentModal client:load serverURL={walineServerURL} />
</MainGridLayout>

<script is:inline define:vars={{ walineServerURL }}>
  var countElements = document.querySelectorAll('.waline-count[data-path="/moments/"]');
  if (countElements.length > 0) {
    fetch(walineServerURL + "/api/uv?path=/moments/")
      .then(function(res) { return res.json(); })
      .then(function(data) {
        var count = data.data ? data.data.unique_visitor || data.uv || 0 : (data.uv || 0);
        countElements.forEach(function(el) { el.textContent = String(count); });
      })
      .catch(function() {
        countElements.forEach(function(el) { el.textContent = "-"; });
      });
  }
</script>

<!-- 无限滚动加载 -->
<script is:inline>
(function() {
  var BATCH_SIZE = 5;
  var currentCount = BATCH_SIZE;
  var isLoading = false;
  var allLoaded = false;
  var observer = null;

  function getItems() {
    var feed = document.getElementById('moments-feed');
    return feed ? Array.from(feed.querySelectorAll('.wx-feed-item')) : [];
  }

  function updateVisibility() {
    var items = getItems();
    var total = items.length;
    for (var i = 0; i < total; i++) {
      if (i < currentCount) {
        items[i].classList.remove('wx-feed-hidden');
      } else {
        items[i].classList.add('wx-feed-hidden');
      }
    }
    return total;
  }

  function checkAllLoaded() {
    var sentinel = document.getElementById('load-more-sentinel');
    if (!sentinel) return;
    var total = getItems().length;
    if (currentCount >= total) {
      allLoaded = true;
      sentinel.classList.add('hidden');
    } else {
      allLoaded = false;
      sentinel.classList.remove('hidden');
    }
  }

  function loadMore() {
    if (isLoading || allLoaded) return;
    isLoading = true;

    var items = getItems();
    var total = items.length;

    setTimeout(function() {
      var nextBatch = Math.min(currentCount + BATCH_SIZE, total);
      for (var i = currentCount; i < nextBatch; i++) {
        if (items[i]) {
          items[i].classList.remove('wx-feed-hidden');
        }
      }
      currentCount = nextBatch;
      isLoading = false;
      checkAllLoaded();

      if (!allLoaded && isSentinelInViewport()) {
        loadMore();
      }
    }, 300);
  }

  function isSentinelInViewport() {
    var sentinel = document.getElementById('load-more-sentinel');
    if (!sentinel) return false;
    var rect = sentinel.getBoundingClientRect();
    return rect.top < window.innerHeight + 200;
  }

  function setupObserver() {
    var sentinel = document.getElementById('load-more-sentinel');
    if (!sentinel) return;

    if (observer) {
      observer.disconnect();
      observer = null;
    }

    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            loadMore();
          }
        });
      }, { root: null, rootMargin: '200px', threshold: 0.1 });
      observer.observe(sentinel);
    }
  }

  function init() {
    var feed = document.getElementById('moments-feed');
    var sentinel = document.getElementById('load-more-sentinel');
    if (!feed || !sentinel) return false;

    currentCount = BATCH_SIZE;
    isLoading = false;
    allLoaded = false;

    updateVisibility();
    checkAllLoaded();
    setupObserver();
    return true;
  }

  // 首次加载
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { init(); });
  } else {
    init();
  }
})();
</script>



<style>
  /* 置顶块样式在底部 <style is:global> 中，
     因为 JS 动态创建的外部置顶元素没有 Astro scoped 属性 */

  /* ============================================
   * 说说列表
   * ============================================ */
  .wx-feed {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1rem 0 2rem;
  }

  .wx-feed-item {
    position: relative;
  }

  .wx-feed-item + .wx-feed-item::before {
    content: '';
    position: absolute;
    top: -0.75rem;
    left: 1rem;
    right: 1rem;
    height: 1px;
    background: var(--border);
    opacity: 0.7;
  }

  /* 空状态 */
  .wx-empty {
    text-align: center;
    padding: 3rem 1rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .wx-empty-icon {
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--btn-regular-bg);
    border-radius: 50%;
    color: var(--content-meta);
    font-size: 2rem;
  }

  .wx-empty h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 0.375rem;
  }

  .wx-empty p {
    font-size: 0.875rem;
    color: var(--content-meta);
    margin: 0;
  }

  /* 访客统计 */
  .wx-visitor {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    margin: 1.5rem auto 0;
    padding: 0.75rem;
    color: var(--content-meta);
    font-size: 0.8125rem;
  }

  .wx-visitor-icon {
    font-size: 1rem;
  }

  /* 隐藏的说说项（分页加载） */
  .wx-feed-hidden {
    display: none;
  }

  /* 加载更多指示器 */
  .load-more-sentinel {
    display: flex;
    justify-content: center;
    padding: 2rem 0;
    min-height: 60px;
  }

  .load-more-sentinel.hidden {
    display: none;
  }

  .load-more-spinner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--content-meta);
    font-size: 0.875rem;
  }

  .spinner {
    width: 24px;
    height: 24px;
    border: 3px solid var(--line-divider);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 响应式 */
  @media (max-width: 480px) {
    .wx-feed {
      gap: 1.25rem;
      padding: 0.75rem 0 1.5rem;
    }

    .wx-feed-item + .wx-feed-item::before {
      top: -0.625rem;
      left: 0.75rem;
      right: 0.75rem;
    }
  }
</style>

