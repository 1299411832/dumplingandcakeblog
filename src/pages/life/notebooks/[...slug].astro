---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import ArchiveHeatmap from "@/components/widget/ArchiveHeatmap.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export async function getStaticPaths() {
	const allEntries = await getCollection("notebooks");
	const paths: {
		params: { slug: string };
		props: {
			entry: CollectionEntry<"notebooks">;
			entries?: CollectionEntry<"notebooks">[];
			sortedEntries?: CollectionEntry<"notebooks">[];
			item?: CollectionEntry<"notebooks">;
			isNotebookIndex?: boolean;
		};
	}[] = [];

	for (const entry of allEntries) {
		const normalizedId = entry.id.replace(/\\/g, "/");
		if (normalizedId === "readme" || normalizedId === "readme.md") continue;
		const isIndexFile =
			/\/(_index|_index\.md|_index\.json)?$/.test(normalizedId) &&
			(normalizedId.endsWith("_index") || normalizedId.includes("/_index."));
		const isNotebookRoot =
			normalizedId.match(/^([^/]+)\/(_index|_index\.md|_index\.json)$/) ||
			normalizedId.match(/^([^/]+)\/_index$/);
		if (!isIndexFile || !isNotebookRoot) continue;

		const folderName = isNotebookRoot[1];
		const folderEntries = allEntries.filter((item) => {
			const itemId = item.id.replace(/\\/g, "/");
			return (
				itemId.startsWith(`${folderName}/`) &&
				!/^([^/]+)\/(_index|_index\.md|_index\.json)$/.test(itemId) &&
				itemId !== `${folderName}/_index` &&
				itemId !== `${folderName}/_index.md` &&
				itemId !== `${folderName}/_index.json`
			);
		});
		const sortedEntries = [...folderEntries].sort((a, b) => {
			const aT = a.data.date instanceof Date ? a.data.date.getTime() : 0;
			const bT = b.data.date instanceof Date ? b.data.date.getTime() : 0;
			return bT - aT;
		});

		paths.push({
			params: { slug: folderName },
			props: {
				entry,
				entries: folderEntries,
				sortedEntries,
				isNotebookIndex: true,
			},
		});
		for (const item of folderEntries) {
			const itemId = item.id.replace(/\\/g, "/");
			const itemSlug = itemId.split("/").pop()?.replace(/\.md$/, "") || "";
			paths.push({
				params: { slug: `${folderName}/${itemSlug}` },
				props: { entry, item, isNotebookIndex: false },
			});
		}
	}
	return paths;
}

const { entry, sortedEntries, item, isNotebookIndex } = Astro.props as {
	entry: CollectionEntry<"notebooks">;
	sortedEntries?: CollectionEntry<"notebooks">[];
	item?: CollectionEntry<"notebooks">;
	isNotebookIndex: boolean;
};
const notebookContent = !isNotebookIndex && item ? await render(item) : null;
const normalizedEntryId = entry.id.replace(/\\/g, "/");
const isNotebookRootMatch =
	normalizedEntryId.match(/^([^/]+)\/(_index|_index\.md|_index\.json)$/) ||
	normalizedEntryId.match(/^([^/]+)\/_index$/);
const folderName = isNotebookRootMatch
	? isNotebookRootMatch[1]
	: normalizedEntryId.split("/")[0];

const notebookCommentPath =
	!isNotebookIndex && item
		? `/life/notebooks/${item.id.replace(/\\/g, "/").replace(/\.md$/, "")}/`
		: "";

// 获取所有笔记本列表
const allNotebooks = await getCollection("notebooks");
const notebookList = allNotebooks
	.filter((e) => {
		const id = e.id.replace(/\\/g, "/");
		return (
			/\/(_index|_index\.md|_index\.json)$/.test(id) || /\/_index$/.test(id)
		);
	})
	.map((e) => {
		const m = e.id.replace(/\\/g, "/").match(/^([^/]+)\//);
		return { name: e.data.name || m?.[1] || "", folder: m?.[1] || "" };
	})
	.filter((n) => n.name);

const heatmapPosts = isNotebookIndex
	? (sortedEntries || []).map((e) => ({
			id: e.id,
			data: {
				title: e.data.name || e.id,
				published: e.data.date instanceof Date ? e.data.date : new Date(0),
			},
		}))
	: [];

interface ArchiveEntry {
	slug: string;
	day: string;
	name: string;
}
interface ArchiveMonth {
	month: number;
	entries: ArchiveEntry[];
}
interface ArchiveYear {
	year: number;
	totalCount: number;
	months: ArchiveMonth[];
}
const archiveYears: ArchiveYear[] = [];
if (isNotebookIndex && sortedEntries && sortedEntries.length > 0) {
	const yearMap = new Map<number, Map<number, ArchiveEntry[]>>();
	for (const e of sortedEntries) {
		const d = e.data.date instanceof Date ? e.data.date : new Date(0);
		const y = d.getFullYear();
		const m = d.getMonth() + 1;
		const noteItemId = e.id.replace(/\\/g, "/");
		const itemSlug =
			noteItemId.split("/").pop()?.replace(/\.md$/, "") || "未命名";
		const monthMap = yearMap.get(y) ?? new Map<number, ArchiveEntry[]>();
		yearMap.set(y, monthMap);
		if (!monthMap.has(m)) monthMap.set(m, []);
		monthMap.get(m)?.push({
			slug: itemSlug,
			day: String(d.getDate()).padStart(2, "0"),
			name: e.data.name || itemSlug,
		});
	}
	for (const [year, monthMap] of Array.from(yearMap.entries()).sort(
		(a, b) => b[0] - a[0],
	)) {
		const months: ArchiveMonth[] = [];
		let total = 0;
		for (const [month, entries] of Array.from(monthMap.entries()).sort(
			(a, b) => b[0] - a[0],
		)) {
			months.push({ month, entries });
			total += entries.length;
		}
		archiveYears.push({ year, totalCount: total, months });
	}
}
---

{isNotebookIndex ? (
	<MainGridLayout title={entry.data.name || "笔记本"} description={entry.data.summary || "笔记本记录"}>
		<div class="flex w-full overflow-hidden relative min-h-32">
			<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">

				<nav class="cb" id="nb-breadcrumb" aria-label="Breadcrumb">
					<ol class="cb__list">
						<li class="cb__item">
							<a href="/life/notebooks/" class="cb__link">
								<span class="cb__icon"><Icon name="material-symbols:menu-book-outline" /></span>
								<span>笔记本</span>
							</a>
						</li>
						<li class="cb__item">
							<span class="cb__sep" aria-hidden="true">›</span>
							<span class="cb__dropdown" data-nb-dropdown data-current={folderName}>
								<button type="button" class="cb__dropdown-trigger" aria-haspopup="menu" aria-expanded="false" data-nb-dropdown-trigger>
									<span class="cb__dropdown-label" data-nb-dropdown-label>{entry.data.name || "笔记本"}</span>
									<span class="cb__dropdown-arrow" aria-hidden="true">
										<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M12 14.975q-.2 0-.375-.062T11.3 14.7l-4.6-4.6q-.275-.275-.275-.7t.275-.7q.275-.275.7-.275t.7.275L12 12.55l4.125-4.125q.275-.275.7-.275t.7.275q.275.275.275.7t-.275.7l-4.6 4.6q-.15.15-.325.213T12 14.975Z"/></svg>
									</span>
								</button>
								<span class="cb__dropdown-menu" role="menu" data-nb-dropdown-menu>
									{notebookList.map((nb) => (
										<a href={`/life/notebooks/${nb.folder}/`} class:list={["cb__dropdown-item", { "is-active": nb.folder === folderName }]} role="menuitem" data-nb-dropdown-item>
											<span>{nb.name}</span>
										</a>
									))}
								</span>
							</span>
						</li>
					</ol>
				</nav>

				<div class="mb-8">
					<div class="flex items-center gap-3 mb-3">
						<Icon name="material-symbols:menu-book-outline" class="text-[1.875rem]" />
						<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">{entry.data.name || "笔记本"}</div>
					</div>
					{entry.data.summary && <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">{entry.data.summary}</p>}
				</div>

				<ArchiveHeatmap posts={heatmapPosts} />

				<div class="archive-panel">
					{archiveYears.length > 0 ? (
						archiveYears.map((yr) => (
							<div class="ap-year-block">
								<div class="ap-year-header">
									<div class="ap-col"><div class="ap-node ap-year-node"></div></div>
									<div class="ap-year-label"><h2 class="ap-h1">{yr.year}年</h2><span class="ap-count">共 {yr.totalCount} 篇</span></div>
								</div>
								<div class="ap-months-area">
									{yr.months.map((mg) => (
										<div class="ap-month-block">
											<div class="ap-month-header">
												<div class="ap-col"><div class="ap-hline ap-month-hline"></div><div class="ap-node ap-month-node"></div></div>
												<div class="ap-month-label"><h3 class="ap-h2">{mg.month}月</h3><span class="ap-count">{mg.entries.length} 篇</span></div>
											</div>
											<div class="ap-posts-area">
												<ul class="ap-post-list">
													{mg.entries.map((entry, idx) => (
														<li class:list={["ap-post-row", { last: idx === mg.entries.length - 1 }]}>
															<div class="ap-col"><div class="ap-hline ap-post-hline"></div><div class="ap-node ap-post-node"></div></div>
															<a href={`/life/notebooks/${folderName}/${entry.slug}/`} class="ap-post-link group btn-plain">
																<span class="ap-date">{entry.day}</span><span class="ap-type-badge">笔记</span><span class="ap-title group-hover:text-(--primary)">{entry.name}</span>
															</a>
														</li>
													))}
												</ul>
											</div>
										</div>
									))}
								</div>
							</div>
						))
					) : (
						<div class="nb-empty"><span class="nb-empty-icon">📝</span><p>还没有日记内容</p></div>
					)}
				</div>
			</div>
		</div>

		<script is:inline>
		(function() {
			if (window.__nbDropdownInited) return;
			window.__nbDropdownInited = true;
			function closeDropdown(dd) { var trigger = dd.querySelector("[data-nb-dropdown-trigger]"); if (trigger) trigger.setAttribute("aria-expanded", "false"); dd.classList.remove("is-open"); }
			function openDropdown(dd) { var trigger = dd.querySelector("[data-nb-dropdown-trigger]"); var menu = dd.querySelector("[data-nb-dropdown-menu]"); if (trigger) trigger.setAttribute("aria-expanded", "true"); if (menu && trigger) { var rect = trigger.getBoundingClientRect(); menu.style.top = (rect.bottom + 6) + "px"; menu.style.left = rect.left + "px"; } dd.classList.add("is-open"); }
			document.addEventListener("click", function(e) {
				var t = e.target; if (!t) return;
				var trigger = t.closest && t.closest("[data-nb-dropdown-trigger]");
				var item = t.closest && t.closest("[data-nb-dropdown-item]");
				if (trigger) { e.preventDefault(); var dd = trigger.closest("[data-nb-dropdown]"); if (!dd) return; var isOpen = dd.classList.contains("is-open"); document.querySelectorAll("[data-nb-dropdown]").forEach(closeDropdown); if (!isOpen) openDropdown(dd); return; }
				if (item) { e.preventDefault(); var href = item.getAttribute("href") || ""; document.querySelectorAll("[data-nb-dropdown]").forEach(closeDropdown); if (href) window.location.href = href; return; }
				document.querySelectorAll("[data-nb-dropdown]").forEach(closeDropdown);
			});
		})();
		</script>
	</MainGridLayout>
) : (
	<MainGridLayout title={(item?.data?.name || "日记") + " - 笔记本"}>
		{/* 面包屑：笔记本 › 下拉(切换) › 笔记本名(可点击) › 文章名 */}
		<nav class="cb" aria-label="Breadcrumb">
			<ol class="cb__list">
				<li class="cb__item">
					<a href="/life/notebooks/" class="cb__link">
						<span class="cb__icon"><Icon name="material-symbols:menu-book-outline" /></span>
						<span>笔记本</span>
					</a>
				</li>
				<li class="cb__item">
					<span class="cb__sep" aria-hidden="true">›</span>
					<span class="cb__dropdown" data-nb-dropdown data-current={folderName}>
						<button type="button" class="cb__dropdown-trigger" aria-haspopup="menu" aria-expanded="false" data-nb-dropdown-trigger>
							<span class="cb__dropdown-label" data-nb-dropdown-label>全部笔记本</span>
							<span class="cb__dropdown-arrow" aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M12 14.975q-.2 0-.375-.062T11.3 14.7l-4.6-4.6q-.275-.275-.275-.7t.275-.7q.275-.275.7-.275t.7.275L12 12.55l4.125-4.125q.275-.275.7-.275t.7.275q.275.275.275.7t-.275.7l-4.6 4.6q-.15.15-.325.213T12 14.975Z"/></svg>
							</span>
						</button>
						<span class="cb__dropdown-menu" role="menu" data-nb-dropdown-menu>
							{notebookList.map((nb) => (
								<a href={`/life/notebooks/${nb.folder}/`} class:list={["cb__dropdown-item", { "is-active": nb.folder === folderName }]} role="menuitem" data-nb-dropdown-item>
									<span>{nb.name}</span>
								</a>
							))}
						</span>
					</span>
					<span class="cb__sep" aria-hidden="true">›</span>
					<a href={`/life/notebooks/${folderName}/`} class="cb__link"><span>{entry.data.name || "笔记本"}</span></a>
				</li>
				<li class="cb__item">
					<span class="cb__sep" aria-hidden="true">›</span>
					<span class="cb__current">
						<span class="cb__icon"><Icon name="material-symbols:description-outline" /></span>
						<span>{item?.data?.name || item?.id?.replace(/\\/g, "/").split("/").pop()?.replace(/\.md$/, "") || "此笔记"}</span>
					</span>
				</li>
			</ol>
		</nav>

		<!-- 文章标题区 — 与博客文章页一致的 post-hero 样式 -->
		<div class="post-hero rounded-(--radius-large) mb-2 onload-animation">
			<div class="post-hero__content">
				<h1 class="post-hero__title">
					{item?.data?.name || item?.id?.replace(/\\/g, "/").split("/").pop()?.replace(/\.md$/, "") || "无标题"}
				</h1>
				<div class="post-hero__meta-row">
					{item?.data?.date instanceof Date ? (
						<span class="post-hero__meta-item">
							{item.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
						</span>
					) : (
						<span class="post-hero__meta-item">未填写日期</span>
					)}
					{item?.data?.tags && item.data.tags.length > 0 && (
						<>
							<span class="post-hero__meta-dot">·</span>
							{item.data.tags.map((tag: string) => (<span class="post-hero__meta-tag">#{tag}&nbsp;</span>))}
						</>
					)}
				</div>
			</div>
		</div>

		<!-- 正文卡片 -->
		<div class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4">
			<div class="card-base z-10 px-3 md:px-6 lg:px-10 pb-4 pt-0 relative w-full">
				{notebookContent ? (
					<Markdown class="mb-6 markdown-content onload-animation">
						<notebookContent.Content />
					</Markdown>
				) : (
					<p class="text-(--content-meta) text-center py-8">（无内容）</p>
				)}
			</div>
		</div>

		<Comment customPath={notebookCommentPath} />

		{/* 笔记本下拉菜单 */}
		<script is:inline>
		(function() {
			if (window.__nbDropdownInited) return;
			window.__nbDropdownInited = true;
			function closeDropdown(dd) { var trigger = dd.querySelector("[data-nb-dropdown-trigger]"); if (trigger) trigger.setAttribute("aria-expanded", "false"); dd.classList.remove("is-open"); }
			function openDropdown(dd) { var trigger = dd.querySelector("[data-nb-dropdown-trigger]"); var menu = dd.querySelector("[data-nb-dropdown-menu]"); if (trigger) trigger.setAttribute("aria-expanded", "true"); if (menu && trigger) { var rect = trigger.getBoundingClientRect(); menu.style.top = (rect.bottom + 6) + "px"; menu.style.left = rect.left + "px"; } dd.classList.add("is-open"); }
			document.addEventListener("click", function(e) {
				var t = e.target; if (!t) return;
				var trigger = t.closest && t.closest("[data-nb-dropdown-trigger]");
				var item = t.closest && t.closest("[data-nb-dropdown-item]");
				if (trigger) { e.preventDefault(); var dd = trigger.closest("[data-nb-dropdown]"); if (!dd) return; var isOpen = dd.classList.contains("is-open"); document.querySelectorAll("[data-nb-dropdown]").forEach(closeDropdown); if (!isOpen) openDropdown(dd); return; }
				if (item) { e.preventDefault(); var href = item.getAttribute("href") || ""; document.querySelectorAll("[data-nb-dropdown]").forEach(closeDropdown); if (href) window.location.href = href; return; }
				document.querySelectorAll("[data-nb-dropdown]").forEach(closeDropdown);
			});
		})();
		</script>
	</MainGridLayout>
)}

<style>
	.archive-panel { --tw: 2rem; --lc: var(--line-color, oklch(0.82 0 0)); --lh: oklch(0.15 0 0); --nc: var(--line-color, oklch(0.82 0 0)); --nh: oklch(0.15 0 0); --lw: 2.5px; position: relative; }
	:root.dark .archive-panel { --lc: oklch(0.35 0 0); --lh: oklch(0.85 0 0); --nc: oklch(0.35 0 0); --nh: oklch(0.85 0 0); }
	.ap-year-block { position: relative; margin-bottom: 2.5rem; }
	.ap-year-block::before { content: ""; position: absolute; left: calc(var(--tw) / 2); top: calc(var(--tw) / 2); bottom: 1rem; width: 0; border-left: var(--lw) dashed var(--lc); z-index: 0; }
	.ap-months-area { padding-left: var(--tw); }
	.ap-month-block { position: relative; margin-bottom: 0.5rem; }
	.ap-month-block::before { content: ""; position: absolute; left: calc(var(--tw) / 2); top: calc(var(--tw) / 2); bottom: 1rem; width: 0; border-left: var(--lw) dashed var(--lc); z-index: 0; }
	.ap-posts-area { padding-left: var(--tw); }
	.ap-post-list { list-style: none; margin: 0; padding: 0; }
	.ap-post-row { position: relative; display: flex; align-items: center; min-height: 2.25rem; transition: transform 0.2s cubic-bezier(0.4,0,0.2,1); }
	.ap-post-row:hover { transform: translateX(0.375rem); }
	.ap-col { position: relative; width: var(--tw); flex-shrink: 0; align-self: stretch; }
	.ap-node { position: absolute; left: 50%; transform: translateX(-50%); border-radius: 50%; z-index: 2; transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease; }
	.ap-year-node { top: calc(50% - 0.375rem); width: 0.75rem; height: 0.75rem; border: 2px solid var(--nc); background: var(--page-bg, white); }
	.ap-month-node { top: calc(50% - 0.25rem); width: 0.5rem; height: 0.5rem; background: var(--nc); }
	.ap-post-node { top: calc(50% - 0.2rem); width: 0.4rem; height: 0.4rem; background: var(--nc); }
	.ap-post-node.hovered { background: var(--nh); transform: translateX(-50%) scale(1.6); }
	.ap-hline { position: absolute; height: 0; border-top: var(--lw) dashed var(--lc); z-index: 1; }
	.ap-month-hline { top: 50%; left: calc(-1 * var(--tw) / 2); width: var(--tw); }
	.ap-post-hline { top: 50%; left: calc(-1 * var(--tw) / 2); width: var(--tw); }
	.ap-year-header, .ap-month-header { display: flex; align-items: center; min-height: var(--tw); }
	.ap-year-label, .ap-month-label { display: flex; align-items: baseline; gap: 0.6rem; padding-left: 0.5rem; flex: 1; }
	.ap-h1 { font-size: 1.25rem; font-weight: 800; color: var(--deep-text); margin: 0; }
	.ap-h2 { font-size: 0.9375rem; font-weight: 700; color: var(--deep-text); margin: 0; }
	.ap-count { font-size: 0.75rem; color: var(--content-meta); }
	.ap-date { flex-shrink: 0; width: 2.5rem; font-size: 0.8125rem; color: var(--content-meta); font-variant-numeric: tabular-nums; }
	.ap-type-badge { flex-shrink: 0; font-size: 0.625rem; padding: 0.0625rem 0.375rem; border-radius: 0.25rem; background: oklch(0.92 0 0); color: oklch(0.35 0 0); font-weight: 600; }
	:root.dark .ap-type-badge { background: oklch(0.25 0 0); color: oklch(0.65 0 0); }
	.ap-title { flex: 1; min-width: 0; font-size: 0.875rem; color: var(--deep-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.ap-post-link { display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.5rem; border-radius: 0.375rem; text-decoration: none; color: inherit; transition: background 0.15s ease; }
	.ap-post-link:hover { background: var(--btn-plain-bg-hover); }

	.nb-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 3rem; background: var(--card-bg); border: 1.5px dashed var(--line-divider); border-radius: 1rem; text-align: center; }
	.nb-empty-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
	.nb-empty p { font-size: 0.875rem; color: var(--content-meta); margin: 0; }
</style>