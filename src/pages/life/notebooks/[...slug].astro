---
import { getCollection, render } from "astro:content";
import * as path from "node:path";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import { marked } from "marked";
import { externalNotebooksConfig } from "@/config/externalNotebooksConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const notebookImageFiles = import.meta.glob<ImageMetadata>(
	"../../content/life/notebooks/**/*.{jpg,jpeg,png,webp,avif,gif,svg}",
	{ import: "default" },
);

export async function getStaticPaths() {
	const allEntries = await getCollection("notebooks");
	const paths: { params: { slug: string }; props: { entry: any; entries?: any[]; sortedEntries?: any[]; item?: any; isNotebookIndex?: boolean } }[] = [];

	for (const entry of allEntries) {
		const normalizedId = entry.id.replace(/\\/g, "/");
		if (normalizedId === "readme" || normalizedId === "readme.md") continue;
		const isIndexFile =
			/\/(_index|_index\.md|_index\.json)?$/.test(normalizedId) &&
			(normalizedId.endsWith("_index") || normalizedId.includes("/_index."));
		const isNotebookRoot =
			normalizedId.match(/^([^/]+)\/(_index|_index\.md|_index\.json)$/) ||
			normalizedId.match(/^([^/]+)\/_index$/);
		if (!isIndexFile || !isNotebookRoot) continue;

		const folderName = isNotebookRoot[1];
		const folderEntries = allEntries.filter((item) => {
			const itemId = item.id.replace(/\\/g, "/");
			return (
				itemId.startsWith(`${folderName}/`) &&
				!/^([^/]+)\/(_index|_index\.md|_index\.json)$/.test(itemId) &&
				itemId !== `${folderName}/_index` &&
				itemId !== `${folderName}/_index.md` &&
				itemId !== `${folderName}/_index.json`
			);
		});
		const sortedEntries = [...folderEntries].sort((a, b) => {
			const aT = a.data.date instanceof Date ? a.data.date.getTime() : 0;
			const bT = b.data.date instanceof Date ? b.data.date.getTime() : 0;
			return bT - aT;
		});

		paths.push({
			params: { slug: folderName },
			props: {
				entry,
				entries: folderEntries,
				sortedEntries,
				isNotebookIndex: true,
			},
		});
		for (const item of folderEntries) {
			const itemId = item.id.replace(/\\/g, "/");
			const itemSlug = itemId.split("/").pop()?.replace(/\.md$/, "") || "";
			paths.push({
				params: { slug: `${folderName}/${itemSlug}` },
				props: { entry, item, isNotebookIndex: false },
			});
		}
	}
	return paths;
}

const { entry, sortedEntries, item, isNotebookIndex } = Astro.props as {
	entry: any; sortedEntries?: any[]; item?: any; isNotebookIndex: boolean;
};
const notebookContent = !isNotebookIndex && item ? await render(item) : null;
const normalizedEntryId = entry.id.replace(/\\/g, "/");
const isNotebookRootMatch =
	normalizedEntryId.match(/^([^/]+)\/(_index|_index\.md|_index\.json)$/) ||
	normalizedEntryId.match(/^([^/]+)\/_index$/);
const folderName = isNotebookRootMatch
	? isNotebookRootMatch[1]
	: normalizedEntryId.split("/")[0];

const notebookCommentPath = !isNotebookIndex && item
	? `/life/notebooks/${item.id.replace(/\\/g, "/").replace(/\.md$/, "")}/`
	: "";

const sortedEntriesWithImages = isNotebookIndex
	? await Promise.all(
			(sortedEntries || []).map(async (noteItem) => {
				const rawImage = noteItem.data.image as string | string[] | undefined;
				const imageList: string[] = [];
				if (rawImage && rawImage !== "") {
					const rawImages = Array.isArray(rawImage) ? rawImage : [rawImage];
					const noteItemId = noteItem.id.replace(/\\/g, "/");
					const noteDir = noteItemId.replace(/\/[^/]+$/, "");
					for (const ri of rawImages) {
						if (ri.startsWith("http://") || ri.startsWith("https://")) {
							imageList.push(ri);
						} else {
							const imageKey = path
								.normalize(
									path.join("../../content/life/notebooks", noteDir, ri),
								)
								.replace(/\\/g, "/");
							const loader = notebookImageFiles[imageKey];
							if (loader) {
								try {
									const img = await loader();
									imageList.push(img.src);
								} catch {
									/* skip */
								}
							}
						}
					}
				}
				return { ...noteItem, images: imageList };
			}),
		)
	: [];
---

{isNotebookIndex ? (
	<MainGridLayout title={entry.data.name || "笔记本"} description={entry.data.summary || "笔记本记录"}>
		<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
			<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
			<div class="nb-page">
			{/* 时间线笔记列表 */}
			<div class="nb-timeline">
				{externalNotebooksConfig.enable && (
					<div id="remote-entries-container" style="display:none;">
						<div id="remote-entries-list"></div>
					</div>
				)}

				{sortedEntriesWithImages.length === 0 ? (
					<div class="nb-empty" id="local-empty">
						<span class="nb-empty-icon">📝</span>
						<p>还没有日记内容</p>
					</div>
				) : (
					<>
						{(() => {
							let lastMonth = "";
							return sortedEntriesWithImages.map((noteItem) => {
								const noteItemId = noteItem.id.replace(/\\/g, "/");
								const fileName = noteItemId.split("/").pop()?.replace(/\.md$/, "") || "未命名";
								const itemSlug = fileName;
								const dateStr = noteItem.data.date instanceof Date ? noteItem.data.date.toISOString().split("T")[0] : "";
								const month = dateStr ? dateStr.slice(0, 7) : "";
								const showMonth = month !== lastMonth;
								lastMonth = month;

								const contentBody = noteItem.body ? noteItem.body.split("\n").filter((line: string) => !line.trim().startsWith("---")).join("\n").trim() : "";
								const htmlPreview = contentBody ? String(marked.parse(contentBody.slice(0, 200))) : "";
								const previewHtml = htmlPreview
									.replace(/<\/p>\s*<p>/g, ' ')
									.replace(/<\/?p>/g, '')
									.replace(/<h[1-6][^>]*>/g, '').replace(/<\/h[1-6]>/g, ' ')
									.replace(/<pre[\s\S]*?<\/pre>/g, '')
									.replace(/<img[^>]*>/g, '')
									.trim();
								const preview = previewHtml.slice(0, 120) + (previewHtml.length > 120 ? "..." : "");
								const noteImages = noteItem.images as string[];
								const day = dateStr ? dateStr.slice(8) : "";
								const monthName = noteItem.data.date instanceof Date ? noteItem.data.date.toLocaleDateString("zh-CN", { month: "short" }) : "";

								return (
									<>
										{showMonth && month && (
											<div class="nb-month-divider">
												<span class="nb-month-label">{monthName}</span>
											</div>
										)}
										<a href={`/life/notebooks/${folderName}/${itemSlug}/`} class="nb-entry group">
											<div class="nb-entry-dot"></div>
											<div class="nb-entry-date">
												<span class="nb-entry-day">{day}</span>
											</div>
											<div class="nb-entry-content">
												{preview && <p class="nb-entry-preview" set:html={preview} />}
												{noteImages.length > 0 && (
													<div class="nb-entry-images">
														{noteImages.slice(0, 3).map((imgSrc) => (
															<img src={imgSrc} alt="" class="nb-entry-thumb" loading="lazy" />
														))}
														{noteImages.length > 3 && (
															<span class="nb-entry-more">+{noteImages.length - 3}</span>
														)}
													</div>
												)}
											</div>
										</a>
									</>
								);
							});
						})()}
					</>
				)}
			</div>

			{/* 远程笔记脚本 */}
			{externalNotebooksConfig.enable && (
				<script is:inline
					data-gists={JSON.stringify(externalNotebooksConfig.notebookGists || {})}
					data-notebook={folderName}>
					(function() {
						var _s = document.currentScript;
						var GISTS = JSON.parse(_s.getAttribute("data-gists") || "{}");
						var NOTEBOOK = _s.getAttribute("data-notebook");
						var GIST_ID = GISTS[NOTEBOOK];
						if (!GIST_ID || !NOTEBOOK) return;

						var rawUrl = "https://gist.githubusercontent.com/raw/" + GIST_ID + "?t=" + Date.now();

						fetch(rawUrl)
							.then(function(r) { if (!r.ok) return null; return r.text(); })
							.then(function(text) {
								if (!text) return;
								var entries = [];
								try { entries = JSON.parse(text); } catch(e) { return; }
								if (!Array.isArray(entries)) return;

								var filtered = entries.filter(function(e) { return e.notebook === NOTEBOOK; });
								if (!filtered.length) return;

								filtered.sort(function(a, b) {
									return new Date(b.date || b.createdAt) - new Date(a.date || a.createdAt);
								});

								var container = document.getElementById("remote-entries-container");
								var list = document.getElementById("remote-entries-list");
								if (!container || !list) return;

								function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }

								filtered.forEach(function(entry) {
									var date = entry.date || "";
									var contentBody = (entry.content || "").replace(/^---[\s\S]*?---\n?/g, "").trim();
									var preview = contentBody.slice(0, 120) + (contentBody.length > 120 ? "..." : "");

									var card = document.createElement("a");
									card.href = "/life/notebooks/remote-entry/?nb=" + encodeURIComponent(NOTEBOOK) + "&id=" + encodeURIComponent(entry.id);
									card.className = "nb-entry group";
									card.innerHTML =
										'<div class="nb-entry-dot"></div>' +
										'<div class="nb-entry-date"><span class="nb-entry-day">' + esc(date.slice(8)) + '</span></div>' +
										'<div class="nb-entry-content"><p class="nb-entry-preview">' + esc(preview) + '</p></div>';
									list.appendChild(card);
								});

								container.style.display = "";
								var localEmpty = document.getElementById("local-empty");
								if (localEmpty) localEmpty.style.display = "none";
							})
							.catch(function() {});
					})();
				</script>
			)}
		</div>
		</div>
		</div>
	</MainGridLayout>
) : (
	<MainGridLayout title={(item?.data?.name || "日记") + " - 笔记本"}>
		<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
			<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
			<div class="diary-detail-page">
			<article class="diary-paper">
				<a href={`/life/notebooks/${folderName}/`} class="diary-paper-back">
					<Icon name="material-symbols:arrow-back-rounded" />
					<span>返回 {entry.data.name || "日记本"}</span>
				</a>

				<h1 class="diary-paper-title">
					{item?.data?.name || item?.id?.replace(/\\/g, "/").split("/").pop()?.replace(/\.md$/, "") || "无标题"}
				</h1>

				<div class="diary-paper-content">
					{notebookContent ? (
						<Markdown class="diary-paper-content"><notebookContent.Content /></Markdown>
					) : (
						<p>（无内容）</p>
					)}
				</div>

				<div class="diary-paper-footer">
					{item?.data?.tags && item.data.tags.length > 0 && (
						<div class="diary-tags">
							{item.data.tags.map((tag: string) => (<span class="diary-tag">#{tag}</span>))}
						</div>
					)}
					<span class="diary-date-final">
						{item?.data?.date instanceof Date ? item.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric", weekday: "long" }) : "未填写日期"}
					</span>
				</div>
			</article>

			<Comment customPath={notebookCommentPath} />
		</div>
		</div>
		</div>
	</MainGridLayout>
)}

<style>
	/* ===== 页面整体 ===== */
	.nb-page {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	/* ===== 面包屑 ===== */
	.nb-breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.8125rem;
		color: var(--content-meta);
		padding: 0.125rem 0;
	}

	.nb-breadcrumb-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--content-meta);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.nb-breadcrumb-link:hover {
		color: var(--primary);
	}

	.nb-breadcrumb-sep {
		opacity: 0.4;
	}

	.nb-breadcrumb-current {
		font-weight: 600;
		color: var(--deep-text);
	}

	/* ===== 时间线 ===== */
	.nb-timeline {
		position: relative;
		padding-left: 1.5rem;
	}

	.nb-timeline::before {
		content: "";
		position: absolute;
		left: 0.4375rem;
		top: 0;
		bottom: 0;
		width: 1.5px;
		background: var(--line-divider);
	}

	/* 月份分隔 */
	.nb-month-divider {
		position: relative;
		padding: 0.5rem 0;
		margin-left: -1.5rem;
		padding-left: 1.5rem;
	}

	.nb-month-label {
		display: inline-block;
		font-size: 0.6875rem;
		font-weight: 700;
		color: var(--primary);
		background: var(--card-bg);
		padding: 0.125rem 0.5rem;
		border-radius: 9999px;
		border: 1px solid color-mix(in srgb, var(--primary) 25%, transparent);
		position: relative;
		z-index: 1;
	}

	/* 笔记条目 */
	.nb-entry {
		display: flex;
		gap: 0.75rem;
		padding: 0.625rem 0;
		text-decoration: none;
		color: inherit;
		transition: opacity 0.15s ease;
		position: relative;
	}

	.nb-entry:hover {
		opacity: 0.75;
	}

	.nb-entry-dot {
		position: absolute;
		left: -1.5rem;
		top: 50%;
		transform: translate(-50%, -50%);
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--line-divider);
		border: 2px solid var(--card-bg);
		z-index: 1;
		transition: background 0.2s ease;
	}

	.nb-entry:hover .nb-entry-dot {
		background: var(--primary);
	}

	.nb-entry-date {
		flex-shrink: 0;
		width: 2rem;
		text-align: center;
	}

	.nb-entry-day {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--deep-text);
	}

	.nb-entry-content {
		flex: 1;
		min-width: 0;
	}

	.nb-entry-preview {
		font-size: 0.8125rem;
		color: var(--content-meta);
		line-height: 1.6;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.nb-entry-images {
		display: flex;
		gap: 0.375rem;
		margin-top: 0.5rem;
	}

	.nb-entry-thumb {
		width: 3rem;
		height: 3rem;
		border-radius: 0.375rem;
		object-fit: cover;
		border: 1px solid var(--line-divider);
	}

	.nb-entry-more {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border-radius: 0.375rem;
		background: var(--btn-plain-bg-hover);
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--content-meta);
	}

	/* 空状态 */
	.nb-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 3rem;
		background: var(--card-bg);
		border: 1.5px dashed var(--line-divider);
		border-radius: 1rem;
		text-align: center;
	}

	.nb-empty-icon {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}

	.nb-empty p {
		font-size: 0.875rem;
		color: var(--content-meta);
		margin: 0;
	}

	/* ===== 日记详情页 ===== */
	.diary-detail-page { max-width: 48rem; margin: 0 auto; }
	.diary-paper {
		background: var(--page-bg); color: var(--deep-text);
		padding: 2rem 0.75rem;
	}
	@media (min-width: 768px) {
		.diary-paper { padding: 2rem 1.25rem; }
	}

	.diary-paper-back {
		display: inline-flex; align-items: center; gap: 0.4rem;
		font-size: 0.85rem; color: var(--content-meta); text-decoration: none;
		margin-bottom: 2rem; transition: color 0.2s;
	}
	.diary-paper-back:hover { color: var(--primary); }

	.diary-paper-title { font-size: 1.75rem; font-weight: 700; color: var(--deep-text); margin: 0 0 2rem; line-height: 1.4; }

	.diary-paper-content { font-size: 1rem; line-height: 1.9; }
	.diary-paper-content :global(p) { margin: 0 0 1.25rem; }
	.diary-paper-content :global(blockquote) { border-left-color: var(--primary); }

	.diary-paper-content :global(p:has(> img:only-child)) {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
	}
	.diary-paper-content :global(p:has(> img:only-child):has(img:nth-child(2)):not(:has(img:nth-child(3)))) {
		grid-template-columns: repeat(2, 1fr);
	}
	.diary-paper-content :global(p:has(> img:only-child):not(:has(img:nth-child(2)))) {
		grid-template-columns: 280px;
		justify-content: start;
	}
	.diary-paper-content :global(img) {
		border-radius: 0.5rem;
		max-width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		cursor: zoom-in;
	}
	.diary-paper-content :global(p:has(> img:only-child)) img {
		width: 100%;
		height: 100%;
	}

	.diary-paper-footer {
		display: flex; align-items: flex-end; justify-content: space-between;
		margin-top: 3rem; padding-top: 2rem;
		border-top: 1px solid var(--line-divider);
	}
	.diary-date-final {
		font-size: 0.85rem; color: var(--content-meta); text-align: right;
		font-style: italic;
	}

	.diary-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.diary-tag {
		padding: 0.25rem 0.75rem; background: var(--btn-regular-bg-hover);
		border-radius: 9999px; font-size: 0.75rem; color: var(--content-meta);
	}
</style>

