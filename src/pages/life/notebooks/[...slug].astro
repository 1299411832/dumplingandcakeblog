---
import { getCollection, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import ArchiveHeatmap from "@/components/widget/ArchiveHeatmap.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export async function getStaticPaths() {
	const allEntries = await getCollection("notebooks");
	const paths: { params: { slug: string }; props: { entry: any; entries?: any[]; sortedEntries?: any[]; item?: any; isNotebookIndex?: boolean } }[] = [];

	for (const entry of allEntries) {
		const normalizedId = entry.id.replace(/\\/g, "/");
		if (normalizedId === "readme" || normalizedId === "readme.md") continue;
		const isIndexFile =
			/\/(_index|_index\.md|_index\.json)?$/.test(normalizedId) &&
			(normalizedId.endsWith("_index") || normalizedId.includes("/_index."));
		const isNotebookRoot =
			normalizedId.match(/^([^/]+)\/(_index|_index\.md|_index\.json)$/) ||
			normalizedId.match(/^([^/]+)\/_index$/);
		if (!isIndexFile || !isNotebookRoot) continue;

		const folderName = isNotebookRoot[1];
		const folderEntries = allEntries.filter((item) => {
			const itemId = item.id.replace(/\\/g, "/");
			return (
				itemId.startsWith(`${folderName}/`) &&
				!/^([^/]+)\/(_index|_index\.md|_index\.json)$/.test(itemId) &&
				itemId !== `${folderName}/_index` &&
				itemId !== `${folderName}/_index.md` &&
				itemId !== `${folderName}/_index.json`
			);
		});
		const sortedEntries = [...folderEntries].sort((a, b) => {
			const aT = a.data.date instanceof Date ? a.data.date.getTime() : 0;
			const bT = b.data.date instanceof Date ? b.data.date.getTime() : 0;
			return bT - aT;
		});

		paths.push({
			params: { slug: folderName },
			props: {
				entry,
				entries: folderEntries,
				sortedEntries,
				isNotebookIndex: true,
			},
		});
		for (const item of folderEntries) {
			const itemId = item.id.replace(/\\/g, "/");
			const itemSlug = itemId.split("/").pop()?.replace(/\.md$/, "") || "";
			paths.push({
				params: { slug: `${folderName}/${itemSlug}` },
				props: { entry, item, isNotebookIndex: false },
			});
		}
	}
	return paths;
}

const { entry, sortedEntries, item, isNotebookIndex } = Astro.props as {
	entry: any; sortedEntries?: any[]; item?: any; isNotebookIndex: boolean;
};
const notebookContent = !isNotebookIndex && item ? await render(item) : null;
const normalizedEntryId = entry.id.replace(/\\/g, "/");
const isNotebookRootMatch =
	normalizedEntryId.match(/^([^/]+)\/(_index|_index\.md|_index\.json)$/) ||
	normalizedEntryId.match(/^([^/]+)\/_index$/);
const folderName = isNotebookRootMatch
	? isNotebookRootMatch[1]
	: normalizedEntryId.split("/")[0];

const notebookCommentPath = !isNotebookIndex && item
	? `/life/notebooks/${item.id.replace(/\\/g, "/").replace(/\.md$/, "")}/`
	: "";

// 为热力图准备数据（仅当前笔记本的条目）
const heatmapPosts = isNotebookIndex
	? (sortedEntries || []).map((e) => ({
			id: e.id,
			data: { title: e.data.name || e.id, published: e.data.date instanceof Date ? e.data.date : new Date(0) },
		}))
	: [];

// 预处理：按年月分组（归档式时间线用）
interface ArchiveEntry { slug: string; day: string; name: string }
interface ArchiveMonth { month: number; entries: ArchiveEntry[] }
interface ArchiveYear { year: number; totalCount: number; months: ArchiveMonth[] }
const archiveYears: ArchiveYear[] = [];
if (isNotebookIndex && sortedEntries && sortedEntries.length > 0) {
	const yearMap = new Map<number, Map<number, ArchiveEntry[]>>();
	for (const e of sortedEntries) {
		const d = e.data.date instanceof Date ? e.data.date : new Date(0);
		const y = d.getFullYear();
		const m = d.getMonth() + 1;
		const noteItemId = e.id.replace(/\\/g, "/");
		const itemSlug = noteItemId.split("/").pop()?.replace(/\.md$/, "") || "未命名";
		if (!yearMap.has(y)) yearMap.set(y, new Map());
		const monthMap = yearMap.get(y)!;
		if (!monthMap.has(m)) monthMap.set(m, []);
		monthMap.get(m)!.push({ slug: itemSlug, day: String(d.getDate()).padStart(2, "0"), name: e.data.name || itemSlug });
	}
	for (const [year, monthMap] of Array.from(yearMap.entries()).sort((a, b) => b[0] - a[0])) {
		const months: ArchiveMonth[] = [];
		let total = 0;
		for (const [month, entries] of Array.from(monthMap.entries()).sort((a, b) => b[0] - a[0])) {
			months.push({ month, entries });
			total += entries.length;
		}
		archiveYears.push({ year, totalCount: total, months });
	}
}
---

{isNotebookIndex ? (
	<MainGridLayout title={entry.data.name || "笔记本"} description={entry.data.summary || "笔记本记录"}>
		<div class="flex w-full overflow-hidden relative min-h-32">
			<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">

					{/* 返回按钮 */}
				<a href="/life/notebooks/" class="diary-paper-back">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9.575 12L16 18.425l-1.425 1.425L6.725 12l7.85-7.85L16 5.575 9.575 12Z" fill="currentColor"/></svg>
					<span>返回笔记本列表</span>
				</a>

				{/* 标题 */}
				<div class="mb-8">
					<div class="flex items-center gap-3 mb-3">
						<Icon name="material-symbols:menu-book-outline" class="text-[1.875rem]" />
						<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
							{entry.data.name || "笔记本"}
						</div>
					</div>
					{entry.data.summary && (
						<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">{entry.data.summary}</p>
					)}
				</div>

				{/* 热力图 */}
				<ArchiveHeatmap posts={heatmapPosts} />

				{/* 归档式时间线（与 ArchivePanel 样式一致） */}
				<div class="archive-panel">
					{archiveYears.length > 0 ? (
						archiveYears.map((yr) => (
							<div class="ap-year-block">
								<div class="ap-year-header">
									<div class="ap-col"><div class="ap-node ap-year-node"></div></div>
									<div class="ap-year-label">
										<h2 class="ap-h1">{yr.year}年</h2>
										<span class="ap-count">共 {yr.totalCount} 篇</span>
									</div>
								</div>
								<div class="ap-months-area">
									{yr.months.map((mg) => (
										<div class="ap-month-block">
											<div class="ap-month-header">
												<div class="ap-col"><div class="ap-hline ap-month-hline"></div><div class="ap-node ap-month-node"></div></div>
												<div class="ap-month-label">
													<h3 class="ap-h2">{mg.month}月</h3>
													<span class="ap-count">{mg.entries.length} 篇</span>
												</div>
											</div>
											<div class="ap-posts-area">
												<ul class="ap-post-list">
													{mg.entries.map((entry, idx) => (
														<li class:list={["ap-post-row", { last: idx === mg.entries.length - 1 }]}>
															<div class="ap-col"><div class="ap-hline ap-post-hline"></div><div class="ap-node ap-post-node"></div></div>
															<a href={`/life/notebooks/${folderName}/${entry.slug}/`} class="ap-post-link group btn-plain">
																<span class="ap-date">{entry.day}</span>
																<span class="ap-type-badge">笔记</span>
																<span class="ap-title group-hover:text-(--primary)">{entry.name}</span>
															</a>
														</li>
													))}
												</ul>
											</div>
										</div>
									))}
								</div>
							</div>
						))
					) : (
						<div class="nb-empty">
							<span class="nb-empty-icon">📝</span>
							<p>还没有日记内容</p>
						</div>
					)}
				</div>

			</div>
		</div>
	</MainGridLayout>
) : (
	<MainGridLayout title={(item?.data?.name || "日记") + " - 笔记本"}>
		<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
			<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
			<div class="diary-detail-page">
			<article class="diary-paper">
				<a href={`/life/notebooks/${folderName}/`} class="diary-paper-back">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9.575 12L16 18.425l-1.425 1.425L6.725 12l7.85-7.85L16 5.575 9.575 12Z" fill="currentColor"/></svg>
					<span>返回 {entry.data.name || "日记本"}</span>
				</a>

				<h1 class="diary-paper-title">
					{item?.data?.name || item?.id?.replace(/\\/g, "/").split("/").pop()?.replace(/\.md$/, "") || "无标题"}
				</h1>

				<div class="diary-paper-content">
					{notebookContent ? (
						<Markdown class="diary-paper-content"><notebookContent.Content /></Markdown>
					) : (
						<p>（无内容）</p>
					)}
				</div>

				<div class="diary-paper-footer">
					{item?.data?.tags && item.data.tags.length > 0 && (
						<div class="diary-tags">
							{item.data.tags.map((tag: string) => (<span class="diary-tag">#{tag}</span>))}
						</div>
					)}
					<span class="diary-date-final">
						{item?.data?.date instanceof Date ? item.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric", weekday: "long" }) : "未填写日期"}
					</span>
				</div>
			</article>

			<Comment customPath={notebookCommentPath} />
		</div>
		</div>
		</div>
	</MainGridLayout>
)}

<style>
	/* ===== 归档式时间线（与 ArchivePanel 一致） ===== */
	.archive-panel { --tw: 2rem; --lc: var(--line-color, oklch(0.82 0 0)); --lh: oklch(0.15 0 0); --nc: var(--line-color, oklch(0.82 0 0)); --nh: oklch(0.15 0 0); --lw: 2.5px; position: relative; }
	:root.dark .archive-panel { --lc: oklch(0.35 0 0); --lh: oklch(0.85 0 0); --nc: oklch(0.35 0 0); --nh: oklch(0.85 0 0); }
	.ap-year-block { position: relative; margin-bottom: 2.5rem; }
	.ap-year-block::before { content: ""; position: absolute; left: calc(var(--tw) / 2); top: calc(var(--tw) / 2); bottom: 1rem; width: 0; border-left: var(--lw) dashed var(--lc); z-index: 0; }
	.ap-months-area { padding-left: var(--tw); }
	.ap-month-block { position: relative; margin-bottom: 0.5rem; }
	.ap-month-block::before { content: ""; position: absolute; left: calc(var(--tw) / 2); top: calc(var(--tw) / 2); bottom: 1rem; width: 0; border-left: var(--lw) dashed var(--lc); z-index: 0; }
	.ap-posts-area { padding-left: var(--tw); }
	.ap-post-list { list-style: none; margin: 0; padding: 0; }
	.ap-post-row { position: relative; display: flex; align-items: center; min-height: 2.25rem; transition: transform 0.2s cubic-bezier(0.4,0,0.2,1); }
	.ap-post-row:hover { transform: translateX(0.375rem); }
	.ap-col { position: relative; width: var(--tw); flex-shrink: 0; align-self: stretch; }
	.ap-node { position: absolute; left: 50%; transform: translateX(-50%); border-radius: 50%; z-index: 2; transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease; }
	.ap-year-node { top: calc(50% - 0.375rem); width: 0.75rem; height: 0.75rem; border: 2px solid var(--nc); background: var(--page-bg, white); }
	.ap-month-node { top: calc(50% - 0.25rem); width: 0.5rem; height: 0.5rem; background: var(--nc); }
	.ap-post-node { top: calc(50% - 0.2rem); width: 0.4rem; height: 0.4rem; background: var(--nc); }
	.ap-post-node.hovered { background: var(--nh); transform: translateX(-50%) scale(1.6); }
	.ap-hline { position: absolute; height: 0; border-top: var(--lw) dashed var(--lc); z-index: 1; }
	.ap-month-hline { top: 50%; left: calc(-1 * var(--tw) / 2); width: var(--tw); }
	.ap-post-hline { top: 50%; left: calc(-1 * var(--tw) / 2); width: var(--tw); }
	.ap-year-header, .ap-month-header { display: flex; align-items: center; min-height: var(--tw); }
	.ap-year-label, .ap-month-label { display: flex; align-items: baseline; gap: 0.6rem; padding-left: 0.5rem; flex: 1; }
	.ap-h1 { font-size: 1.25rem; font-weight: 800; color: var(--deep-text); margin: 0; }
	.ap-h2 { font-size: 0.9375rem; font-weight: 700; color: var(--deep-text); margin: 0; }
	.ap-count { font-size: 0.75rem; color: var(--content-meta); }
	.ap-date { flex-shrink: 0; width: 2.5rem; font-size: 0.8125rem; color: var(--content-meta); font-variant-numeric: tabular-nums; }
	.ap-type-badge { flex-shrink: 0; font-size: 0.625rem; padding: 0.0625rem 0.375rem; border-radius: 0.25rem; background: oklch(0.92 0 0); color: oklch(0.35 0 0); font-weight: 600; }
	:root.dark .ap-type-badge { background: oklch(0.25 0 0); color: oklch(0.65 0 0); }
	.ap-title { flex: 1; min-width: 0; font-size: 0.875rem; color: var(--deep-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.ap-post-link { display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.5rem; border-radius: 0.375rem; text-decoration: none; color: inherit; transition: background 0.15s ease; }
	.ap-post-link:hover { background: var(--btn-plain-bg-hover); }

	/* 空状态 */
	.nb-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 3rem;
		background: var(--card-bg);
		border: 1.5px dashed var(--line-divider);
		border-radius: 1rem;
		text-align: center;
	}

	.nb-empty-icon {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}

	.nb-empty p {
		font-size: 0.875rem;
		color: var(--content-meta);
		margin: 0;
	}

	/* ===== 日记详情页 ===== */
	.diary-detail-page { max-width: 48rem; margin: 0 auto; }
	.diary-paper {
		background: var(--page-bg); color: var(--deep-text);
		padding: 2rem 0.75rem;
	}
	@media (min-width: 768px) {
		.diary-paper { padding: 2rem 1.25rem; }
	}

	.diary-paper-back {
		display: inline-flex; align-items: center; gap: 0.4rem;
		font-size: 0.85rem; color: var(--content-meta); text-decoration: none;
		margin-bottom: 2rem; transition: color 0.2s;
	}
	.diary-paper-back:hover { color: var(--primary); }

	.diary-paper-title { font-size: 1.75rem; font-weight: 700; color: var(--deep-text); margin: 0 0 2rem; line-height: 1.4; }

	.diary-paper-content { font-size: 1rem; line-height: 1.9; }
	.diary-paper-content :global(p) { margin: 0 0 1.25rem; }
	.diary-paper-content :global(blockquote) { border-left-color: var(--primary); }

	.diary-paper-content :global(p:has(> img:only-child)) {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
	}
	.diary-paper-content :global(p:has(> img:only-child):has(img:nth-child(2)):not(:has(img:nth-child(3)))) {
		grid-template-columns: repeat(2, 1fr);
	}
	.diary-paper-content :global(p:has(> img:only-child):not(:has(img:nth-child(2)))) {
		grid-template-columns: 280px;
		justify-content: start;
	}
	.diary-paper-content :global(img) {
		border-radius: 0.5rem;
		max-width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		cursor: zoom-in;
	}
	.diary-paper-content :global(p:has(> img:only-child)) img {
		width: 100%;
		height: 100%;
	}

	.diary-paper-footer {
		display: flex; align-items: flex-end; justify-content: space-between;
		margin-top: 3rem; padding-top: 2rem;
		border-top: 1px solid var(--line-divider);
	}
	.diary-date-final {
		font-size: 0.85rem; color: var(--content-meta); text-align: right;
		font-style: italic;
	}

	.diary-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.diary-tag {
		padding: 0.25rem 0.75rem; background: var(--btn-regular-bg-hover);
		border-radius: 9999px; font-size: 0.75rem; color: var(--content-meta);
	}
</style>

