---
import { getCollection } from "astro:content";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 预加载笔记本文件夹内的封面图片
const notebookCoverFiles = import.meta.glob<ImageMetadata>(
	"../../content/life/notebooks/**/*.{jpg,jpeg,png,webp,avif,gif,svg}",
	{ import: "default" },
);

const allEntries = await getCollection("notebooks");

const sortByDateDesc = <T extends Record<string, unknown>>(
	list: T[],
	field: keyof T,
) =>
	[...list].sort((a, b) => {
		const aDate = a[field] instanceof Date ? a[field]!.getTime() : 0;
		const bDate = b[field] instanceof Date ? b[field]!.getTime() : 0;
		return bDate - aDate;
	});

const notebooks = allEntries
	.map((entry) => {
		const normalizedId = entry.id.replace(/\\/g, "/");
		if (normalizedId === "readme" || normalizedId === "readme.md") {
			return null;
		}
		const isNotebookRoot =
			normalizedId.match(/^([^/]+)\/(_index|_index\.md|_index\.json)$/) ||
			normalizedId.match(/^([^/]+)\/_index$/);

		if (!isNotebookRoot) {
			return null;
		}

		const folderName = isNotebookRoot[1];

		const folderEntries = allEntries.filter((item) => {
			const itemId = item.id.replace(/\\/g, "/");
			const isIndexFile =
				itemId === `${folderName}/_index` ||
				itemId === `${folderName}/_index.md` ||
				itemId === `${folderName}/_index.json`;
			return itemId.startsWith(`${folderName}/`) && !isIndexFile;
		});

		const sortedEntries = sortByDateDesc(
			folderEntries.map((e) => e.data),
			"date",
		);
		const latestEntry = sortedEntries[0];

		return {
			id: entry.id,
			name: entry.data.name,
			cover: entry.data.cover,
			summary: entry.data.summary,
			entries: folderEntries.length,
			updatedAt:
				latestEntry?.date instanceof Date ? latestEntry.date : new Date(0),
			selfPath: `/life/notebooks/${folderName}/`,
			folderName,
		};
	})
	.filter(Boolean);

// 解析封面图：本地图片 → Astro ImageMetadata，URL → 直接使用
const notebooksWithCovers = await Promise.all(
	notebooks
		.filter((b) => b !== null)
		.map(async (book) => {
			let coverSrc: string | null = null;
			const rawCover = book.cover as string | undefined;
			if (rawCover) {
				if (rawCover.startsWith("http://") || rawCover.startsWith("https://")) {
					coverSrc = rawCover;
				} else {
					const imageKey = path
						.normalize(
							path.join(
								"../../content/life/notebooks",
								book.folderName,
								rawCover,
							),
						)
						.replace(/\\/g, "/");
					const loader = notebookCoverFiles[imageKey];
					if (loader) {
						try {
							const img = await loader();
							coverSrc = img.src;
						} catch {
							coverSrc = null;
						}
					}
				}
			}
			return { ...book, coverSrc };
		}),
);

const sortedNotebooks = sortByDateDesc(notebooksWithCovers, "updatedAt");

// 统计数据
const totalNotebooks = sortedNotebooks.length;
const totalEntries = sortedNotebooks.reduce((sum, b) => sum + (b?.entries || 0), 0);
const latestUpdate = sortedNotebooks[0]?.updatedAt instanceof Date ? sortedNotebooks[0].updatedAt : null;
const now = new Date();
const isToday = latestUpdate && latestUpdate.toDateString() === now.toDateString();
const isYesterday = latestUpdate && new Date(now.getTime() - 86400000).toDateString() === latestUpdate.toDateString();
const latestText = isToday ? "今天" : isYesterday ? "昨天" : latestUpdate ? latestUpdate.toISOString().split("T")[0] : "暂无";

// 随机取一条笔记
const allEntriesRaw = await getCollection("notebooks");
const allNotes = allEntriesRaw.filter((e) => {
	const id = e.id.replace(/\\/g, "/");
	return !id.match(/\/(_index|_index\.md|_index\.json)$/) && id !== "readme" && id !== "readme.md";
});
const randomNote = allNotes.length > 0 ? allNotes[Math.floor(Math.random() * allNotes.length)] : null;
const randomNoteData = randomNote?.data;
const randomNoteFolder = randomNote ? randomNote.id.replace(/\\/g, "/").split("/")[0] : "";
const randomNotebook = sortedNotebooks.find((b) => b?.folderName === randomNoteFolder);
---

<MainGridLayout title="笔记本" description="成长日记、学习复盘、灵感随笔">
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
		<div class="diary-page flex w-full flex-col gap-4">
			<!-- 顶部：图标 + 标题 + 统计 -->
			<div class="diary-header">
				<div class="mb-6">
					<div class="flex items-center gap-3 mb-3">
						<Icon name="material-symbols:menu-book-outline" class="text-[1.875rem] text-neutral-900 dark:text-neutral-100" />
						<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">笔记本</div>
					</div>
					<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">成长日记、学习复盘、灵感随笔</p>
				</div>

			<!-- 随机笔记（一行） -->
			{randomNoteData && (
				<a href={`/life/notebooks/${randomNoteFolder}/`} class="diary-random-note">
					<span class="diary-random-icon"><img src="/assets/images/em/1000023899.gif" alt="" width="18" height="18" /></span>
					<span class="diary-random-text">{randomNoteData.name || randomNoteData.summary || "未命名笔记"}</span>
					{randomNotebook && (
						<span class="diary-random-from">{randomNotebook.name}</span>
					)}
				</a>
			)}

			<!-- 统计栏 -->
			<div class="diary-stats">
				<span class="diary-stats-item">
					<Icon name="material-symbols:menu-book-outline" class="text-sm" />
					<strong>{totalNotebooks}</strong> 本
				</span>
				<span class="diary-stats-dot">·</span>
				<span class="diary-stats-item">
					<Icon name="material-symbols:edit-note" class="text-sm" />
					<strong>{totalEntries}</strong> 篇
				</span>
				<span class="diary-stats-dot">·</span>
				<span class="diary-stats-item">
					<Icon name="material-symbols:schedule" class="text-sm" />
					{latestText}
				</span>
			</div>
		</div>

		<!-- 笔记本列表 -->
		<section>
			{sortedNotebooks.length === 0 ? (
				<div class="diary-empty">
					<div class="text-6xl mb-4">📖</div>
					<h3 class="text-xl font-semibold mb-2 text-[var(--text-color)]">还没有日记本</h3>
					<p class="text-sm text-[var(--content-meta)]">开始记录你的第一篇日记吧！</p>
					<div class="mt-6 p-4 rounded-xl bg-[var(--btn-regular-bg)] text-left text-sm">
						<p class="text-[var(--text-color)] mb-2">创建步骤：</p>
						<ol class="text-[var(--content-meta)] space-y-1 list-decimal list-inside">
							<li>在 <code class="px-1 rounded bg-[var(--btn-regular-bg-hover)] font-mono">src/content/life/notebooks/</code> 下创建文件夹</li>
							<li>在文件夹内创建 <code class="px-1 rounded bg-[var(--btn-regular-bg-hover)] font-mono">_index.json</code> 文件</li>
							<li>在文件夹内创建 <code class="px-1 rounded bg-[var(--btn-regular-bg-hover)] font-mono">*.md</code> 文件作为日记条目</li>
						</ol>
					</div>
				</div>
			) : (
				<div class="diary-list">
					{sortedNotebooks.map((book) => (
						<a href={book.selfPath} class="diary-row-card group">
							{/* 左侧封面 */}
							<div class="diary-row-cover">
								{book.coverSrc ? (
									<img src={book.coverSrc} alt={book.name || "笔记本封面"} class="diary-row-cover-img" loading="lazy" />
								) : (
									<div class="diary-row-cover-placeholder">
										<span>📔</span>
									</div>
								)}
								<div class="diary-row-cover-overlay"></div>
							</div>

							{/* 右侧内容 */}
							<div class="diary-row-content">
								<div class="diary-row-top">
									<div class="diary-row-tag">
										<Icon name="material-symbols:menu-book-outline" class="text-xs" />
										<span>笔记</span>
									</div>
									<span class="diary-row-entries">{book.entries} 篇</span>
								</div>
								<h3 class="diary-row-name">{book.name || "未命名笔记本"}</h3>
								<p class="diary-row-desc">{book.summary || "暂无描述"}</p>
								<div class="diary-row-bottom">
									<span class="diary-row-date">
										<Icon name="material-symbols:schedule" class="text-xs" />
										{book.updatedAt instanceof Date ? book.updatedAt.toISOString().split("T")[0] : "未更新"}
									</span>
									<Icon name="material-symbols:chevron-right-rounded" class="diary-row-arrow" />
								</div>
							</div>
						</a>
					))}
				</div>
			)}
		</section>

		<!-- 装饰页脚 -->
		<section class="text-center py-4">
			<p class="text-sm text-[var(--content-meta)] opacity-50">
				✨ 每一页都是成长的足迹
			</p>
		</section>
	</div>
	</div>
	</div>
</MainGridLayout>

<style>
	/* 样式已移至 src/styles/pages/notebooks.css（全局 CSS），避免 Swup 过渡时样式丢失 */
</style>
