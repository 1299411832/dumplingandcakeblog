---
import CategoryRose from "@components/widget/CategoryRose.astro";
import TagGraph from "@components/widget/TagGraph.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCategoryList } from "@/utils/content-utils";
import { getTagGraphData } from "@/utils/tag-graph-data";

const categories = await getCategoryList();
const tagGraph = await getTagGraphData();
const title = i18n(I18nKey.categories);
---

<MainGridLayout title={title}>
  <div class="categories-page card-base z-10 px-4 py-6 md:px-9 relative w-full">
    <!-- 页面标题 -->
    <div class="categories-page__header mb-6">
      <div class="flex items-center gap-3 mb-2">
        <h1 class="text-2xl font-bold text-(--primary)">{title}</h1>
      </div>
      <p class="text-sm text-neutral-500 dark:text-neutral-400">
        Taxonomy · {categories.length} 个分类 · {tagGraph.nodes.length} 个标签
      </p>
    </div>

    <!-- 分类：玫瑰图 + 列表 -->
    <CategoryRose categories={categories} />

    <!-- 标签关系图谱 -->
    <div class="categories-page__divider"></div>
    <TagGraph graph={tagGraph} />
  </div>
</MainGridLayout>
