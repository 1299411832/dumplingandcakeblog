---
import { externalNotebooksConfig } from "@/config/externalNotebooksConfig";
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="笔记管理" activeItem="notebooks">
  <!-- 笔记本选择 -->
  <div class="card mb-3">
    <div class="card-header"><span class="card-title">选择笔记本</span></div>
    <div class="card-body">
      <div class="d-flex flex-wrap gap-1" id="notebook-tabs">
        <div class="text-center text-secondary" style="padding:12px;">加载中...</div>
      </div>
    </div>
  </div>

  <!-- 编辑器 -->
  <div class="card mb-3" id="editor-card">
    <div class="card-header">
      <span class="card-title">写笔记 → <strong id="target-notebook">未选择</strong></span>
    </div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">快速模板</label>
        <div id="template-buttons" class="d-flex flex-wrap gap-1"></div>
      </div>
      <div class="form-group"><label class="form-label">标题</label><input type="text" class="form-input" id="entry-title" placeholder="笔记标题（可选）" /></div>
      <div class="form-group"><label class="form-label">日期</label><input type="date" class="form-input" id="entry-date" /></div>
      <div class="form-group">
        <label class="form-label">内容（Markdown）</label>
        <div style="border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;">
          <div style="display:flex;gap:2px;padding:6px 8px;border-bottom:1px solid var(--border);background:var(--hover);">
            <button class="btn btn-ghost btn-sm" onclick="insertMd('**','**')"><strong>B</strong></button>
            <button class="btn btn-ghost btn-sm" onclick="insertMd('*','*')"><em>I</em></button>
            <button class="btn btn-ghost btn-sm" onclick="insertMd('`','`')">&lt;&gt;</button>
            <button class="btn btn-ghost btn-sm" onclick="insertMd('\n```\n','\n```\n')">{ }</button>
            <button class="btn btn-ghost btn-sm" onclick="insertMd('[','](url)')">🔗</button>
            <button class="btn btn-ghost btn-sm" onclick="insertMd('> ','')">❝</button>
            <button class="btn btn-ghost btn-sm" onclick="insertMd('- ','')">☰</button>
          </div>
          <div style="display:grid;grid-template-columns:1fr;min-height:300px;">
            <textarea class="form-input border-0" id="content-input" style="min-height:300px;resize:vertical;font-family:'JetBrains Mono','Fira Code',monospace;font-size:13px;line-height:1.8;border-radius:0;" placeholder="用 Markdown 写下你的笔记..."></textarea>
            <div class="border-top" id="preview-pane" style="min-height:200px;padding:12px;overflow-y:auto;font-size:13px;line-height:1.8;">
              <div class="text-center text-tertiary" style="padding:24px;">开始编辑后预览内容</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="card-footer">
      <button class="btn btn-primary" id="submit-btn" onclick="submitEntry()" style="width:100%;">保存笔记</button>
      <div class="d-none mt-2" id="edit-bar"><button class="btn" onclick="cancelEdit()" style="width:100%;">取消编辑</button></div>
    </div>
  </div>

  <!-- 笔记列表 -->
  <div class="card">
    <div class="card-header">
      <span class="card-title"><span id="list-title">已有笔记</span></span>
      <span class="text-tertiary" id="list-count" style="font-size:12px;"></span>
    </div>
    <div id="entries-list">
      <div class="text-center text-tertiary" style="padding:24px;">请先选择笔记本</div>
    </div>
  </div>

  <div class="toast-wrap"><div class="toast" id="toast-el"></div></div>

  <style>
    @media (min-width: 768px) {
      #editor-card .form-group:last-child > div > div:last-child {
        display: grid; grid-template-columns: 1fr 1fr;
      }
      #editor-card .form-group:last-child > div > div:last-child > div:last-child {
        border-top: none; border-left: 1px solid var(--border);
      }
    }
    #preview-pane h1, #preview-pane h2, #preview-pane h3 { margin: 1em 0 0.5em; }
    #preview-pane h1 { font-size: 1.25rem; } #preview-pane h2 { font-size: 1.1rem; } #preview-pane h3 { font-size: 1rem; }
    #preview-pane p { margin: 0 0 0.75em; }
    #preview-pane ul, #preview-pane ol { margin: 0 0 0.75em; padding-left: 1.5em; }
    #preview-pane li { margin-bottom: 0.25em; }
    #preview-pane blockquote { border-left: 2px solid var(--text-3); padding-left: 1em; margin: 0 0 0.75em; color: var(--text-2); }
    #preview-pane code { font-family: 'JetBrains Mono', monospace; background: var(--hover); padding: 0.1em 0.3em; font-size: 0.9em; }
    #preview-pane pre { background: var(--hover); padding: 0.75em; margin: 0 0 0.75em; overflow-x: auto; }
    #preview-pane pre code { background: none; padding: 0; }
    #preview-pane img { max-width: 100%; }
    #preview-pane a { color: var(--text); text-decoration: underline; }
    #preview-pane hr { border: none; border-top: 1px solid var(--border); margin: 1.5em 0; }
  </style>

  <script is:inline
    data-templates={JSON.stringify(externalNotebooksConfig.templates || [])}>
    (function() {
      var _script = document.currentScript;
      var TEMPLATES = JSON.parse(_script.getAttribute("data-templates") || "[]");
      var API_BASE = "/api/admin/notebooks/";
      var currentNotebook = "", editingEntryId = null, allEntries = [];
      var renderedNotebooks = []; // cache for tabs

      function $(id) { return document.getElementById(id); }
      function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
      function toast(msg, type) { var el = $("toast-el"); el.textContent = msg; el.className = "toast " + type + " show"; clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800); }

      // 加载笔记本列表
      function loadNotebookList() {
        var tabs = $("notebook-tabs");
        fetch(API_BASE, { credentials: "include" })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (!data.success || !data.data) { tabs.innerHTML = '<div class="text-center text-danger" style="padding:12px;">加载失败</div>'; return; }
            renderedNotebooks = data.data;
            tabs.innerHTML = "";
            renderedNotebooks.forEach(function(name) {
              var btn = document.createElement("button");
              btn.className = "btn btn-sm notebook-tab";
              btn.textContent = name;
              btn.setAttribute("data-notebook", name);
              btn.addEventListener("click", function() {
                document.querySelectorAll(".notebook-tab").forEach(function(t) { t.classList.remove("btn-primary"); });
                btn.classList.add("btn-primary");
                currentNotebook = name;
                $("target-notebook").textContent = currentNotebook;
                $("list-title").textContent = currentNotebook + " 的笔记";
                loadEntries();
              });
              tabs.appendChild(btn);
            });
          });
      }

      function loadEntries() {
        if (!currentNotebook) return;
        $("entries-list").innerHTML = '<div class="text-center text-secondary" style="padding:24px;"><span class="spinner"></span></div>';
        fetch(API_BASE + "?notebook=" + encodeURIComponent(currentNotebook), { credentials: "include" })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (!data.success) { $("entries-list").innerHTML = '<div class="text-center text-danger" style="padding:24px;">' + esc(data.error || "加载失败") + '</div>'; return; }
            allEntries = data.data || [];
            renderEntries();
          }).catch(function() { $("entries-list").innerHTML = '<div class="text-center text-danger" style="padding:24px;">加载失败</div>'; });
      }

      function renderEntries() {
        var list = $("entries-list");
        if (!currentNotebook) { list.innerHTML = '<div class="text-center text-tertiary" style="padding:24px;">请先选择笔记本</div>'; $("list-count").textContent = ""; return; }
        $("list-count").textContent = allEntries.length + " 篇";
        if (!allEntries.length) { list.innerHTML = '<div class="text-center text-tertiary" style="padding:32px;">该笔记本还没有笔记</div>'; return; }
        list.innerHTML = "";
        allEntries.forEach(function(e) {
          var d = document.createElement("div"); d.className = "list-row";
          var date = e.date || "";
          var preview = (e.content || "").replace(/[#*`>\-\[\]!]/g, "").replace(/\n/g, " ").slice(0, 80);
          d.innerHTML = '<div class="flex-1 min-w-0"><div class="fw-500" style="font-size:14px;">' + esc(e.title || "无标题") + '</div><div class="text-tertiary" style="font-size:12px;">' + date + '</div>' + (preview ? '<div class="text-secondary text-truncate" style="font-size:13px;">' + esc(preview) + '</div>' : "") + '</div>' +
            '<div class="d-flex gap-1"><button class="btn btn-ghost btn-sm" onclick="editEntry(\'' + e.id + '\')">编辑</button><button class="btn btn-ghost btn-sm btn-danger" onclick="deleteEntry(\'' + e.id + '\')">删除</button></div>';
          list.appendChild(d);
        });
      }

      (function() { var c = document.getElementById("template-buttons"); if (!c || !TEMPLATES.length) return;
        TEMPLATES.forEach(function(tpl) { var btn = document.createElement("button"); btn.className = "btn btn-sm"; btn.textContent = tpl.icon + " " + tpl.name; btn.onclick = function() { applyTemplate(tpl); }; c.appendChild(btn); });
      })();
      function applyTemplate(tpl) { if ($("content-input").value.trim() && !confirm("当前内容将被覆盖？")) return; var today = new Date().toISOString().split("T")[0]; $("entry-title").value = (tpl.title || "").replace(/\{name\}/g, today); $("content-input").value = tpl.content || ""; updatePreview(); }

      function insertMd(before, after) {
        var ta = $("content-input"); var start = ta.selectionStart, end = ta.selectionEnd;
        var text = ta.value, selected = text.substring(start, end) || "文本";
        ta.value = text.substring(0, start) + before + selected + after + text.substring(end);
        ta.focus(); ta.selectionStart = start + before.length; ta.selectionEnd = start + before.length + selected.length; updatePreview();
      }
      var previewTimer = null;
      function updatePreview() { clearTimeout(previewTimer); previewTimer = setTimeout(function() {
        var md = $("content-input").value; var pane = $("preview-pane");
        if (!md) { pane.innerHTML = '<div class="text-center text-tertiary" style="padding:24px;">开始编辑后预览内容</div>'; } else { pane.innerHTML = renderMarkdown(md); }
      }, 200); }
      function renderMarkdown(md) {
        if (!md) return ""; var html = md;
        html = html.replace(/```(\w*)\n([\s\S]*?)```/g, function(m, l, c) { return '<pre><code>' + esc(c) + '</code></pre>'; });
        html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
        html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>'); html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>'); html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>');
        html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>'); html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
        html = html.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1">'); html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>');
        html = html.replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>'); html = html.replace(/^- (.+)$/gm, '<li>$1</li>');
        html = html.replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>'); html = html.replace(/^---$/gm, '<hr>');
        html = html.replace(/\n\n/g, '</p><p>'); html = html.replace(/\n/g, '<br>'); html = '<p>' + html + '</p>';
        html = html.replace(/<p>\s*<\/p>/g, '');
        html = html.replace(/<p>\s*(<h[1-6]>)/g, '$1'); html = html.replace(/(<\/h[1-6]>)\s*<\/p>/g, '$1');
        html = html.replace(/<p>\s*(<pre>)/g, '$1'); html = html.replace(/(<\/pre>)\s*<\/p>/g, '$1');
        html = html.replace(/<p>\s*(<ul>)/g, '$1'); html = html.replace(/(<\/ul>)\s*<\/p>/g, '$1');
        html = html.replace(/<p>\s*(<blockquote>)/g, '$1'); html = html.replace(/(<\/blockquote>)\s*<\/p>/g, '$1');
        html = html.replace(/<p>\s*(<hr>)/g, '$1'); html = html.replace(/(<hr>)\s*<\/p>/g, '$1');
        return html;
      }

      function editEntry(id) {
        var entry = allEntries.find(function(e) { return e.id === id; }); if (!entry) { toast("未找到", "err"); return; }
        editingEntryId = id; $("entry-title").value = entry.title || ""; $("entry-date").value = entry.date || "";
        $("content-input").value = entry.content || ""; $("submit-btn").textContent = "保存修改"; $("edit-bar").classList.remove("d-none");
        updatePreview(); window.scrollTo({ top: 0, behavior: "smooth" }); toast("正在编辑: " + (entry.title || "无标题"), "ok");
      }
      function cancelEdit() { editingEntryId = null; $("entry-title").value = ""; $("entry-date").value = new Date().toISOString().split("T")[0]; $("content-input").value = ""; $("submit-btn").textContent = "保存笔记"; $("edit-bar").classList.add("d-none"); updatePreview(); }
      function submitEntry() {
        if (!currentNotebook) { toast("请先选择笔记本", "err"); return; }
        var content = $("content-input").value.trim(); if (!content) { toast("请输入内容", "err"); return; }
        var title = $("entry-title").value.trim(), date = $("entry-date").value || new Date().toISOString().split("T")[0];
        var btn = $("submit-btn"), isEdit = !!editingEntryId; btn.disabled = true; btn.textContent = "保存中...";
        var method = isEdit ? "PUT" : "POST";
        var payload = { id: editingEntryId || undefined, notebook: currentNotebook, title: title, date: date, content: content };
        fetch(API_BASE, { method: method, credentials: "include", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.success) { toast(isEdit ? "已保存 ✓" : "保存成功 ✓", "ok"); cancelEdit(); loadEntries(); }
            else { toast(data.error || "保存失败", "err"); }
          }).catch(function(e) { toast("保存失败: " + e.message, "err"); })
          .finally(function() { btn.disabled = false; btn.textContent = isEdit ? "保存修改" : "保存笔记"; });
      }
      function deleteEntry(id) {
        if (!confirm("确定删除该笔记？")) return;
        if (!currentNotebook) return;
        fetch(API_BASE, { method: "DELETE", credentials: "include", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: id, notebook: currentNotebook }) })
          .then(function(r) { return r.json(); })
          .then(function(data) { if (data.success) { toast("已删除", "ok"); loadEntries(); } else { toast(data.error || "删除失败", "err"); } })
          .catch(function(e) { toast("删除失败", "err"); });
      }

      window.insertMd = insertMd; window.submitEntry = submitEntry;
      window.editEntry = editEntry; window.cancelEdit = cancelEdit; window.deleteEntry = deleteEntry;

      (function() {
        if (sessionStorage.getItem("admin_auth") !== "1") { window.location.href = "/admin/"; return; }
        $("entry-date").value = new Date().toISOString().split("T")[0];
        $("content-input").addEventListener("input", updatePreview);
        loadNotebookList();
      })();
    })();
  </script>
</AdminLayout>
