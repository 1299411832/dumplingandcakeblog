---
// 后台管理入口 - 纯登录页
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>登录 · 后台管理</title>
  <style is:inline>
    :root {
      --bg: #fafafa; --bg-elevated: #fff; --border: #e8e8ec;
      --text: #171717; --text-2: #525252; --text-3: #a0a0a0;
      --accent: #171717; --accent-text: #fff;
      --hover: #f4f4f6; --danger: #dc2626; --radius: 8px;
      --sidebar-accent: #7c5cfc;
    }
    :root.dark {
      --bg: #0a0a0a; --bg-elevated: #141414; --border: #222;
      --text: #ededed; --text-2: #a0a0a0; --text-3: #555;
      --accent: #ededed; --accent-text: #0a0a0a;
      --hover: #1a1a1a;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: "AaZongYiYuan", "MiSans", system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans SC", sans-serif;
      background: var(--bg); color: var(--text); min-height: 100vh;
      -webkit-font-smoothing: antialiased; font-size: 14px; line-height: 1.5;
    }
    a { color: inherit; text-decoration: none; }

    .login-split { display: grid; grid-template-columns: 1fr; min-height: 100vh; }
    @media (min-width: 992px) { .login-split { grid-template-columns: 1fr 1fr; } }

    /* 左侧夜空 */
    .login-left {
      display: none; position: relative; overflow: hidden;
      background: linear-gradient(180deg, #0a0e27 0%, #1a1040 40%, #0d1b3e 100%);
    }
    @media (min-width: 992px) { .login-left { display: flex; flex-direction: column; justify-content: space-between; } }
    #star-canvas { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
    .meteor {
      position: absolute; z-index: 2; pointer-events: none;
      width: 80px; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0.8), transparent);
      border-radius: 1px; opacity: 0;
    }
    .meteor::before {
      content: ''; position: absolute; right: 0; top: -1px;
      width: 4px; height: 3px; border-radius: 50%;
      background: #fff; box-shadow: 0 0 6px 2px rgba(255,255,255,0.6);
    }
    .left-brand {
      position: relative; z-index: 3; padding: 24px;
      display: flex; align-items: center; gap: 10px;
      color: rgba(255,255,255,0.9); font-size: 15px; font-weight: 600;
    }
    .left-brand .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--sidebar-accent);
      box-shadow: 0 0 10px rgba(124,92,252,0.5);
    }
    .left-footer {
      position: relative; z-index: 3; padding: 24px;
      display: flex; gap: 24px; font-size: 13px;
      color: rgba(255,255,255,0.35);
    }
    .left-footer a { color: rgba(255,255,255,0.35); transition: color 0.2s; }
    .left-footer a:hover { color: rgba(255,255,255,0.7); }

    /* 角色 */
    .characters {
      position: relative; z-index: 3;
      display: flex; align-items: flex-end; justify-content: center;
      height: 420px; padding: 0 24px;
    }
    .char-stage { position: relative; width: 450px; height: 400px; }
    .character {
      position: absolute; bottom: 0; transform-origin: bottom center;
      transition: transform 0.7s cubic-bezier(0.4,0,0.2,1), height 0.7s cubic-bezier(0.4,0,0.2,1);
    }
    .char-eyes {
      position: absolute; display: flex; gap: 0;
      transition: left 0.7s ease, top 0.7s ease;
    }
    .eye {
      border-radius: 50%; background: #fff;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden; transition: height 0.15s ease;
      position: relative;
    }
    .eye-pupil {
      border-radius: 50%; background: #2D2D2D;
      transition: transform 0.1s ease-out;
      position: absolute;
    }
    .pupil-only {
      border-radius: 50%; background: #2D2D2D;
      transition: transform 0.1s ease-out;
    }
    .mouth { position: absolute; z-index: 1; transition: all 0.3s ease; }

    /* 紫色高个子 */
    .char-purple {
      left: 70px; width: 140px; height: 350px;
      background: #6C3FF5; border-radius: 10px 10px 0 0; z-index: 1;
      opacity: 0;
      animation: purple-roll-in 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s forwards;
    }
    .char-purple .char-eyes { gap: 28px; left: 45px; top: 40px; }
    .char-purple .eye { width: 18px; height: 18px; }
    .char-purple .eye-pupil { width: 7px; height: 7px; }
    .char-purple .mouth {
      width: 36px; height: 12px; left: 52px; top: 62px;
      border: 3px solid #2D2D2D; border-top: none; border-radius: 0 0 18px 18px;
      background: transparent;
    }

    /* 蓝色中等 */
    .char-blue {
      left: 200px; width: 100px; height: 270px;
      background: #3b82f6; border-radius: 8px 8px 0 0; z-index: 2;
      opacity: 0;
      animation: blue-tumble-in 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s forwards;
    }
    .char-blue .char-eyes { gap: 20px; left: 22px; top: 28px; }
    .char-blue .eye { width: 16px; height: 16px; }
    .char-blue .eye-pupil { width: 6px; height: 6px; }
    .char-blue .mouth {
      width: 28px; height: 3px; left: 36px; top: 50px;
      background: #2D2D2D; border-radius: 2px;
    }

    /* 橙色半圆 */
    .char-orange {
      left: 0; width: 200px; height: 170px;
      background: #FF9B6B; border-radius: 100px 100px 0 0; z-index: 3;
      opacity: 0;
      animation: orange-bounce-in 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) 0.8s forwards;
    }
    .char-orange .char-eyes { gap: 28px; left: 68px; top: 75px; }
    .char-orange .pupil-only { width: 12px; height: 12px; }
    .char-orange .mouth {
      width: 14px; height: 14px; left: 93px; top: 105px;
      background: #2D2D2D; border-radius: 50%;
    }

    /* 黄色高半圆 */
    .char-yellow {
      left: 260px; width: 120px; height: 200px;
      background: #E8D754; border-radius: 60px 60px 0 0; z-index: 4;
      opacity: 0;
      animation: yellow-emerge 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s forwards;
    }
    .char-yellow .char-eyes { gap: 20px; left: 40px; top: 35px; }
    .char-yellow .pupil-only { width: 12px; height: 12px; }
    .char-yellow .mouth {
      width: 44px; height: 14px; left: 38px; top: 74px;
      border: 3px solid #2D2D2D; border-top: none; border-radius: 0 0 22px 22px;
      background: transparent;
    }

    /* ===== 入场动画 ===== */
    /* 紫色：变正方块从左边顺时针翻滚进来，落地恢复 */
    @keyframes purple-roll-in {
      0% {
        opacity: 0;
        transform: translateX(-500px) rotate(0deg);
      }
      40% {
        opacity: 1;
        transform: translateX(-60px) rotate(270deg);
      }
      70% {
        transform: translateX(10px) rotate(350deg);
      }
      85% {
        transform: translateX(-3px) rotate(358deg);
      }
      100% {
        opacity: 1;
        transform: translateX(0) rotate(360deg);
      }
    }
    /* 蓝色：从上面边缘翻跟头下来 */
    @keyframes blue-tumble-in {
      0% {
        opacity: 0;
        transform: translateY(-500px) scaleY(0.2);
      }
      30% {
        opacity: 1;
        transform: translateY(-80px) scaleY(0.8);
      }
      50% {
        transform: translateY(15px) scaleY(1.05);
      }
      70% {
        transform: translateY(-5px) scaleY(0.98);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scaleY(1);
      }
    }
    /* 橙色：小圆球从左侧一蹦一跳进来 */
    @keyframes orange-bounce-in {
      0% { opacity: 0; transform: translateX(-400px) translateY(0) scale(0.8); }
      12% { opacity: 1; transform: translateX(-320px) translateY(-50px) scale(0.85); }
      24% { transform: translateX(-250px) translateY(0) scale(0.9); }
      36% { transform: translateX(-180px) translateY(-40px) scale(0.92); }
      48% { transform: translateX(-120px) translateY(0) scale(0.95); }
      60% { transform: translateX(-70px) translateY(-30px) scale(0.97); }
      72% { transform: translateX(-35px) translateY(0) scale(0.99); }
      84% { transform: translateX(-10px) translateY(-12px) scale(1); }
      100% { opacity: 1; transform: translateX(0) translateY(0) scale(1); }
    }
    /* 黄色：从右侧地底探出脑袋再钻出来 */
    @keyframes yellow-emerge {
      0% {
        opacity: 0;
        transform: translateY(400px) scaleY(0.4);
      }
      25% {
        opacity: 1;
        transform: translateY(160px) scaleY(0.5);
      }
      45% {
        transform: translateY(60px) scaleY(0.7);
      }
      65% {
        transform: translateY(-15px) scaleY(1.06);
      }
      80% {
        transform: translateY(5px) scaleY(0.97);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scaleY(1);
      }
    }

    /* ===== 输入密码：互相看 ===== */
    .char-stage.typing-start .char-purple {
      transform: skewX(-12deg) translateX(40px) !important;
      height: 400px;
    }
    .char-stage.typing-start .char-blue {
      transform: skewX(10deg) translateX(20px) !important;
    }
    .char-stage.typing-start .char-purple .char-eyes { left: 55px; top: 65px; }
    .char-stage.typing-start .char-blue .char-eyes { left: 32px; top: 12px; }

    /* ===== 密码可见：转头不看 ===== */
    .char-stage.show-pwd .char-purple { transform: skewX(0deg) !important; height: 350px; }
    .char-stage.show-pwd .char-blue { transform: skewX(0deg) !important; }
    .char-stage.show-pwd .char-orange { transform: skewX(0deg) !important; }
    .char-stage.show-pwd .char-yellow { transform: skewX(0deg) !important; }
    .char-stage.show-pwd .char-purple .char-eyes { left: 20px; top: 35px; }
    .char-stage.show-pwd .char-blue .char-eyes { left: 10px; top: 28px; }
    .char-stage.show-pwd .char-orange .char-eyes { left: 50px; top: 85px; }
    .char-stage.show-pwd .char-yellow .char-eyes { left: 20px; top: 35px; }
    /* 眼睛强制看向左上 */
    .char-stage.show-pwd .eye-pupil,
    .char-stage.show-pwd .pupil-only {
      transform: translate(-4px, -4px) !important;
    }
    /* 紫色偷瞄动画 */
    .char-stage.show-pwd.peeking .char-purple .eye-pupil {
      transform: translate(4px, 5px) !important;
      transition: transform 0.3s ease;
    }
    /* 嘴巴也跟着动 */
    .char-stage.show-pwd .char-purple .mouth { left: 52px; top: 62px; }
    .char-stage.show-pwd .char-blue .mouth { left: 36px; top: 50px; }
    .char-stage.show-pwd .char-orange .mouth { left: 93px; top: 105px; }
    .char-stage.show-pwd .char-yellow .mouth { left: 38px; top: 74px; }

    /* ===== 隐藏密码：偷看键盘 ===== */
    .char-stage.hide-pwd .char-purple {
      transform: skewX(-12deg) translateX(40px) !important;
      height: 440px;
    }
    .char-stage.hide-pwd .char-blue {
      transform: skewX(10deg) translateX(20px) !important;
    }
    .char-stage.hide-pwd .char-purple .char-eyes { left: 55px; top: 65px; }
    .char-stage.hide-pwd .char-blue .char-eyes { left: 32px; top: 12px; }
    /* 眼睛看键盘方向 */
    .char-stage.hide-pwd .char-purple .eye-pupil { transform: translate(3px, 4px) !important; }
    .char-stage.hide-pwd .char-blue .eye-pupil { transform: translate(0px, -4px) !important; }
    .char-stage.hide-pwd .char-orange .pupil-only { transform: translate(-5px, -4px) !important; }
    .char-stage.hide-pwd .char-yellow .pupil-only { transform: translate(-5px, -4px) !important; }

    /* 右侧登录 */
    .login-right { display: flex; align-items: center; justify-content: center; padding: 24px; }
    .login-form-wrap { width: 100%; max-width: 340px; }
    .login-header { margin-bottom: 32px; text-align: center; }
    .login-header h1 { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 4px; }
    .login-header p { font-size: 13px; color: var(--text-3); }
    .login-error { font-size: 13px; color: var(--danger); margin-top: 12px; min-height: 20px; }
    .login-back { display: block; margin-top: 24px; font-size: 13px; color: var(--text-3); transition: color 0.15s; text-align: center; }
    .login-back:hover { color: var(--text); }
    .form-label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 6px; }
    .form-input {
      width: 100%; padding: 10px 12px; border: 1px solid var(--border);
      border-radius: var(--radius); font-size: 14px; background: var(--bg-elevated);
      color: var(--text); outline: none; transition: border-color 0.15s; font-family: inherit;
    }
    .form-input:focus { border-color: var(--text-3); }
    .form-input::placeholder { color: var(--text-3); }
    .input-group { display: flex; gap: 0; position: relative; }
    .input-group .form-input { flex: 1; padding-right: 40px; }
    .pwd-toggle {
      position: absolute; right: 1px; top: 1px; bottom: 1px; width: 38px;
      background: none; border: none; border-left: 1px solid var(--border);
      border-radius: 0 var(--radius) var(--radius) 0;
      cursor: pointer; color: var(--text-3); font-size: 14px;
      display: flex; align-items: center; justify-content: center;
      transition: color 0.15s;
    }
    .pwd-toggle:hover { color: var(--text); }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      padding: 10px 16px; border: 1px solid var(--border); border-radius: var(--radius);
      font-size: 14px; font-weight: 500; cursor: pointer; background: var(--bg-elevated);
      color: var(--text); font-family: inherit; transition: all 0.15s;
    }
    .btn:hover { border-color: var(--text-3); }
    .btn-primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); width: 100%; }
    .btn-primary:hover { opacity: 0.88; }
    .dark-fab {
      position: fixed; bottom: 16px; right: 16px;
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--bg-elevated); border: 1px solid var(--border);
      cursor: pointer; font-size: 16px; display: flex;
      align-items: center; justify-content: center; transition: all 0.15s;
    }
    .dark-fab:hover { border-color: var(--text-3); }
  </style>
</head>
<body>
  <div class="login-split" id="login-page">
    <div class="login-left">
      <canvas id="star-canvas"></canvas>
      <div id="meteor-container"></div>
      <div style="position:relative;z-index:3;padding:24px;"></div>
      <div class="characters">
        <div class="char-stage" id="stage">
          <div class="character char-purple" id="char-purple">
            <div class="char-eyes">
              <div class="eye"><div class="eye-pupil" data-char="purple"></div></div>
              <div class="eye"><div class="eye-pupil" data-char="purple"></div></div>
            </div>
            <div class="mouth"></div>
          </div>
          <div class="character char-blue" id="char-blue">
            <div class="char-eyes">
              <div class="eye"><div class="eye-pupil" data-char="blue"></div></div>
              <div class="eye"><div class="eye-pupil" data-char="blue"></div></div>
            </div>
            <div class="mouth"></div>
          </div>
          <div class="character char-orange" id="char-orange">
            <div class="char-eyes">
              <div class="pupil-only" data-char="orange"></div>
              <div class="pupil-only" data-char="orange"></div>
            </div>
            <div class="mouth"></div>
          </div>
          <div class="character char-yellow" id="char-yellow">
            <div class="char-eyes">
              <div class="pupil-only" data-char="yellow"></div>
              <div class="pupil-only" data-char="yellow"></div>
            </div>
            <div class="mouth"></div>
          </div>
        </div>
      </div>
      <div class="left-footer">
        <a href="/" data-no-swup>首页</a>
        <a href="/moments/" data-no-swup>说说</a>
        <a href="/life/notebooks/" data-no-swup>笔记</a>
      </div>
    </div>
    <div class="login-right">
      <div class="login-form-wrap">
        <div class="login-header">
          <h1>Welcome back！</h1>
          <p>输入密码以进入团子的后台</p>
        </div>
        <div style="margin-bottom:16px;">
          <label class="form-label">用户名</label>
          <input type="text" class="form-input" id="login-user" value="dumplingandecake" autocomplete="off" />
        </div>
        <div style="margin-bottom:16px;">
          <label class="form-label">密码</label>
          <div class="input-group">
            <input type="password" class="form-input" id="login-pwd" placeholder="••••••••" autocomplete="off" />
            <button class="pwd-toggle" onclick="togglePwd()" type="button" title="显示/隐藏密码" id="pwd-toggle-btn">👁</button>
          </div>
        </div>
        <button class="btn btn-primary" onclick="doLogin()">进入后台</button>
        <div class="login-error" id="login-error"></div>
        <a href="/" class="login-back" data-no-swup>← 返回首页</a>
      </div>
    </div>
  </div>

  <script is:inline data-hash={import.meta.env.PUBLIC_ADMIN_PASSWORD_HASH || ""}>
    var _passwordHash = document.currentScript.getAttribute("data-hash") || "";
    var stage = $("stage");
    var pwdInput = $("login-pwd");
    var showPwd = false;
    var typingStartTimer = null;
    var peekTimer = null;

    function $(id) { return document.getElementById(id); }
    function toggleDark() {
      document.documentElement.classList.toggle("dark");
      localStorage.setItem("admin_theme", document.documentElement.classList.contains("dark") ? "dark" : "light");
    }
    if (localStorage.getItem("admin_theme") === "dark" ||
        (!localStorage.getItem("admin_theme") && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
      document.documentElement.classList.add("dark");
    }
    if (sessionStorage.getItem("admin_auth") === "1") { window.location.href = "/admin/dashboard/"; }

    // 表情状态管理
    function clearStageClasses() {
      stage.classList.remove("typing-start", "show-pwd", "hide-pwd", "peeking");
    }

    // 清除 JS 设置的 inline 样式，让 CSS class 生效
    function clearInlineStyles() {
      ["purple", "blue", "orange", "yellow"].forEach(function(c) {
        var el = document.getElementById("char-" + c);
        if (el) el.style.transform = "";
        var eyes = document.querySelector("#char-" + c + " .char-eyes");
        if (eyes) { eyes.style.left = ""; eyes.style.top = ""; }
        var mouth = document.querySelector("#char-" + c + " .mouth");
        if (mouth) { mouth.style.left = ""; mouth.style.top = ""; }
      });
      document.querySelectorAll("[data-char]").forEach(function(p) {
        p.style.transform = "";
      });
    }

    function updateCharState() {
      clearStageClasses();
      clearInlineStyles();
      clearTimeout(peekTimer);

      if (showPwd && pwdInput.value.length > 0) {
        // 密码可见：转头不看，紫色偶尔偷瞄
        stage.classList.add("show-pwd");
        schedulePeek();
      } else if (!showPwd && pwdInput.value.length > 0) {
        // 隐藏密码：偷看键盘
        stage.classList.add("hide-pwd");
      }
      // 无密码输入时：默认状态，跟随鼠标
    }

    function schedulePeek() {
      if (!showPwd || pwdInput.value.length === 0) return;
      peekTimer = setTimeout(function() {
        stage.classList.add("peeking");
        setTimeout(function() {
          stage.classList.remove("peeking");
          schedulePeek();
        }, 800);
      }, 2000 + Math.random() * 3000);
    }

    // 密码显示/隐藏
    function togglePwd() {
      showPwd = !showPwd;
      pwdInput.type = showPwd ? "text" : "password";
      $("pwd-toggle-btn").textContent = showPwd ? "🙈" : "👁";
      updateCharState();
    }

    // 输入时触发 typing-start（互相看）然后进入对应状态
    pwdInput.addEventListener("input", function() {
      if (pwdInput.value.length === 1) {
        // 刚开始输入，触发互相看动画
        stage.classList.add("typing-start");
        clearTimeout(typingStartTimer);
        typingStartTimer = setTimeout(function() {
          stage.classList.remove("typing-start");
          updateCharState();
        }, 800);
      } else {
        updateCharState();
      }
    });

    async function sha256(str) {
      var buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(str));
      return Array.from(new Uint8Array(buf)).map(function(b){return b.toString(16).padStart(2,"0");}).join("");
    }

    async function doLogin() {
      var input = pwdInput.value;
      if (!input) { $("login-error").textContent = "请输入密码"; return; }
      var expectedHash = _passwordHash;
      if (!expectedHash) { $("login-error").textContent = "未配置密码"; return; }
      clearStageClasses();
      var btn = document.querySelector(".btn-primary");
      btn.disabled = true;
      btn.textContent = "登录中...";
      try {
        var hash = await sha256(input);
        if (hash === expectedHash) {
          $("login-error").textContent = "";
          sessionStorage.setItem("admin_auth", "1");
          window.location.href = "/admin/dashboard/";
        } else {
          $("login-error").textContent = "密码错误";
          pwdInput.value = "";
          pwdInput.focus();
        }
      } catch(e) {
        $("login-error").textContent = "错误: " + e.message;
      } finally {
        btn.disabled = false;
        btn.textContent = "进入后台";
      }
    }
    pwdInput.addEventListener("keydown", function(e) { if (e.key === "Enter") { e.preventDefault(); doLogin(); } });

    // 星空
    (function() {
      var canvas = $("star-canvas");
      if (!canvas) return;
      var ctx = canvas.getContext("2d");
      var stars = [];
      function resize() {
        var parent = canvas.parentElement;
        canvas.width = parent.offsetWidth;
        canvas.height = parent.offsetHeight;
      }
      resize();
      window.addEventListener("resize", resize);
      for (var i = 0; i < 120; i++) {
        stars.push({
          x: Math.random() * canvas.width, y: Math.random() * canvas.height,
          r: Math.random() * 1.5 + 0.5, alpha: Math.random(),
          speed: Math.random() * 0.02 + 0.005, dir: Math.random() > 0.5 ? 1 : -1
        });
      }
      function drawStars() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        stars.forEach(function(s) {
          s.alpha += s.speed * s.dir;
          if (s.alpha >= 1) { s.alpha = 1; s.dir = -1; }
          if (s.alpha <= 0.2) { s.alpha = 0.2; s.dir = 1; }
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          ctx.fillStyle = "rgba(255,255,255," + s.alpha + ")";
          ctx.fill();
        });
        requestAnimationFrame(drawStars);
      }
      drawStars();
    })();

    // 流星
    (function() {
      var container = $("meteor-container");
      if (!container) return;
      function createMeteor() {
        var m = document.createElement("div");
        m.className = "meteor";
        m.style.left = (Math.random() * 60 + 20) + "%";
        m.style.top = (Math.random() * 30) + "%";
        m.style.transform = "rotate(215deg)";
        container.appendChild(m);
        var duration = 600 + Math.random() * 400;
        m.animate([
          { opacity: 0, transform: "rotate(215deg) translateX(0)" },
          { opacity: 1, offset: 0.1 },
          { opacity: 1, offset: 0.6 },
          { opacity: 0, transform: "rotate(215deg) translateX(300px)" }
        ], { duration: duration, easing: "linear" });
        setTimeout(function() { m.remove(); }, duration);
      }
      function scheduleMeteor() {
        setTimeout(function() { createMeteor(); scheduleMeteor(); }, 2000 + Math.random() * 5000);
      }
      scheduleMeteor();
    })();

    // 角色动画（3D 跟随 + 眨眼）
    (function() {
      var mouseX = 0, mouseY = 0;
      document.addEventListener("mousemove", function(e) { mouseX = e.clientX; mouseY = e.clientY; });

      // 眨眼
      function scheduleBlink(id) {
        setTimeout(function() {
          var eyes = document.querySelectorAll("#char-" + id + " .eye");
          eyes.forEach(function(el) { el.style.height = "2px"; });
          setTimeout(function() { eyes.forEach(function(el) { el.style.height = ""; }); scheduleBlink(id); }, 150);
        }, 3000 + Math.random() * 4000);
      }
      scheduleBlink("purple"); scheduleBlink("blue");

      function getPupilPos(el, max) {
        var r = el.getBoundingClientRect();
        var cx = r.left + r.width/2, cy = r.top + r.height/2;
        var dx = mouseX - cx, dy = mouseY - cy;
        var dist = Math.min(Math.sqrt(dx*dx + dy*dy), max);
        var a = Math.atan2(dy, dx);
        return { x: Math.cos(a) * dist, y: Math.sin(a) * dist };
      }

      // 嘴巴基准位置
      var mouthBase = {
        purple: { left: 52, top: 62 },
        blue: { left: 36, top: 50 },
        orange: { left: 93, top: 105 },
        yellow: { left: 38, top: 74 }
      };
      var mouths = {
        purple: document.querySelector("#char-purple .mouth"),
        blue: document.querySelector("#char-blue .mouth"),
        orange: document.querySelector("#char-orange .mouth"),
        yellow: document.querySelector("#char-yellow .mouth")
      };
      var eyeContainers = {
        purple: document.querySelector("#char-purple .char-eyes"),
        blue: document.querySelector("#char-blue .char-eyes"),
        orange: document.querySelector("#char-orange .char-eyes"),
        yellow: document.querySelector("#char-yellow .char-eyes")
      };
      var eyeBase = {
        purple: { left: 45, top: 40 },
        blue: { left: 22, top: 28 },
        orange: { left: 68, top: 75 },
        yellow: { left: 40, top: 35 }
      };

      function animate() {
        // 只在默认状态（无特殊 class）时做 3D 跟随
        var isSpecial = stage.classList.contains("typing-start") ||
                        stage.classList.contains("show-pwd") ||
                        stage.classList.contains("hide-pwd");

        if (!isSpecial) {
          var sr = stage.getBoundingClientRect();
          var dx = mouseX - (sr.left + sr.width/2);
          var dy = mouseY - (sr.top + sr.height / 3);
          var faceX = Math.max(-15, Math.min(15, dx / 20));
          var faceY = Math.max(-10, Math.min(10, dy / 30));
          var bodySkew = Math.max(-6, Math.min(6, -dx / 120));

          // 眼睛跟随
          document.querySelectorAll("[data-char]").forEach(function(p) {
            var c = p.getAttribute("data-char"), max = c === "purple" ? 5 : 4;
            var parent = p.classList.contains("eye-pupil") ? p.parentElement : p;
            var pos = getPupilPos(parent, max);
            p.style.transform = "translate(" + pos.x + "px," + pos.y + "px)";
          });

          // 身体倾斜
          var chars = ["purple", "blue", "orange", "yellow"];
          var skewAdds = [0, 0, 0, 0];
          chars.forEach(function(c, i) {
            $("char-" + c).style.transform = "skewX(" + (bodySkew + skewAdds[i]) + "deg)";
          });

          // 眼睛容器跟随
          ["purple", "blue", "orange", "yellow"].forEach(function(c) {
            var el = eyeContainers[c];
            if (el && eyeBase[c]) {
              el.style.left = (eyeBase[c].left + faceX) + "px";
              el.style.top = (eyeBase[c].top + faceY) + "px";
            }
          });

          // 嘴巴跟随
          ["purple", "blue", "orange", "yellow"].forEach(function(c) {
            var el = mouths[c];
            if (el && mouthBase[c]) {
              el.style.left = (mouthBase[c].left + faceX) + "px";
              el.style.top = (mouthBase[c].top + faceY) + "px";
            }
          });
        }

        requestAnimationFrame(animate);
      }
      requestAnimationFrame(animate);
    })();
  </script>
</body>
</html>
