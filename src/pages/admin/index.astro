---
// 后台管理入口 - 纯登录页
import { externalMomentsConfig } from "@/config/externalMomentsConfig";
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>登录 · 后台管理</title>
  <style is:inline>
    :root {
      --bg: #fafafa; --bg-elevated: #fff; --border: #e8e8ec;
      --text: #171717; --text-2: #525252; --text-3: #a0a0a0;
      --accent: #171717; --accent-text: #fff;
      --hover: #f4f4f6; --danger: #dc2626; --radius: 8px;
      --sidebar-accent: #7c5cfc;
    }
    :root.dark {
      --bg: #0a0a0a; --bg-elevated: #141414; --border: #222;
      --text: #ededed; --text-2: #a0a0a0; --text-3: #555;
      --accent: #ededed; --accent-text: #0a0a0a;
      --hover: #1a1a1a;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: "AaZongYiYuan", "MiSans", system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans SC", sans-serif;
      background: var(--bg); color: var(--text); min-height: 100vh;
      -webkit-font-smoothing: antialiased; font-size: 14px; line-height: 1.5;
    }
    a { color: inherit; text-decoration: none; }

    .login-split {
      display: grid; grid-template-columns: 1fr; min-height: 100vh;
    }
    @media (min-width: 992px) {
      .login-split { grid-template-columns: 1fr 1fr; }
    }

    /* 左侧动画 */
    .login-left {
      display: none; position: relative; overflow: hidden;
      background: linear-gradient(135deg, #0f0f14 0%, #1a1a2e 50%, #16213e 100%);
    }
    @media (min-width: 992px) {
      .login-left { display: flex; flex-direction: column; justify-content: space-between; }
    }
    .login-left::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(circle at 60% 40%, rgba(124,92,252,0.15) 0%, transparent 60%);
    }
    .left-brand {
      position: relative; z-index: 2; padding: 24px;
      display: flex; align-items: center; gap: 10px;
      color: rgba(255,255,255,0.9); font-size: 15px; font-weight: 600;
    }
    .left-brand .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--sidebar-accent);
      box-shadow: 0 0 10px rgba(124,92,252,0.5);
    }
    .left-footer {
      position: relative; z-index: 2; padding: 24px;
      display: flex; gap: 24px; font-size: 13px;
      color: rgba(255,255,255,0.35);
    }
    .left-footer a { color: rgba(255,255,255,0.35); transition: color 0.2s; }
    .left-footer a:hover { color: rgba(255,255,255,0.7); }

    /* 角色 */
    .characters {
      position: relative; z-index: 2;
      display: flex; align-items: flex-end; justify-content: center;
      height: 420px; padding: 0 24px;
    }
    .char-stage { position: relative; width: 450px; height: 400px; }
    .character {
      position: absolute; bottom: 0; transform-origin: bottom center;
      transition: transform 0.7s cubic-bezier(0.4,0,0.2,1);
    }
    .char-eyes { position: absolute; display: flex; gap: 0; transition: left 0.7s ease, top 0.7s ease; }
    .eye {
      border-radius: 50%; background: #fff;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden; transition: height 0.15s ease; position: relative;
    }
    .eye-pupil { border-radius: 50%; background: #2D2D2D; transition: transform 0.1s ease-out; position: absolute; }
    .pupil-only { border-radius: 50%; background: #2D2D2D; transition: transform 0.1s ease-out; }
    .char-purple { left: 70px; width: 140px; height: 350px; background: #1a1a2e; border-radius: 6px 6px 0 0; z-index: 1; }
    .char-purple .char-eyes { gap: 28px; left: 38px; top: 40px; }
    .char-purple .eye { width: 18px; height: 18px; }
    .char-purple .eye-pupil { width: 7px; height: 7px; }
    .char-black { left: 200px; width: 100px; height: 270px; background: #0f0f14; border-radius: 6px 6px 0 0; z-index: 2; }
    .char-black .char-eyes { gap: 20px; left: 22px; top: 28px; }
    .char-black .eye { width: 16px; height: 16px; }
    .char-black .eye-pupil { width: 6px; height: 6px; }
    .char-orange { left: 0; width: 200px; height: 170px; background: #2a2a3e; border-radius: 100px 100px 0 0; z-index: 3; }
    .char-orange .char-eyes { gap: 28px; left: 68px; top: 75px; }
    .char-orange .pupil-only { width: 12px; height: 12px; }
    .char-yellow { left: 260px; width: 120px; height: 200px; background: #3a3a50; border-radius: 60px 60px 0 0; z-index: 4; }
    .char-yellow .char-eyes { gap: 20px; left: 40px; top: 35px; }
    .char-yellow .pupil-only { width: 12px; height: 12px; }
    .char-yellow .mouth { position: absolute; width: 50px; height: 3px; background: #2D2D2D; border-radius: 2px; left: 35px; top: 80px; }

    /* 右侧登录 */
    .login-right { display: flex; align-items: center; justify-content: center; padding: 24px; }
    .login-form-wrap { width: 100%; max-width: 340px; }
    .login-header { margin-bottom: 32px; }
    .login-header h1 { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 4px; }
    .login-header p { font-size: 13px; color: var(--text-3); }
    .login-error { font-size: 13px; color: var(--danger); margin-top: 12px; min-height: 20px; }
    .login-back { display: block; margin-top: 24px; font-size: 13px; color: var(--text-3); transition: color 0.15s; text-align: center; }
    .login-back:hover { color: var(--text); }
    .form-label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 6px; }
    .form-input {
      width: 100%; padding: 10px 12px; border: 1px solid var(--border);
      border-radius: var(--radius); font-size: 14px; background: var(--bg-elevated);
      color: var(--text); outline: none; transition: border-color 0.15s; font-family: inherit;
    }
    .form-input:focus { border-color: var(--text-3); }
    .form-input::placeholder { color: var(--text-3); }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      padding: 10px 16px; border: 1px solid var(--border); border-radius: var(--radius);
      font-size: 14px; font-weight: 500; cursor: pointer; background: var(--bg-elevated);
      color: var(--text); font-family: inherit; transition: all 0.15s;
    }
    .btn:hover { border-color: var(--text-3); }
    .btn-primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); width: 100%; }
    .btn-primary:hover { opacity: 0.88; }
    .dark-fab {
      position: fixed; bottom: 16px; right: 16px;
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--bg-elevated); border: 1px solid var(--border);
      cursor: pointer; font-size: 16px; display: flex;
      align-items: center; justify-content: center; transition: all 0.15s;
    }
    .dark-fab:hover { border-color: var(--text-3); }
  </style>
</head>
<body>
  <div class="login-split" id="login-page">
    <div class="login-left">
      <div class="left-brand">
        <span class="dot"></span>
        <span>后台管理</span>
      </div>
      <div class="characters">
        <div class="char-stage" id="stage">
          <div class="character char-purple" id="char-purple">
            <div class="char-eyes">
              <div class="eye"><div class="eye-pupil" data-char="purple"></div></div>
              <div class="eye"><div class="eye-pupil" data-char="purple"></div></div>
            </div>
          </div>
          <div class="character char-black" id="char-black">
            <div class="char-eyes">
              <div class="eye"><div class="eye-pupil" data-char="black"></div></div>
              <div class="eye"><div class="eye-pupil" data-char="black"></div></div>
            </div>
          </div>
          <div class="character char-orange" id="char-orange">
            <div class="char-eyes">
              <div class="pupil-only" data-char="orange"></div>
              <div class="pupil-only" data-char="orange"></div>
            </div>
          </div>
          <div class="character char-yellow" id="char-yellow">
            <div class="char-eyes">
              <div class="pupil-only" data-char="yellow"></div>
              <div class="pupil-only" data-char="yellow"></div>
            </div>
            <div class="mouth" id="yellow-mouth"></div>
          </div>
        </div>
      </div>
      <div class="left-footer">
        <a href="/" data-no-swup>首页</a>
        <a href="/moments/" data-no-swup>说说</a>
        <a href="/life/notebooks/" data-no-swup>笔记</a>
      </div>
    </div>
    <div class="login-right">
      <div class="login-form-wrap">
        <div class="login-header">
          <h1>Welcome back</h1>
          <p>输入密码以进入后台</p>
        </div>
        <div style="margin-bottom:16px;">
          <label class="form-label">密码</label>
          <input type="password" class="form-input" id="login-pwd" placeholder="••••••••" autocomplete="off" />
        </div>
        <button class="btn btn-primary" onclick="doLogin()">进入后台</button>
        <div class="login-error" id="login-error"></div>
        <a href="/" class="login-back" data-no-swup>← 返回首页</a>
      </div>
    </div>
  </div>
  <button class="dark-fab" onclick="toggleDark()" title="切换暗色">◐</button>

  <script is:inline data-hash={externalMomentsConfig.adminPasswordHash || ""}>
    var passwordHash = document.currentScript.getAttribute("data-hash") || "";
    function $(id) { return document.getElementById(id); }
    async function sha256(str) {
      var buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(str));
      return Array.from(new Uint8Array(buf)).map(function(b) { return b.toString(16).padStart(2, "0"); }).join("");
    }
    function toggleDark() {
      document.documentElement.classList.toggle("dark");
      localStorage.setItem("admin_theme", document.documentElement.classList.contains("dark") ? "dark" : "light");
    }
    if (localStorage.getItem("admin_theme") === "dark" ||
        (!localStorage.getItem("admin_theme") && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
      document.documentElement.classList.add("dark");
    }
    if (sessionStorage.getItem("admin_auth") === "1") { window.location.href = "/admin/dashboard/"; }

    async function doLogin() {
      var input = $("login-pwd").value;
      if (!input) { $("login-error").textContent = "请输入密码"; return; }
      if (!passwordHash) { $("login-error").textContent = "未配置密码哈希"; return; }
      var hash = await sha256(input);
      if (hash === passwordHash) {
        sessionStorage.setItem("admin_auth", "1");
        window.location.href = "/admin/dashboard/";
      } else {
        $("login-error").textContent = "密码错误";
        $("login-pwd").value = "";
        $("login-pwd").focus();
      }
    }
    $("login-pwd").addEventListener("keydown", function(e) { if (e.key === "Enter") { e.preventDefault(); doLogin(); } });
    $("login-pwd").focus();

    // 角色动画
    (function() {
      var mouseX = 0, mouseY = 0, isTyping = false, typingTimer = null;
      document.addEventListener("mousemove", function(e) { mouseX = e.clientX; mouseY = e.clientY; });
      $("login-pwd").addEventListener("input", function() {
        isTyping = true; clearTimeout(typingTimer);
        typingTimer = setTimeout(function() { isTyping = false; }, 1500);
      });
      function scheduleBlink(id) {
        setTimeout(function() {
          var eyes = document.querySelectorAll("#char-" + id + " .eye");
          eyes.forEach(function(el) { el.style.height = "2px"; });
          setTimeout(function() { eyes.forEach(function(el) { el.style.height = ""; }); scheduleBlink(id); }, 150);
        }, 3000 + Math.random() * 4000);
      }
      scheduleBlink("purple"); scheduleBlink("black");
      function getPupilPos(el, max) {
        var r = el.getBoundingClientRect();
        var cx = r.left + r.width/2, cy = r.top + r.height/2;
        var dx = mouseX - cx, dy = mouseY - cy;
        var dist = Math.min(Math.sqrt(dx*dx + dy*dy), max);
        var a = Math.atan2(dy, dx);
        return { x: Math.cos(a) * dist, y: Math.sin(a) * dist };
      }
      function animate() {
        document.querySelectorAll("[data-char]").forEach(function(p) {
          var c = p.getAttribute("data-char"), max = c === "purple" ? 5 : 4;
          var parent = p.classList.contains("eye-pupil") ? p.parentElement : p;
          var pos = getPupilPos(parent, max);
          p.style.transform = "translate(" + pos.x + "px," + pos.y + "px)";
        });
        var sr = $("stage").getBoundingClientRect();
        var dx = mouseX - (sr.left + sr.width/2);
        var skew = Math.max(-6, Math.min(6, dx / 120));
        $("char-purple").style.transform = "skewX(" + (skew-2) + "deg)";
        $("char-black").style.transform = "skewX(" + (skew*1.2) + "deg)";
        $("char-orange").style.transform = "skewX(" + (skew*0.5) + "deg)";
        $("char-yellow").style.transform = "skewX(" + (skew*0.8) + "deg)";
        if (isTyping) {
          $("char-purple").style.transform = "skewX(-12deg) translateX(30px)";
          $("char-black").style.transform = "skewX(10deg) translateX(15px)";
        }
        requestAnimationFrame(animate);
      }
      requestAnimationFrame(animate);
    })();
  </script>
</body>
</html>
