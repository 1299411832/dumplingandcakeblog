---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="写文章" activeItem="posts">
  <style is:inline>
    .admin-content { max-width:none; padding:0; overflow:hidden; }
    .admin-main { overflow:hidden !important; }
    .editor-wrap { display:flex; flex-direction:column; height:calc(100vh - 52px); background:var(--bg-elevated); }
    .editor-top { display:flex; align-items:center; padding:6px 16px; border-bottom:1px solid var(--border); gap:8px; background:var(--bg-elevated); flex-shrink:0; }
    .editor-top a { color:var(--text-2); font-size:12px; text-decoration:none; }
    .editor-top-title { flex:1; text-align:center; color:var(--text-3); font-size:12px; }
    .editor-body { flex:1; display:flex; min-height:0; }
    .editor-main { flex:1; min-width:0; display:flex; flex-direction:column; overflow:hidden; }

    /* 工具栏 */
    .editor-toolbar {
      display:flex; gap:0; padding:4px 12px; border-bottom:1px solid var(--border);
      background:var(--bg-elevated); flex-wrap:wrap; align-items:center; flex-shrink:0;
    }
    .tb-btn {
      width:32px; height:30px; border:none; border-radius:4px; cursor:pointer;
      background:transparent; color:var(--text-2); font-size:14px;
      display:flex; align-items:center; justify-content:center; font-family:inherit;
      transition:all 0.1s; position:relative;
    }
    .tb-btn:hover { background:var(--hover); color:var(--text); }
    .tb-btn.active { background:var(--hover); color:var(--sidebar-accent); }
    .tb-sep { width:1px; height:20px; background:var(--border); margin:0 4px; flex-shrink:0; }
    .tb-select {
      padding:4px 6px; border:1px solid var(--border); border-radius:4px; font-size:12px;
      background:var(--bg-elevated); color:var(--text); cursor:pointer; font-family:inherit;
      height:30px; outline:none;
    }

    /* 编辑区 */
    .editor-content { flex:1; overflow-y:auto; padding:16px 24px 60px; }
    .editor-content:focus { outline:none; }
    .editor-title {
      width:100%; padding:4px 0 8px; border:none; background:transparent;
      font-size:28px; font-weight:700; color:var(--text); outline:none; font-family:inherit;
    }
    .editor-title::placeholder { color:#c4c4c4; }
    .editor-body-text {
      min-height:400px; font-size:16px; line-height:1.9; color:var(--text);
    }
    .editor-body-text:empty::before {
      content:"开始写作..."; color:#c4c4c4; pointer-events:none;
    }
    .editor-body-text:focus { outline:none; }

    /* 内容区排版 */
    .editor-body-text h1 { font-size:1.8em; font-weight:700; margin:0.8em 0 0.4em; line-height:1.3; }
    .editor-body-text h2 { font-size:1.5em; font-weight:600; margin:0.7em 0 0.3em; line-height:1.3; }
    .editor-body-text h3 { font-size:1.25em; font-weight:600; margin:0.6em 0 0.2em; line-height:1.4; }
    .editor-body-text h4 { font-size:1.1em; font-weight:600; margin:0.5em 0 0.2em; }
    .editor-body-text p { margin:0 0 0.8em; }
    .editor-body-text strong { font-weight:600; }
    .editor-body-text em { font-style:italic; }
    .editor-body-text s { text-decoration:line-through; }
    .editor-body-text blockquote {
      border-left:4px solid var(--sidebar-accent); padding:0.4em 1em; margin:0.8em 0;
      color:var(--text-2); background:var(--hover); border-radius:0 4px 4px 0;
    }
    .editor-body-text pre { background:var(--hover); padding:1em; margin:0.8em 0; overflow-x:auto; border-radius:6px; }
    .editor-body-text pre code { font-family:'JetBrains Mono',monospace; font-size:0.9em; background:none; padding:0; }
    .editor-body-text code { font-family:'JetBrains Mono',monospace; background:var(--hover); padding:0.15em 0.4em; font-size:0.9em; border-radius:3px; }
    .editor-body-text ul, .editor-body-text ol { margin:0.5em 0; padding-left:1.5em; }
    .editor-body-text li { margin-bottom:0.2em; line-height:1.8; }
    .editor-body-text a { color:var(--sidebar-accent); text-decoration:underline; }
    .editor-body-text img { max-width:100%; border-radius:6px; margin:0; display:block; }
    /* 图片缩放包装器 */
    .img-resize-wrap {
      display:inline-block; position:relative; max-width:100%; margin:0.5em 0;
      resize:horizontal; overflow:hidden; vertical-align:top;
    }
    .img-resize-wrap img { width:100%; height:auto; display:block; pointer-events:none; }
    .img-resize-wrap::after {
      content:''; position:absolute; right:0; bottom:0; width:10px; height:10px;
      cursor:ew-resize; background:linear-gradient(135deg, transparent 50%, var(--sidebar-accent) 50%);
      opacity:0; transition:opacity 0.15s;
    }
    .img-resize-wrap:hover::after { opacity:0.8; }
    .editor-body-text table { border-collapse:collapse; width:100%; margin:0.8em 0; }
    .editor-body-text th, .editor-body-text td { border:1px solid var(--border); padding:6px 12px; text-align:left; }
    .editor-body-text th { background:var(--hover); font-weight:600; }
    .editor-body-text hr { border:none; border-top:2px dashed var(--border); margin:1.2em 0; }
    .editor-body-text input[type=checkbox] { width:16px; height:16px; accent-color:var(--sidebar-accent); margin-right:6px; }

    /* 侧边栏 */
    .editor-sidebar {
      width:280px; flex-shrink:0; border-left:1px solid var(--border);
      background:var(--bg); overflow-y:auto; display:flex; flex-direction:column;
    }
    @media (max-width:900px) { .editor-sidebar { display:none; } }

    .editor-panel { border-bottom:1px solid var(--border); background:var(--bg-elevated); }
    .editor-panel-title {
      padding:8px 12px; cursor:pointer; user-select:none; border-bottom:1px solid var(--border);
      font-size:11px; font-weight:600; color:var(--text-2); text-transform:uppercase; letter-spacing:0.04em;
      display:flex; align-items:center; gap:6px;
    }
    .editor-panel-title:hover { background:var(--hover); }
    .editor-panel-title.folded { border-bottom:none; }
    .editor-panel-title.folded + .editor-panel-body { display:none; }
    .editor-panel-arrow { font-size:10px; color:var(--text-3); transition:transform 0.15s; }
    .editor-panel-title.folded .editor-panel-arrow { transform:rotate(-90deg); }
    .editor-panel-body { padding:12px; }

    .pub-btn {
      padding:6px 16px; border:none; border-radius:4px; cursor:pointer;
      background:var(--sidebar-accent); color:#fff; font-size:13px; font-weight:500;
      font-family:inherit; width:100%; text-align:center;
    }
    .pub-btn:hover { opacity:0.88; }
    .pub-btn:disabled { opacity:0.45; }
    .pub-status { padding:8px 0; border-top:1px solid var(--border); border-bottom:1px solid var(--border); margin:8px 0; }
    .pub-row { display:flex; align-items:center; gap:6px; padding:2px 0; font-size:13px; }
    .pub-icon { font-size:14px; flex-shrink:0; opacity:0.5; }
    .pub-label { color:var(--text-2); font-size:12px; flex-shrink:0; }
    .pub-link { font-size:11px; color:var(--sidebar-accent); text-decoration:underline; cursor:pointer; margin-left:auto; }

    .inp {
      padding:6px 10px; border:1px solid var(--border); border-radius:4px; font-size:13px;
      background:var(--bg-elevated); color:var(--text); outline:none; font-family:inherit;
    }
    .inp:focus { border-color:var(--sidebar-accent); }

    .toast-wrap { position:fixed; top:12px; right:12px; z-index:9999; }
    .toast-m { padding:8px 16px; border-radius:var(--radius); font-size:13px; font-weight:500; opacity:0; transform:translateY(-8px); transition:all 0.2s; pointer-events:none; border:1px solid; background:var(--bg-elevated); }
    .toast-m.show { opacity:1; transform:translateY(0); }
    .toast-m.ok { color:var(--success); border-color:var(--success); }
    .toast-m.err { color:var(--danger); border-color:var(--danger); }
  </style>

  <div class="editor-wrap">
    <div class="editor-top">
      <a href="/admin/posts/" data-no-swup>&larr; 文章列表</a>
      <span class="editor-top-title" id="topbar-title">新建文章</span>
    </div>

    <div class="editor-body">
      <div class="editor-main">
        <!-- 工具栏 -->
        <div class="editor-toolbar" id="toolbar">
          <select class="tb-select" id="tb-heading" onchange="formatBlock(this.value)" title="标题">
            <option value="">正文</option>
            <option value="h2">H2 二级标题</option>
            <option value="h3">H3 三级标题</option>
            <option value="h4">H4 四级标题</option>
          </select><span class="tb-sep"></span>
          <button class="tb-btn" id="tb-bold" onclick="execCmd('bold')" title="加粗 Ctrl+B"><b>B</b></button>
          <button class="tb-btn" id="tb-italic" onclick="execCmd('italic')" title="斜体 Ctrl+I"><i>I</i></button>
          <button class="tb-btn" id="tb-strike" onclick="execCmd('strikeThrough')" title="删除线"><s>S</s></button>
          <button class="tb-btn" id="tb-underline" onclick="execCmd('underline')" title="下划线"><u>U</u></button>
          <span class="tb-sep"></span>
          <button class="tb-btn" id="tb-code" onclick="insertCode()" title="行内代码">&lt;/&gt;</button>
          <button class="tb-btn" id="tb-codeblock" onclick="insertCodeBlock()" title="代码块" style="font-size:16px;">{ }</button>
          <span class="tb-sep"></span>
          <button class="tb-btn" id="tb-link" onclick="insertLink()" title="插入链接">🔗</button>
          <button class="tb-btn" id="tb-image" onclick="insertImage()" title="插入图片">🖼</button>
          <span class="tb-sep"></span>
          <button class="tb-btn" id="tb-quote" onclick="insertBlockquote()" title="引用">❝</button>
          <button class="tb-btn" id="tb-ul" onclick="insertList()" title="无序列表">•</button>
          <button class="tb-btn" id="tb-ol" onclick="insertOrderedList()" title="有序列表">1.</button>
          <button class="tb-btn" id="tb-hr" onclick="insertHR()" title="分割线">—</button>
          <span class="tb-sep"></span>
          <button class="tb-btn" id="tb-table" onclick="insertTable()" title="插入表格">⊞</button>
          <button class="tb-btn" id="tb-undo" onclick="execCmd('undo')" title="撤销">↶</button>
          <button class="tb-btn" id="tb-redo" onclick="execCmd('redo')" title="重做">↷</button>
        </div>

        <!-- 编辑区 -->
        <div class="editor-content" id="editor-content">
          <input type="text" class="editor-title" id="field-title" placeholder="输入文章标题..." />
          <div class="editor-body-text" id="field-body" contenteditable="true"></div>
        </div>
      </div>

      <!-- 侧边栏 -->
      <div class="editor-sidebar">
        <div class="editor-panel">
          <div class="editor-panel-body">
            <button class="pub-btn" id="btn-publish" onclick="submitPost()">发布</button>
          </div>
        </div>

        <div class="editor-panel">
          <div class="editor-panel-title" onclick="this.classList.toggle('folded')">
            <span class="editor-panel-arrow">&#9660;</span> 发布设置
          </div>
          <div class="editor-panel-body">
            <div class="pub-status" style="border-top:none;margin:0;padding-top:0;">
              <div class="pub-row">
                <span class="pub-icon">&#128203;</span>
                <span class="pub-label">状态</span>
                <span id="pub-status" style="font-size:13px;cursor:pointer;" onclick="toggleDraft()">草稿</span>
                <input type="hidden" id="field-draft" value="0" />
              </div>
              <div class="pub-row">
                <span class="pub-icon">&#128197;</span>
                <span class="pub-label">发布时间</span>
                <span id="pub-date-display" style="font-size:13px;">立即发布</span>
                <span class="pub-link" onclick="toggleDateEdit()">编辑</span>
              </div>
              <div id="date-edit-row" style="display:none;margin-top:4px;">
                <input type="date" id="field-date" class="inp" style="font-size:12px;width:100%;" onchange="document.getElementById('pub-date-display').textContent=this.value||'立即发布'" />
              </div>
            </div>
            <div style="margin-top:8px;">
              <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;"><input type="checkbox" id="field-pinned" style="width:16px;height:16px;accent-color:var(--sidebar-accent);" /> 置顶</label>
            </div>
          </div>
        </div>

        <div class="editor-panel">
          <div class="editor-panel-title" onclick="this.classList.toggle('folded')">
            <span class="editor-panel-arrow">&#9660;</span> 分类
          </div>
          <div class="editor-panel-body">
            <select id="field-category" class="inp" style="font-size:12px;width:100%;margin-bottom:6px;"><option value="">选择分类...</option></select>
            <div style="display:flex;gap:4px;">
              <input type="text" id="field-cat-new" class="inp" placeholder="新增" style="flex:1;font-size:12px;" />
              <button onclick="addCat()" style="padding:4px 10px;border:1px solid var(--border);border-radius:4px;cursor:pointer;background:var(--bg);color:var(--text-2);font-size:12px;font-family:inherit;">添加</button>
            </div>
          </div>
        </div>

        <div class="editor-panel">
          <div class="editor-panel-title" onclick="this.classList.toggle('folded')">
            <span class="editor-panel-arrow">&#9660;</span> 标签
          </div>
          <div class="editor-panel-body">
            <input type="text" id="field-tags" class="inp" placeholder="回车添加" style="font-size:12px;width:100%;" />
            <div id="tag-list" style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;"></div>
          </div>
        </div>

        <div class="editor-panel">
          <div class="editor-panel-title" onclick="this.classList.toggle('folded')">
            <span class="editor-panel-arrow">&#9660;</span> 封面图
          </div>
          <div class="editor-panel-body">
            <input type="text" id="field-image" class="inp" placeholder="图片URL" style="font-size:12px;width:100%;margin-bottom:6px;" />
            <div id="cover-preview" style="display:none;"><img id="cover-img" src="" style="width:100%;max-height:120px;object-fit:cover;border-radius:4px;border:1px solid var(--border);" /></div>
          </div>
        </div>

        <div class="editor-panel">
          <div class="editor-panel-title" onclick="this.classList.toggle('folded')">
            <span class="editor-panel-arrow">&#9660;</span> 摘要
          </div>
          <div class="editor-panel-body">
            <textarea id="field-desc" class="inp" rows="2" placeholder="简短描述..." style="resize:vertical;font-size:12px;width:100%;"></textarea>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="toast-wrap"><div class="toast-m" id="toast-el"></div></div>

  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="/js/gh-client.js" is:inline></script>
  <script is:inline>
    (function() {
      var COLLECTION = "src/content/posts";
      var allCatsCache = [];
      var editingPath = null, allCats = [], tagList = [];

      function $(id) { return document.getElementById(id); }
      function toast(msg, type) { var el = $("toast-el"); el.textContent = msg; el.className = "toast-m " + type + " show"; clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast-m"; }, 2600); }

      // ── 工具栏操作 ──
      function execCmd(cmd) { document.execCommand(cmd, false, null); $("field-body").focus(); }
      function formatBlock(tag) {
        if (tag) { document.execCommand("formatBlock", false, "<"+tag+">"); }
        else { document.execCommand("formatBlock", false, "<p>"); }
        $("field-body").focus();
      }

      function insertCode() {
        var sel = window.getSelection();
        if (!sel.rangeCount) return;
        var range = sel.getRangeAt(0);
        var text = sel.toString() || "code";
        var code = document.createElement("code");
        code.textContent = text;
        range.deleteContents();
        range.insertNode(code);
        $("field-body").focus();
      }

      function insertCodeBlock() {
        var pre = document.createElement("pre");
        var code = document.createElement("code");
        code.textContent = "\n// 在此输入代码\n";
        pre.appendChild(code);
        insertNode(pre);
      }

      function insertLink() {
        var url = prompt("输入链接 URL:", "https://");
        if (!url) return;
        var text = window.getSelection().toString() || url;
        var a = document.createElement("a");
        a.href = url; a.textContent = text; a.target = "_blank";
        insertNode(a);
      }

      function insertImage() {
        var url = prompt("输入图片 URL:", "https://");
        if (!url) return;
        var img = document.createElement("img");
        img.src = url; img.alt = "图片";
        insertNode(img);
      }

      function insertBlockquote() {
        var bq = document.createElement("blockquote");
        var sel = window.getSelection();
        if (sel.rangeCount && sel.toString()) {
          var range = sel.getRangeAt(0);
          range.surroundContents(bq);
        } else {
          bq.textContent = "引用内容";
          insertNode(bq);
        }
        $("field-body").focus();
      }

      function insertList() {
        document.execCommand("insertUnorderedList", false, null);
        $("field-body").focus();
      }

      function insertOrderedList() {
        document.execCommand("insertOrderedList", false, null);
        $("field-body").focus();
      }

      function insertHR() {
        document.execCommand("insertHorizontalRule", false, null);
        $("field-body").focus();
      }

      function insertTable() {
        var r = parseInt(prompt("行数:", "3")) || 3;
        var c = parseInt(prompt("列数:", "3")) || 3;
        var html = '<table><thead><tr>';
        for (var i=0;i<c;i++) html += '<th>表头'+(i+1)+'</th>';
        html += '</tr></thead><tbody>';
        for (var i=0;i<r-1;i++) {
          html += '<tr>';
          for (var j=0;j<c;j++) html += '<td>单元格</td>';
          html += '</tr>';
        }
        html += '</tbody></table>';
        document.execCommand("insertHTML", false, html);
        $("field-body").focus();
      }

      function insertNode(node) {
        var sel = window.getSelection();
        if (!sel.rangeCount) { $("field-body").appendChild(node); return; }
        var range = sel.getRangeAt(0);
        range.deleteContents();
        range.insertNode(node);
        $("field-body").focus();
      }

      // ── 工具栏状态同步：光标在哪，按钮就亮 ──
      function updateToolbarState() {
        // 格式按钮
        var map = { "tb-bold":"bold", "tb-italic":"italic", "tb-strike":"strikeThrough", "tb-underline":"underline" };
        Object.keys(map).forEach(function(id) {
          var btn = document.getElementById(id);
          if (!btn) return;
          try { btn.classList.toggle("active", document.queryCommandState(map[id])); } catch(e) { btn.classList.remove("active"); }
        });
        // 有序/无序列表
        var ulBtn = document.getElementById("tb-ul");
        var olBtn = document.getElementById("tb-ol");
        if (ulBtn) { try { ulBtn.classList.toggle("active", document.queryCommandState("insertUnorderedList")); } catch(e) { ulBtn.classList.remove("active"); } }
        if (olBtn) { try { olBtn.classList.toggle("active", document.queryCommandState("insertOrderedList")); } catch(e) { olBtn.classList.remove("active"); } }
        // 标题下拉同步
        var sel = document.getElementById("tb-heading");
        if (!sel) return;
        var node = window.getSelection().anchorNode;
        while (node && node.nodeType !== 1) node = node.parentElement;
        var h = node ? node.closest("h1,h2,h3,h4,h5,h6") : null;
        sel.value = h ? h.tagName.toLowerCase() : "";
      }
      document.addEventListener("selectionchange", updateToolbarState);
      // 点击工具栏按钮时，保持编辑器焦点
      document.getElementById("toolbar").addEventListener("mousedown", function(e) {
        if (e.target.tagName === "SELECT") return; // 下拉框不要拦截
        e.preventDefault();
        var body = $("field-body");
        if (document.activeElement !== body) body.focus();
      });

      // ── 键盘快捷键 ──
      $("field-body").addEventListener("keydown", function(e) {
        if (e.ctrlKey || e.metaKey) {
          if (e.key === "z" || e.key === "Z") { e.preventDefault(); if (e.shiftKey) document.execCommand("redo",false,null); else document.execCommand("undo",false,null); return; }
          if (e.key === "y" || e.key === "Y") { e.preventDefault(); document.execCommand("redo",false,null); return; }
          if (e.key === "b" || e.key === "B") { e.preventDefault(); document.execCommand("bold",false,null); return; }
          if (e.key === "i" || e.key === "I") { e.preventDefault(); document.execCommand("italic",false,null); return; }
          if (e.key === "u" || e.key === "U") { e.preventDefault(); document.execCommand("underline",false,null); return; }
          if (e.key === "s" || e.key === "S") { e.preventDefault(); submitPost(); return; }
        }
        if (e.key === "Tab") { e.preventDefault(); document.execCommand("insertHTML", false, "    "); }
      });

      // ── 图片自动缩放：粘贴时包裹，点击未包裹的图片自动包裹 ──
      function wrapImage(img) {
        if (!img || img.tagName !== "IMG" || img.parentElement?.classList.contains("img-resize-wrap")) return;
        var wrap = document.createElement("span");
        wrap.className = "img-resize-wrap";
        if (img.parentNode) {
          img.parentNode.insertBefore(wrap, img);
          wrap.appendChild(img);
        } else {
          wrap.appendChild(img);
        }
        var w = Math.min(img.naturalWidth || img.width || 600, 600);
        if (w > 0) wrap.style.width = w + "px";
        return wrap; // 返回 wrapper，方便 insertNode 使用
      }
      $("field-body").addEventListener("paste", function(e) {
        var items = (e.clipboardData || window.clipboardData)?.items;
        if (!items) return;
        for (var i = 0; i < items.length; i++) {
          if (items[i].type.indexOf("image") !== -1) {
            e.preventDefault();
            var blob = items[i].getAsFile();
            var reader = new FileReader();
            reader.onload = function(ev) {
              var img = document.createElement("img");
              img.src = ev.target.result;
              img.onload = function() {
                var wrapped = wrapImage(img);
                insertNode(wrapped || img);
              };
              if (img.complete) { var w = wrapImage(img); insertNode(w || img); }
            };
            reader.readAsDataURL(blob);
            return;
          }
        }
      });
      // 点击未包裹的图片自动包裹
      $("field-body").addEventListener("click", function(e) {
        if (e.target.tagName === "IMG" && !e.target.parentElement?.classList.contains("img-resize-wrap")) {
          wrapImage(e.target);
        }
      });
      function htmlToMarkdown(el) {
        var md = "";
        function walk(node) {
          if (node.nodeType === 3) { md += node.textContent; return; }
          if (node.nodeType !== 1) return;
          var tag = node.tagName.toLowerCase();
          var children = Array.from(node.childNodes);

          if (tag === "br") { md += "\n"; return; }
          if (tag === "strong" || tag === "b") { md += "**"; children.forEach(walk); md += "**"; return; }
          if (tag === "em" || tag === "i") { md += "*"; children.forEach(walk); md += "*"; return; }
          if (tag === "s" || tag === "del" || tag === "strike") { md += "~~"; children.forEach(walk); md += "~~"; return; }
          if (tag === "u") { children.forEach(walk); return; }
          if (tag === "code") {
            if (node.parentElement?.tagName === "PRE") { children.forEach(walk); }
            else { md += "`"; children.forEach(walk); md += "`"; }
            return;
          }
          if (tag === "pre") { md += "\n```\n"; children.forEach(walk); md += "\n```\n"; return; }
          if (tag === "a") { md += "["; children.forEach(walk); md += "](" + (node.getAttribute("href")||"") + ")"; return; }
          if (tag === "img") { md += "![" + (node.getAttribute("alt")||"") + "](" + (node.getAttribute("src")||"") + ")"; return; }
          if (tag === "h1") { md += "# "; children.forEach(walk); md += "\n\n"; return; }
          if (tag === "h2") { md += "## "; children.forEach(walk); md += "\n\n"; return; }
          if (tag === "h3") { md += "### "; children.forEach(walk); md += "\n\n"; return; }
          if (tag === "h4") { md += "#### "; children.forEach(walk); md += "\n\n"; return; }
          if (tag === "blockquote") { md += "> "; children.forEach(walk); md += "\n\n"; return; }
          if (tag === "hr") { md += "---\n\n"; return; }
          if (tag === "li") { md += "- "; children.forEach(walk); md += "\n"; return; }
          if (tag === "table") {
            var rows = node.querySelectorAll("tr");
            rows.forEach(function(tr, ri) {
              md += "| ";
              tr.querySelectorAll("th,td").forEach(function(cell) { md += cell.textContent.replace(/\|/g,"\\|") + " | "; });
              md += "\n";
              if (ri === 0) {
                md += "| ";
                tr.querySelectorAll("th,td").forEach(function() { md += "--- | "; });
                md += "\n";
              }
            });
            md += "\n";
            return;
          }
          if (tag === "input" && node.getAttribute("type") === "checkbox") {
            md += node.checked ? "- [x] " : "- [ ] ";
            return;
          }
          // 默认
          children.forEach(walk);
        }
        walk(el);
        // 清理多余空行
        return md.replace(/\n{3,}/g, "\n\n").trim();
      }

      // ── 封面图 ──
      $("field-image").addEventListener("input", function() {
        var u = this.value.trim();
        $("cover-preview").style.display = u ? "block" : "none";
        if (u) $("cover-img").src = u;
      });

      // ── 标签 ──
      $("field-tags").addEventListener("keydown", function(e) {
        if (e.key === "Enter" || e.key === ",") {
          e.preventDefault();
          var v = this.value.replace(/,/g,"").trim();
          if (v && tagList.indexOf(v) === -1) { tagList.push(v); renderTags(); }
          this.value = "";
        }
      });
      function renderTags() {
        var c = $("tag-list"); c.innerHTML = "";
        tagList.forEach(function(t,i) {
          c.innerHTML += '<span style="display:inline-flex;align-items:center;gap:3px;padding:1px 8px;background:var(--hover);border:1px solid var(--border);border-radius:3px;font-size:11px;color:var(--text-2);">'+esc(t)+'<span style="cursor:pointer;color:var(--text-3);font-size:14px;" onclick="window.rmTag('+i+')">x</span></span>';
        });
      }
      function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
      window.rmTag = function(i) { tagList.splice(i,1); renderTags(); };

      // ── 分类 ──
      function loadCats() {
        // 从 /data/posts.json 提取分类
        fetch("/data/posts.json")
          .then(function(r) { return r.json(); })
          .then(function(entries) {
            var cats = new Set(entries.map(function(e) {
              var parts = e.path.split("/");
              return parts.length > 3 ? parts[3] : "";
            }).filter(Boolean));
            allCats = Array.from(cats).sort();
            renderCats();
          }).catch(function() { allCats = []; renderCats(); });
      }
      function renderCats() {
        var s = $("field-category"), cur = s.value;
        s.innerHTML = '<option value="">选择分类...</option>';
        allCats.forEach(function(cat) { s.innerHTML += '<option value="'+cat+'">'+cat+'</option>'; });
        if (cur) s.value = cur;
      }
      function addCat() {
        var v = $("field-cat-new").value.trim(); if (!v) return;
        if (allCats.indexOf(v)===-1) { allCats.push(v); renderCats(); }
        $("field-cat-new").value = ""; $("field-category").value = v;
      }

      // ── 发布设置 ──
      function toggleDraft() {
        var s = $("pub-status"), d = $("field-draft"), isDraft = s.textContent === "草稿";
        s.textContent = isDraft ? "已发布" : "草稿"; s.style.color = isDraft ? "var(--success)" : "var(--text-3)";
        d.value = isDraft ? "0" : "1";
      }
      function toggleDateEdit() {
        var r = $("date-edit-row"); r.style.display = r.style.display === "none" ? "block" : "none";
      }

      // ── 加载文章 ──
      function loadPost(filePath) {
        editingPath = filePath;
        $("topbar-title").textContent = "编辑文章";
        $("btn-publish").textContent = "更新";
        fetch("/data/posts.json")
          .then(function(r) { return r.json(); })
          .then(function(entries) {
            var p = entries.find(function(x) { return x.path === filePath; });
            if (!p) { toast("文章不存在", "err"); return; }
            var fm = p.frontmatter || {};
            $("field-title").value = fm.title || "";
            $("field-date").value = fm.published ? new Date(fm.published).toISOString().split("T")[0] : new Date().toISOString().split("T")[0];
            $("pub-date-display").textContent = fm.published ? new Date(fm.published).toLocaleDateString("zh-CN") : "立即发布";
            tagList = Array.isArray(fm.tags) ? [...fm.tags] : (fm.tags ? [fm.tags] : []); renderTags();
            $("field-desc").value = fm.description || "";
            $("field-image").value = fm.image || ""; $("field-image").dispatchEvent(new Event("input"));
            $("field-pinned").checked = !!fm.pinned;
            $("pub-status").textContent = fm.draft ? "草稿" : "已发布";
            $("pub-status").style.color = fm.draft ? "var(--text-3)" : "var(--success)";
            $("field-draft").value = fm.draft ? "1" : "0";
            $("field-category").value = fm.category || "";
            // 设置正文：marked.js 渲染
            var content = p.body || "";
            if (typeof marked !== "undefined") {
              $("field-body").innerHTML = marked.parse(content);
            } else {
              $("field-body").textContent = content;
              var pollMarked = setInterval(function() {
                if (typeof marked !== "undefined") {
                  clearInterval(pollMarked);
                  $("field-body").innerHTML = marked.parse(content);
                }
              }, 100);
              setTimeout(function() { clearInterval(pollMarked); }, 10000);
            }
          })
          .catch(function(e) { toast("加载失败: " + e.message, "err"); });
      }

      // ── 保存 ──
      async function submitPost() {
        var title = $("field-title").value.trim();
        if (!title) { toast("请输入标题","err"); return; }
        var cat = $("field-category").value || $("field-cat-new").value.trim();
        if (!cat) { toast("请选择分类","err"); return; }
        var markdown = htmlToMarkdown($("field-body"));
        if (!markdown.trim()) { toast("请输入正文","err"); return; }
        if (!GitHubAPI.isReady()) { toast("请先在仪表盘设置 GitHub Token", "err"); return; }
        var isEdit = !!editingPath;
        var btn = $("btn-publish"); btn.disabled = true; btn.textContent = "保存中...";
        var fm = {
          title: title, category: cat, content: markdown,
          published: $("field-date").value || new Date().toISOString().split("T")[0],
          description: $("field-desc").value.trim(), image: $("field-image").value.trim(),
          tags: tagList, draft: $("field-draft").value === "1", pinned: $("field-pinned").checked
        };
        // frontmatter 里不含 content，body 单独存
        var fmOut = { title, category: cat, published: fm.published, description: fm.description, image: fm.image, tags: fm.tags, draft: fm.draft, pinned: fm.pinned };
        try {
          var api = GitHubAPI.get();
          if (isEdit && editingPath) {
            var meta = await api.getFile(editingPath);
            await api.saveFile(editingPath, FrontmatterUtil.stringify(fmOut, markdown), meta ? meta.sha : undefined);
            toast("已保存","ok");
          } else {
            var safe = title.replace(/[<>:"/\\|?*\x00-\x1f]/g, "").replace(/\s+/g, "-").substring(0, 100) || "untitled";
            var filePath = COLLECTION + "/" + cat + "/" + safe + ".md";
            await api.saveFile(filePath, FrontmatterUtil.stringify(fmOut, markdown));
            toast("已发布","ok");
            window.location.href = "/admin/posts/";
            return;
          }
        } catch(e) { toast("保存失败: " + e.message, "err"); }
        btn.disabled = false; btn.textContent = isEdit ? "更新" : "发布";
      }

      // ── 暴露到全局 ──
      window.execCmd = execCmd; window.formatBlock = formatBlock;
      window.insertCode = insertCode; window.insertCodeBlock = insertCodeBlock;
      window.insertLink = insertLink; window.insertImage = insertImage;
      window.insertBlockquote = insertBlockquote; window.insertList = insertList;
      window.insertOrderedList = insertOrderedList; window.insertHR = insertHR;
      window.insertTable = insertTable;
      window.submitPost = submitPost; window.toggleDraft = toggleDraft;
      window.toggleDateEdit = toggleDateEdit; window.addCat = addCat;

      // ── 初始化 ──
      if (sessionStorage.getItem("admin_auth") !== "1") { window.location.href = "/admin/"; return; }
      $("field-date").value = new Date().toISOString().split("T")[0];
      loadCats();
      var params = new URLSearchParams(window.location.search);
      if (params.get("post")) loadPost(params.get("post"));
      else $("field-body").focus();
    })();
  </script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</AdminLayout>
