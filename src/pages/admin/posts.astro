---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="文章列表" activeItem="posts">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:8px;">
    <div style="display:flex;align-items:center;gap:8px;">
      <select class="form-input" id="filter-category" onchange="loadPosts()" style="width:auto;font-size:13px;padding:6px 10px;">
        <option value="">全部分类</option>
      </select>
      <span class="text-tertiary" id="list-count" style="font-size:12px;"></span>
    </div>
    <a href="/admin/posts/edit/" class="btn btn-primary" data-no-swup>+ 写文章</a>
  </div>

  <div id="posts-list">
    <div class="text-center text-secondary" style="padding:40px;"><span class="spinner"></span></div>
  </div>

  <div class="toast-wrap"><div class="toast" id="toast-el"></div></div>

  <script is:inline>
    (function() {
      var API_BASE = (window.__API_BASE || "") + "/api/admin/posts/";

      function $(id) { return document.getElementById(id); }
      function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
      function toast(msg, type) { var el = $("toast-el"); el.textContent = msg; el.className = "toast " + type + " show"; clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800); }

      function loadCategories() {
        fetch(API_BASE + "?action=categories", { credentials: "include" })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (!data.success) return;
            (data.data || []).forEach(function(c) {
              var opt = document.createElement("option"); opt.value = c; opt.textContent = c;
              $("filter-category").appendChild(opt);
            });
          });
      }

      function loadPosts() {
        var list = $("posts-list");
        list.innerHTML = '<div class="text-center text-secondary" style="padding:40px;"><span class="spinner"></span></div>';
        var cat = $("filter-category").value;
        var url = API_BASE + (cat ? "?category=" + encodeURIComponent(cat) : "");
        fetch(url, { credentials: "include" })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (!data.success) { list.innerHTML = '<div class="text-center text-danger" style="padding:24px;">' + esc(data.error) + '</div>'; return; }
            var posts = data.data || [];
            if (!posts.length) { list.innerHTML = '<div class="text-center text-tertiary" style="padding:40px;">还没有文章</div>'; $("list-count").textContent = ""; return; }
            $("list-count").textContent = "共 " + posts.length + " 篇";
            list.innerHTML = '<div class="card"><div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;font-size:13px;">' +
              '<thead><tr style="border-bottom:1px solid var(--border);text-align:left;color:var(--text-2);font-size:12px;font-weight:500;">' +
              '<th style="padding:10px 16px;">标题</th><th style="padding:10px 16px;width:100px;">分类</th><th style="padding:10px 16px;width:120px;">日期</th><th style="padding:10px 16px;width:40px;"></th><th style="padding:10px 16px;width:40px;"></th></tr></thead><tbody id="posts-tbody"></tbody></table></div></div>';
            var tbody = document.getElementById("posts-tbody");
            posts.forEach(function(p) {
              var date = p.published ? new Date(p.published).toLocaleDateString("zh-CN") : "";
              var tr = document.createElement("tr");
              tr.style.cssText = "border-bottom:1px solid var(--border);";
              tr.innerHTML = '<td style="padding:10px 16px;"><a href="/admin/posts/edit/?post=' + encodeURIComponent(p.filePath) + '" data-no-swup style="font-weight:500;text-decoration:none;">' + esc(p.title || "无标题") + '</a>' + (p.draft ? ' <span style="color:var(--text-3);font-size:11px;">— 草稿</span>' : '') + (p.pinned ? ' <span style="color:var(--sidebar-accent);font-size:11px;">— 置顶</span>' : '') + '</td>' +
                '<td style="padding:10px 16px;color:var(--text-2);">' + esc(p.category) + '</td>' +
                '<td style="padding:10px 16px;color:var(--text-3);font-size:12px;">' + date + '</td>' +
                '<td style="padding:10px 6px;"><a href="/admin/posts/edit/?post=' + encodeURIComponent(p.filePath) + '" data-no-swup class="btn btn-ghost btn-sm">编辑</a></td>' +
                '<td style="padding:10px 6px;"><button class="btn btn-ghost btn-sm" onclick="deletePost(\'' + esc(p.filePath) + '\')" style="color:var(--danger);">删除</button></td>';
              tbody.appendChild(tr);
            });
          }).catch(function(e) { list.innerHTML = '<div class="text-center text-danger" style="padding:24px;">加载失败</div>'; });
      }

      function deletePost(filePath) {
        if (!confirm("确定删除该文章？")) return;
        fetch(API_BASE, { method: "DELETE", credentials: "include", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ filePath: filePath }) })
          .then(function(r) { return r.json(); })
          .then(function(data) { if (data.success) { toast("已删除", "ok"); loadPosts(); } else { toast(data.error || "删除失败", "err"); } })
          .catch(function() { toast("删除失败", "err"); });
      }

      window.deletePost = deletePost; window.loadPosts = loadPosts;

      (function() {
        if (sessionStorage.getItem("admin_auth") !== "1") { window.location.href = "/admin/"; return; }
        loadCategories(); loadPosts();
      })();
    })();
  </script>
</AdminLayout>
