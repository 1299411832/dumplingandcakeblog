---
import { externalMomentsConfig } from "@/config/externalMomentsConfig";
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="说说管理" activeItem="moments">
  <div class="content-split">
    <!-- 左：发布 -->
    <div>
      <div class="card">
        <div class="card-header"><span class="card-title">发布说说</span></div>
        <div class="card-body">
          <div class="form-group"><label class="form-label">内容</label><textarea class="form-input" id="content-input" rows="4" placeholder="分享此刻的想法..."></textarea></div>
          <div class="form-group">
            <label class="form-label">图片</label>
            <div class="input-group"><input type="text" class="form-input" id="image-input" placeholder="粘贴图片链接，回车添加" /><button class="btn" onclick="addImage()" style="flex-shrink:0;">添加</button></div>
            <div class="mt-1 d-flex gap-1 align-items-center">
              <button class="btn btn-ghost btn-sm" onclick="toggleBatchImages()" id="batch-toggle-btn">批量添加</button>
              <span class="text-tertiary" style="font-size:12px;">|</span>
              <button class="btn btn-ghost btn-sm" onclick="triggerUpload()" id="upload-btn">📤 上传图片</button>
              <input type="file" id="file-upload-input" accept="image/png,image/jpeg,image/gif,image/webp" multiple style="display:none;" />
              <span class="text-tertiary" id="upload-status" style="font-size:12px;"></span>
            </div>
            <div class="d-none mt-2" id="batch-panel"><textarea class="form-input" id="batch-images-input" rows="3" placeholder="每行一个图片链接" style="font-size:13px;"></textarea><button class="btn btn-primary btn-sm mt-1" onclick="applyBatchImages()">确认添加</button></div>
            <div class="d-flex flex-wrap gap-1 mt-2" id="img-preview"></div>
          </div>
          <div class="form-group"><label class="form-label">标签</label><input type="text" class="form-input" id="tags-input" placeholder="逗号分隔" value="日常" /></div>
          <div class="form-group">
            <label class="form-label">位置</label>
            <div class="input-group"><input type="text" class="form-input" id="location-input" placeholder="可选" /><button class="btn" onclick="fetchLocation()" id="geo-btn" style="flex-shrink:0;">定位</button></div>
            <div id="geo-status" class="form-hint d-none mt-1"></div>
          </div>
          <div class="form-group"><label class="form-check"><input type="checkbox" id="custom-time-toggle" onchange="toggleCustomTime()" /><span>自定义发布时间</span></label><div class="d-none mt-2" id="custom-time-panel"><input type="datetime-local" class="form-input" id="time-input" /></div></div>
          <div class="form-group"><label class="form-check"><input type="checkbox" id="pinned-input" /><span>置顶</span></label></div>
        </div>
        <div class="card-footer">
          <button class="btn btn-primary w-100" id="submit-btn" onclick="submitMoment()">发布</button>
          <div class="d-none mt-2" id="edit-bar"><button class="btn w-100" onclick="cancelEdit()">取消编辑</button></div>
        </div>
      </div>
    </div>
    <!-- 右：列表 -->
    <div>
      <div class="card">
        <div class="card-header"><span class="card-title">已发布</span><span class="text-tertiary" id="list-count" style="font-size:12px;"></span></div>
        <div id="moments-list"><div class="text-center text-secondary" style="padding:24px;"><span class="spinner"></span></div></div>
      </div>
    </div>
  </div>
  <div class="toast-wrap"><div class="toast" id="toast-el"></div></div>

  <script src="/js/gh-client.js" is:inline></script>
  <script is:inline data-imgbed-url={externalMomentsConfig.imageBedUrl || ""} data-imgbed-code={externalMomentsConfig.imageBedAuthCode || ""} data-imgbed-folder={externalMomentsConfig.imageBedFolder || ""} data-imgbed-token={externalMomentsConfig.imageBedApiToken || ""}>
    (function() {
      var _s = document.currentScript;
      var COLLECTION = "src/content/moments";
      var cached = [];
      var editingId = null;

      function $(id) { return document.getElementById(id); }
      function toast(msg, type) { var el = $("toast-el"); el.textContent = msg; el.className = "toast " + type + " show"; clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800); }
      function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
      function getImages() { try { var v = JSON.parse(localStorage.getItem("moment_imgs") || "[]"); return Array.isArray(v) ? v : (v ? [v] : []); } catch(e) { return []; } }
      function setImages(v) { localStorage.setItem("moment_imgs", JSON.stringify(Array.isArray(v) ? v : (v ? [v] : []))); }

      function addImage() { var url = $("image-input").value.trim(); if (!url) return; var imgs = getImages(); imgs.push(url); setImages(imgs); $("image-input").value = ""; renderImgs(); toast("已添加第 "+imgs.length+" 张图片","ok"); }
      function removeImage(i) { var imgs = getImages(); imgs.splice(i,1); setImages(imgs); renderImgs(); }
      function renderImgs() { var imgs = getImages(), c = $("img-preview"); c.innerHTML = ""; imgs.forEach(function(url,i) { c.innerHTML += '<div style="position:relative;width:48px;height:48px;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;flex-shrink:0;"><img src="'+esc(url)+'" alt="" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.opacity=\'0.3\'"><button onclick="removeImage('+i+')" style="position:absolute;top:0;right:0;width:16px;height:16px;background:rgba(0,0,0,0.6);color:#fff;border:none;font-size:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;">x</button></div>'; }); }
      $("image-input").addEventListener("keydown", function(e) { if (e.key==="Enter") { e.preventDefault(); addImage(); } });
      function toggleBatchImages() { var p = $("batch-panel"), b = $("batch-toggle-btn"); if (p.classList.contains("d-none")) { p.classList.remove("d-none"); b.textContent="收起"; } else { p.classList.add("d-none"); b.textContent="批量添加"; } }
      function applyBatchImages() { var t = $("batch-images-input").value.trim(); if (!t) { toast("请输入","err"); return; } var urls = t.split(/[\n\r]+/).map(function(s){return s.trim();}).filter(Boolean); if (!urls.length) { toast("未识别","err"); return; } var imgs = getImages(); urls.forEach(function(u){imgs.push(u);}); setImages(imgs); renderImgs(); $("batch-images-input").value=""; $("batch-panel").classList.add("d-none"); $("batch-toggle-btn").textContent="批量添加"; toast("已添加 "+urls.length+" 张","ok"); }

      // 图床上传（保持不变）
      var IMGBED_URL = _s.getAttribute("data-imgbed-url") || "";
      var IMGBED_CODE = _s.getAttribute("data-imgbed-code") || "";
      var IMGBED_FOLDER = _s.getAttribute("data-imgbed-folder") || "";
      var IMGBED_TOKEN = _s.getAttribute("data-imgbed-token") || "";

      async function checkFileExists(filename) {
        if (!IMGBED_TOKEN) return null;
        try {
          var p = ["search="+encodeURIComponent(filename),"count=10"]; if (IMGBED_FOLDER) p.push("dir="+encodeURIComponent(IMGBED_FOLDER));
          var resp = await fetch(IMGBED_URL+"/api/manage/list?"+p.join("&"), { headers: {"Authorization":"Bearer "+IMGBED_TOKEN} });
          if (!resp.ok) return null;
          var data = await resp.json();
          if (data.files) { for (var i=0;i<data.files.length;i++) { var f = data.files[i]; var sn = (f.metadata&&f.metadata.FileName)||(f.name||"").split("/").pop(); if (sn===filename) return IMGBED_URL+"/file/"+f.name; } }
        } catch(e) {}
        return null;
      }
      function triggerUpload() { if (!IMGBED_URL) { toast("未配置图床","err"); return; } $("file-upload-input").click(); }
      $("file-upload-input").addEventListener("change", function(e) { var files = e.target.files; if (!files||!files.length) return; uploadFiles(Array.prototype.slice.call(files)); e.target.value=""; });
      async function uploadFiles(files) { var btn = $("upload-btn"), st = $("upload-status"); btn.disabled=true; st.textContent="处理中 0/"+files.length; st.style.color="var(--text-3)"; var done=0,ok=0,reused=0;
        for (var i=0;i<files.length;i++) { var file = files[i]; try { var eu = await checkFileExists(file.name); if (eu) { var imgs = getImages(); imgs.push(eu); setImages(imgs); renderImgs(); reused++; } else { var url = await uploadSingleImage(file); var imgs2=getImages(); imgs2.push(url); setImages(imgs2); renderImgs(); ok++; } } catch(err) { toast(file.name+": "+err.message,"err"); } done++; st.textContent="处理中 "+done+"/"+files.length; }
        btn.disabled=false; var msg=[]; if (ok>0) msg.push(ok+" 张上传"); if (reused>0) msg.push(reused+" 张复用"); if (msg.length>0) { st.textContent="✓ "+msg.join("，"); st.style.color="var(--success)"; toast(msg.join("，")+" 成功","ok"); } else { st.textContent="上传失败"; st.style.color="var(--danger)"; } setTimeout(function(){st.textContent="";},4000); }
      function uploadSingleImage(file) { var fd=new FormData(); fd.append("file",file); var p=["returnFormat=full","uploadNameType=origin"]; if (IMGBED_CODE) p.push("authCode="+encodeURIComponent(IMGBED_CODE)); if (IMGBED_FOLDER) p.push("uploadFolder="+encodeURIComponent(IMGBED_FOLDER)); return fetch(IMGBED_URL+"/upload?"+p.join("&"),{method:"POST",body:fd}).then(function(r){if(!r.ok) throw new Error("HTTP "+r.status); return r.json();}).then(function(d){ if (Array.isArray(d)&&d.length>0&&d[0].publicUrl) return d[0].publicUrl; if (Array.isArray(d)&&d.length>0&&d[0].src) return d[0].src; if (d&&d.publicUrl) return d.publicUrl; if (d&&d.src) return d.src; throw new Error("响应格式异常"); }); }
      function fetchLocation() { /* 保持现有逻辑 */ var se = $("geo-status"), btn = $("geo-btn"); if (!navigator.geolocation) { se.textContent="不支持定位"; se.classList.remove("d-none"); return; } se.textContent="正在定位..."; se.classList.remove("d-none"); se.style.color="var(--text-3)"; btn.disabled=true; navigator.geolocation.getCurrentPosition(function(p){ var lat=p.coords.latitude,lng=p.coords.longitude; se.textContent="解析中..."; fetch("https://api.bigdatacloud.net/data/reverse-geocode-client?latitude="+lat+"&longitude="+lng+"&localityLanguage=zh").then(function(r){return r.json();}).then(function(d){ var parts=[]; if(d.city) parts.push(d.city); else if(d.locality) parts.push(d.locality); if(d.principalSubdivision) parts.push(d.principalSubdivision); var loc=parts.join("-")||d.locality||d.countryName||(lat.toFixed(4)+", "+lng.toFixed(4)); $("location-input").value=loc; se.textContent="✓ "+loc; se.style.color="var(--success)"; btn.disabled=false; }).catch(function(){ $("location-input").value=lat.toFixed(4)+", "+lng.toFixed(4); se.textContent="已获取坐标"; se.style.color="var(--text-3)"; btn.disabled=false; }); }, function(err) { se.textContent={1:"权限被拒绝",2:"无法获取",3:"超时"}[err.code]||"失败"; se.style.color="var(--danger)"; btn.disabled=false; }, { enableHighAccuracy:false, timeout:10000, maximumAge:300000 }); }

      // ── 分页加载（读 /data/moments.json，秒开免 token）──
      var PAGE_SIZE = 20;
      var allMoments = []; // 全部数据（含 frontmatter + body）
      var currentPage = 0;

      // 规范化 images：数组 / 逗号分隔字符串 / 单字符串 → 统一数组
      function normalizeImages(images) {
        if (Array.isArray(images)) return images;
        if (typeof images === "string") {
          // 逗号分隔的多个 URL
          return images.split(",").map(function(s) { return s.trim(); }).filter(Boolean);
        }
        return [];
      }

      function loadMoments() {
        var list = $("moments-list");
        list.innerHTML = '<div class="text-center text-secondary" style="padding:24px;"><span class="spinner"></span>加载数据...</div>';
        currentPage = 0; cached = [];
        fetch("/data/moments.json")
          .then(function(r) { return r.json(); })
          .then(function(entries) {
            // 转成后台对象：{ _path, ...frontmatter, content }
            allMoments = entries.map(function(e) {
              var fm = Object.assign({}, e.frontmatter);
              fm.images = normalizeImages(fm.images);
              return Object.assign({ _path: e.path }, fm, { content: e.body });
            });
            // 按 published 降序
            allMoments.sort(function(a,b) { return new Date(b.published||0) - new Date(a.published||0); });
            $("list-count").textContent = allMoments.length + " 条";
            if (!allMoments.length) { showEmpty(); return; }
            renderList(0);
          })
          .catch(function(e) { list.innerHTML = '<div class="text-center text-danger" style="padding:24px;">加载失败: '+esc(e.message)+'</div>'; });
      }

      function renderList(page) {
        currentPage = page;
        var list = $("moments-list");
        if (page === 0) list.innerHTML = "";
        // 移除旧的分页按钮
        var oldMore = list.querySelector(".load-more-btn");
        if (oldMore) oldMore.remove();

        var start = page * PAGE_SIZE;
        var batch = allMoments.slice(start, start + PAGE_SIZE);
        if (!batch.length) return;

        batch.forEach(function(m) {
          // 合并到缓存（编辑用）
          var found = cached.findIndex(function(c) { return c._path === m._path; });
          if (found >= 0) cached[found] = m; else cached.push(m);

          var d = document.createElement("div"); d.className = "list-row";
          var date = m.published ? new Date(m.published) : new Date();
          var ds = date.toLocaleDateString("zh-CN") + " " + date.toLocaleTimeString("zh-CN",{hour:"2-digit",minute:"2-digit"});
          var text = (m.content||"").slice(0,100) + ((m.content||"").length>100?"...":"");
          var imgs = Array.isArray(m.images) ? m.images : (m.images?[m.images]:[]);
          // 检测视频（mp4/webm 等）
          function isVideo(u) { return /\.(mp4|webm|ogv|mov|m4v)$/i.test(u.split("?")[0]); }
          var imgHtml = imgs.length ? '<div class="d-flex gap-1 mt-1">'+imgs.slice(0,3).map(function(u){
            return isVideo(u)
              ? '<video src="'+esc(u)+'" controls style="width:64px;height:64px;object-fit:cover;border:1px solid var(--border);border-radius:2px;" preload="metadata"></video>'
              : '<img src="'+esc(u)+'" alt="" style="width:32px;height:32px;object-fit:cover;border:1px solid var(--border);border-radius:2px;">';
          }).join("")+(imgs.length>3?'<span class="text-tertiary" style="font-size:11px;">+'+ (imgs.length-3)+'</span>':"")+'</div>' : "";
          var tags = Array.isArray(m.tags) ? m.tags : (m.tags?[m.tags]:[]);
          var tagHtml = tags.length ? '<span class="text-tertiary" style="font-size:11px;">· #'+tags.join(" #")+'</span>' : "";
          d.innerHTML = '<div class="flex-1 min-w-0"><div style="font-size:13px;line-height:1.5;word-break:break-word;">'+esc(text)+'</div>'+imgHtml+'<div class="d-flex align-items-center gap-1 mt-1" style="font-size:11px;color:var(--text-3);"><span>'+ds+'</span>'+tagHtml+'</div></div><div class="d-flex gap-1" style="flex-shrink:0;"><button class="btn btn-ghost btn-sm" onclick="editMoment(\''+esc(m._path)+'\')">编辑</button><button class="btn btn-ghost btn-sm btn-danger" onclick="deleteMoment(\''+esc(m._path)+'\')">删除</button></div>';
          list.appendChild(d);
        });

        // 加载更多
        var nextStart = (page + 1) * PAGE_SIZE;
        if (nextStart < allMoments.length) {
          var more = document.createElement("div");
          more.className = "load-more-btn";
          more.style.cssText = "text-align:center;padding:12px;";
          more.innerHTML = '<button class="btn" onclick="renderList('+(page+1)+')">加载更多 ('+(allMoments.length - nextStart)+' 条剩余)</button>';
          list.appendChild(more);
        }
      }

      function showEmpty() { $("moments-list").innerHTML = '<div class="text-center text-tertiary" style="padding:32px;">还没有说说</div>'; $("list-count").textContent = ""; }
      function toggleCustomTime() { var p = $("custom-time-panel"); if ($("custom-time-toggle").checked) p.classList.remove("d-none"); else { p.classList.add("d-none"); $("time-input").value=""; } }
      function getPublishedTime() { if ($("custom-time-toggle").checked) { var c=$("time-input").value; if (c) { var s=c.replace("T"," "); if (s.length===16) s+=":00"; return s; } } var n=new Date(); var pad=function(x){return String(x).padStart(2,"0");}; return n.getFullYear()+"-"+pad(n.getMonth()+1)+"-"+pad(n.getDate())+" "+pad(n.getHours())+":"+pad(n.getMinutes())+":"+pad(n.getSeconds()); }

      function editMoment(path) {
        var m = cached.find(function(x){return x._path===path;}); if (!m) { toast("未找到","err"); return; }
        editingId = path;
        $("content-input").value = m.content || "";
        $("tags-input").value = (Array.isArray(m.tags)?m.tags:[]).join(", ");
        $("location-input").value = m.location || "";
        $("pinned-input").checked = !!m.pinned;
        setImages(m.images||[]); renderImgs();
        if (m.published) { $("custom-time-toggle").checked=true; $("custom-time-panel").classList.remove("d-none"); var d=new Date(m.published); var pad=function(x){return String(x).padStart(2,"0");}; $("time-input").value=d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate())+"T"+pad(d.getHours())+":"+pad(d.getMinutes()); }
        $("submit-btn").textContent="保存修改"; $("edit-bar").classList.remove("d-none"); $("content-input").focus(); $("content-input").scrollIntoView({behavior:"smooth",block:"center"}); toast("正在编辑","ok");
      }
      function cancelEdit() { editingId=null; $("content-input").value=""; $("tags-input").value="日常"; $("location-input").value=""; $("pinned-input").checked=false; $("time-input").value=""; $("custom-time-toggle").checked=false; $("custom-time-panel").classList.add("d-none"); setImages([]); renderImgs(); $("submit-btn").textContent="发布"; $("edit-bar").classList.add("d-none"); }

      async function submitMoment() {
        if (!GitHubAPI.isReady()) { toast("请先设置 Token","err"); return; }
        var content = $("content-input").value.trim(); if (!content) { toast("请输入内容","err"); return; }
        var images = getImages(), tags = $("tags-input").value.split(",").map(function(s){return s.trim();}).filter(Boolean);
        var location = $("location-input").value.trim(), pinned = $("pinned-input").checked;
        var published = getPublishedTime(), btn = $("submit-btn"), isEdit = !!editingId;
        btn.disabled = true; btn.textContent = "保存中...";

        var id = editingId || ("ext-"+Date.now());
        var fm = { id:id, published:published, author:"团子", avatar:"/assets/ziyuan/tx.webp" };
        if (pinned) fm.pinned = true;
        if (tags.length) fm.tags = tags;
        if (location) fm.location = location;
        if (images.length) fm.images = images;

        try {
          var api = GitHubAPI.get();
          var dateBase = published.slice(0,10);
          var filename = dateBase+".md";
          if (isEdit) {
            var target = cached.find(function(x){return x._path===editingId;});
            if (!target) { toast("未找到","err"); return; }
            // 写操作需要先取 SHA
            var meta = await api.getFile(target._path);
            var sha = meta ? meta.sha : undefined;
            await api.saveFile(target._path, FrontmatterUtil.stringify(fm, content), sha);
            toast("已保存 ✓","ok"); cancelEdit(); loadMoments();
          } else {
            // 去重文件名
            var existing = await api.listDir(COLLECTION);
            var names = existing.map(function(e){return e.name;});
            var suffix = 2;
            while (names.indexOf(filename) >= 0) { filename = dateBase+"-"+suffix+".md"; suffix++; }
            await api.saveFile(COLLECTION+"/"+filename, FrontmatterUtil.stringify(fm, content));
            toast("发布成功 ✓","ok"); cancelEdit(); loadMoments();
          }
        } catch(e) { toast("保存失败: "+e.message,"err"); }
        btn.disabled = false; btn.textContent = isEdit ? "保存修改" : "发布";
      }

      async function deleteMoment(path) {
        if (!confirm("确定删除？")) return;
        if (!GitHubAPI.isReady()) { toast("请先设置 Token","err"); return; }
        var target = cached.find(function(x){return x._path===path;});
        if (!target) { toast("未找到","err"); return; }
        try {
          var meta = await GitHubAPI.get().getFile(target._path);
          if (!meta) { toast("文件不存在","err"); return; }
          await GitHubAPI.get().deleteFile(target._path, meta.sha);
          toast("已删除","ok"); loadMoments();
        } catch(e) { toast("删除失败: "+e.message,"err"); }
      }

      window.addImage = addImage; window.removeImage = removeImage; window.toggleBatchImages = toggleBatchImages; window.applyBatchImages = applyBatchImages;
      window.triggerUpload = triggerUpload; window.fetchLocation = fetchLocation; window.toggleCustomTime = toggleCustomTime;
      window.submitMoment = submitMoment; window.editMoment = editMoment; window.cancelEdit = cancelEdit; window.deleteMoment = deleteMoment;
      window.renderList = renderList;

      if (sessionStorage.getItem("admin_auth") !== "1") { window.location.href = "/admin/"; return; }
      renderImgs(); loadMoments();
    })();
  </script>
</AdminLayout>
