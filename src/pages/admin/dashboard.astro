---
// 后台管理仪表盘
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="仪表盘" activeItem="dashboard">
  <!-- 配置区 -->
  <div class="card" style="margin-bottom:16px;">
    <div class="card-header"><span class="card-title">配置</span></div>
    <div class="card-body">
      <p class="form-hint" style="margin-bottom:8px;">后台通过 GitHub Contents API 直接读写仓库文件，无需后端服务。</p>
      <div class="form-group" style="margin-bottom:10px;">
        <label class="form-label">GitHub Token</label>
        <div class="input-group">
          <input type="password" class="form-input" id="token-input" placeholder="ghp_xxx 或 github_pat_xxx" style="font-size:13px;" />
          <button class="btn" onclick="toggleTokenVisibility()" id="toggle-btn" style="flex-shrink:0;" title="显示/隐藏">👁</button>
        </div>
        <p class="form-hint" style="margin-top:4px;">需要 <code>Contents: Read & Write</code> 权限。创建：<a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">GitHub Fine-grained Token</a> → 选仓库 → Contents: Read and Write</p>
      </div>
      <div class="form-group" style="margin-bottom:4px;">
        <button class="btn btn-primary" onclick="saveToken()" id="save-btn" style="width:100%;">保存 Token</button>
      </div>
      <div id="token-status" class="form-hint" style="margin-top:6px;"></div>
    </div>
  </div>

  <!-- 快捷入口 -->
  <div class="card">
    <div class="card-header"><span class="card-title">快捷入口</span></div>
    <div class="card-body">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;">
        <a href="/admin/posts/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;"><span style="font-size:20px;">📝</span><span>文章</span></a>
        <a href="/admin/moments/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;"><span style="font-size:20px;">✎</span><span>说说</span></a>
        <a href="/admin/notebooks/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;"><span style="font-size:20px;">▤</span><span>笔记</span></a>
        <a href="/admin/media/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;"><span style="font-size:20px;">🖼</span><span>媒体库</span></a>
        <a href="/admin/bangumi/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;"><span style="font-size:20px;">▶</span><span>影视</span></a>
        <a href="/admin/places/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;"><span style="font-size:20px;">◎</span><span>足迹</span></a>
        <a href="/admin/friends/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;"><span style="font-size:20px;">⚭</span><span>友链</span></a>
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      var TOKEN_KEY = "gh_admin_token";

      function $(id) { return document.getElementById(id); }

      // 加载已有 token
      var saved = localStorage.getItem(TOKEN_KEY);
      if (saved) {
        $("token-input").value = saved;
        $("token-status").textContent = "✓ Token 已保存";
        $("token-status").style.color = "var(--success)";
      }

      function toggleTokenVisibility() {
        var inp = $("token-input"), btn = $("toggle-btn");
        inp.type = inp.type === "password" ? "text" : "password";
        btn.textContent = inp.type === "password" ? "👁" : "🙈";
      }

      function saveToken() {
        var token = $("token-input").value.trim();
        if (!token) { $("token-status").textContent = "请输入 Token"; $("token-status").style.color = "var(--danger)"; return; }
        if (!token.startsWith("ghp_") && !token.startsWith("github_pat_")) {
          $("token-status").textContent = "Token 格式不对，应该以 ghp_ 或 github_pat_ 开头";
          $("token-status").style.color = "var(--danger)";
          return;
        }
        localStorage.setItem(TOKEN_KEY, token);
        $("token-status").textContent = "✓ Token 已保存";
        $("token-status").style.color = "var(--success)";
      }

      window.toggleTokenVisibility = toggleTokenVisibility;
      window.saveToken = saveToken;
    })();
  </script>
</AdminLayout>
