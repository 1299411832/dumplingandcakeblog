---
// 后台管理仪表盘
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="仪表盘" activeItem="dashboard">
  <!-- 状态概览 -->
  <div class="card" style="margin-bottom:24px;">
    <div class="card-header"><span class="card-title">系统状态</span></div>
    <div class="card-body">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span id="status-dot" style="width:8px;height:8px;border-radius:50%;background:var(--success);flex-shrink:0;"></span>
        <span style="font-size:14px;font-weight:500;">已登录</span>
      </div>
      <p class="form-hint">所有功能通过统一 API 读写 Content Collection，保存即生效。</p>
    </div>
  </div>

  <!-- 快捷入口 -->
  <div class="card">
    <div class="card-header"><span class="card-title">快捷入口</span></div>
    <div class="card-body">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;">
        <a href="/admin/moments/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;">
          <span style="font-size:20px;">✎</span>
          <span>发布说说</span>
        </a>
        <a href="/admin/notebooks/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;">
          <span style="font-size:20px;">▤</span>
          <span>写笔记</span>
        </a>
        <a href="/admin/bangumi/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;">
          <span style="font-size:20px;">▶</span>
          <span>添加影视</span>
        </a>
        <a href="/admin/places/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;">
          <span style="font-size:20px;">◎</span>
          <span>记录足迹</span>
        </a>
        <a href="/admin/friends/" class="btn" data-no-swup style="flex-direction:column;padding:14px 10px;height:auto;text-align:center;">
          <span style="font-size:20px;">⚭</span>
          <span>管理友链</span>
        </a>
      </div>
    </div>
  </div>
</AdminLayout>
