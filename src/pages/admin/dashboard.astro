---
// 后台管理仪表盘
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="仪表盘" activeItem="dashboard">
  <!-- Token 管理 -->
  <div class="card" style="margin-bottom:24px;">
    <div class="card-header"><span class="card-title">GitHub Token</span></div>
    <div class="card-body">
      <p class="form-hint" style="margin-bottom:10px;">所有功能共享此 Token，用于读写 Gist 数据。<a href="https://github.com/settings/tokens/new?scopes=gist&description=firefly-admin" target="_blank" style="color:var(--sidebar-accent);text-decoration:underline;">创建 Token →</a></p>
      <div class="input-group">
        <input type="password" class="form-input" id="token-input" placeholder="ghp_xxx 或 github_pat_xxx" />
        <button class="btn btn-primary" onclick="saveToken()" style="flex-shrink:0;">保存</button>
        <button class="btn btn-ghost d-none" id="disconnect-btn" onclick="clearToken()" style="flex-shrink:0;">清除</button>
      </div>
      <div style="display:flex;align-items:center;gap:8px;margin-top:10px;">
        <span id="status-dot" style="width:6px;height:6px;border-radius:50%;background:var(--text-3);flex-shrink:0;"></span>
        <span id="status-text" style="font-size:12px;color:var(--text-3);">未设置</span>
      </div>
    </div>
  </div>

  <!-- 后续内容区 -->


  <script is:inline>
    (function() {
      var TOKEN = localStorage.getItem("gh_moments_token") || "";
      var API = "https://api.github.com";

      function $(id) { return document.getElementById(id); }
      function setStatus(ok, text) {
        $("status-dot").style.background = ok ? "var(--success)" : "var(--danger)";
        $("status-text").textContent = text;
        $("status-text").style.color = ok ? "var(--success)" : "var(--text-3)";
      }

      function checkToken() {
        if (!TOKEN) { setStatus(false, "未设置 Token"); $("disconnect-btn").classList.add("d-none"); return; }
        $("token-input").value = TOKEN;
        setStatus(false, "验证中...");
        fetch(API + "/user", { headers: { "Authorization": "Bearer " + TOKEN } })
          .then(function(r) {
            if (r.ok) { setStatus(true, "Token 有效"); $("disconnect-btn").classList.remove("d-none"); }
            else { setStatus(false, "Token 无效或已过期"); $("disconnect-btn").classList.remove("d-none"); }
          }).catch(function() { setStatus(false, "网络错误"); });
      }

      window.saveToken = function() {
        var t = $("token-input").value.trim();
        if (!t) { setStatus(false, "请输入 Token"); return; }
        TOKEN = t; localStorage.setItem("gh_moments_token", t);
        setStatus(false, "验证中...");
        fetch(API + "/user", { headers: { "Authorization": "Bearer " + TOKEN } })
          .then(function(r) {
            if (r.ok) { setStatus(true, "Token 有效 ✓"); $("disconnect-btn").classList.remove("d-none"); }
            else { setStatus(false, "Token 无效（HTTP " + r.status + "）"); }
          }).catch(function() { setStatus(false, "网络错误"); });
      };

      window.clearToken = function() {
        TOKEN = ""; localStorage.removeItem("gh_moments_token");
        $("token-input").value = ""; $("disconnect-btn").classList.add("d-none");
        setStatus(false, "已清除");
      };

      checkToken();
    })();
  </script>
</AdminLayout>
