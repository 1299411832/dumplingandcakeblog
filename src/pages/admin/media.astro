---
import { externalMomentsConfig } from "@/config/externalMomentsConfig";
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="媒体库" activeItem="media">
  <!-- 来源切换 -->
  <div class="card mb-3">
    <div class="card-body" style="padding:6px 8px;">
      <div style="display:flex;gap:4px;" id="source-tabs">
        <button class="btn btn-sm btn-primary" data-source="imgbed" onclick="switchSource('imgbed')">☁ 图床</button>
        <button class="btn btn-sm" data-source="local" onclick="switchSource('local')">📁 本地素材</button>
      </div>
    </div>
  </div>

  <!-- 工具栏 -->
  <div class="card mb-3">
    <div class="card-body" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;padding:10px 16px;">
      <span class="text-tertiary" id="dir-label" style="font-size:12px;white-space:nowrap;">目录:</span>
      <select class="form-input" id="dir-select" onchange="changeDir()" style="width:auto;min-width:140px;font-size:13px;">
        <option value="">加载中...</option>
      </select>
      <button class="btn btn-sm" onclick="loadFiles()" title="刷新">↻</button>
      <span style="flex:1;"></span>
      <span id="action-buttons-imgbed">
        <button class="btn btn-primary btn-sm" onclick="triggerUpload()" id="upload-btn">📤 上传</button>
        <input type="file" id="file-input" accept="image/png,image/jpeg,image/gif,image/webp" multiple style="display:none;" />
        <span class="text-tertiary" id="delete-count" style="font-size:12px;display:none;">
          <button class="btn btn-danger btn-sm" onclick="deleteSelected()">删除选中 (<span id="sel-count">0</span>)</button>
        </span>
      </span>
    </div>
  </div>

  <!-- 上传进度 -->
  <div class="card mb-3 d-none" id="upload-progress-card">
    <div class="card-body" style="padding:10px 16px;">
      <div class="d-flex align-items-center gap-2">
        <span class="spinner" style="width:14px;height:14px;"></span>
        <span id="upload-progress-text" style="font-size:13px;">上传中...</span>
      </div>
    </div>
  </div>

  <!-- 图片网格 -->
  <div id="media-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;">
    <div class="text-center text-secondary" style="padding:40px;grid-column:1/-1;"><span class="spinner"></span></div>
  </div>

  <!-- 分页 -->
  <div class="d-flex gap-1 align-items-center justify-content-center mt-3" id="pagination">
    <button class="btn btn-sm" onclick="prevPage()" id="btn-prev" disabled>← 上一页</button>
    <span class="text-tertiary" id="page-info" style="font-size:12px;"></span>
    <button class="btn btn-sm" onclick="nextPage()" id="btn-next">下一页 →</button>
  </div>

  <!-- URL 复制弹窗 -->
  <div class="d-none" id="copy-modal" style="position:fixed;inset:0;z-index:9999;align-items:center;justify-content:center;">
    <div style="position:absolute;inset:0;background:rgba(0,0,0,0.5);" onclick="closeCopyModal()"></div>
    <div class="card" style="position:relative;z-index:1;width:90%;max-width:400px;margin:0;">
      <div class="card-header"><span class="card-title">复制链接</span><button class="btn btn-ghost btn-sm" onclick="closeCopyModal()">✕</button></div>
      <div class="card-body">
        <img id="copy-preview" src="" alt="" style="width:100%;max-height:200px;object-fit:contain;margin-bottom:12px;border-radius:var(--radius);background:var(--hover);" />
        <div class="form-group"><label class="form-label">图片 URL</label><div class="input-group"><input type="text" class="form-input" id="copy-url" readonly /><button class="btn btn-primary btn-sm" onclick="copyText('copy-url')">复制</button></div></div>
        <div class="form-group"><label class="form-label">Markdown</label><div class="input-group"><input type="text" class="form-input" id="copy-md" readonly /><button class="btn btn-primary btn-sm" onclick="copyText('copy-md')">复制</button></div></div>
        <div class="form-group"><label class="form-label">HTML</label><div class="input-group"><input type="text" class="form-input" id="copy-html" readonly /><button class="btn btn-primary btn-sm" onclick="copyText('copy-html')">复制</button></div></div>
      </div>
    </div>
  </div>

  <div class="toast-wrap"><div class="toast" id="toast-el"></div></div>

  <script is:inline
    data-imgbed-url={externalMomentsConfig.imageBedUrl || ""}
    data-imgbed-folder={externalMomentsConfig.imageBedFolder || ""}>
    (function() {
      var _script = document.currentScript;
      var API_BASE = (window.__API_BASE || "") + "/api/admin/media/";
      var IMGBED_URL = (_script.getAttribute("data-imgbed-url") || "").replace(/\/+$/, "");
      var currentDir = _script.getAttribute("data-imgbed-folder") || "";
      var currentSource = "local";

      // 初始化：本地素材 tab 高亮
      (function initTabs() {
        $("source-tabs").querySelectorAll("button").forEach(function(b) {
          b.classList.toggle("btn-primary", b.getAttribute("data-source") === "local");
        });
        $("action-buttons-imgbed").style.display = "none";
        currentDir = ""; // 本地根目录
      })();

      // ── 来源切换 ──
      function switchSource(source) {
        currentSource = source;
        currentDir = source === "imgbed" ? (_script.getAttribute("data-imgbed-folder") || "") : "";
        selectedFiles.clear(); updateSelectUI();
        // 立即更新 UI
        $("source-tabs").querySelectorAll("button").forEach(function(b) {
          b.classList.toggle("btn-primary", b.getAttribute("data-source") === source);
        });
        $("action-buttons-imgbed").style.display = source === "imgbed" ? "" : "none";
        // 立即显示加载状态
        $("media-grid").innerHTML = '<div class="text-center text-secondary" style="padding:40px;grid-column:1/-1;"><span class="spinner"></span></div>';
        $("dir-select").innerHTML = '<option value="">加载中...</option>';
        $("pagination").classList.add("d-none");
        loadDirs();
      }
      var currentPage = 0, pageSize = 50, hasMore = false;
      var allFiles = [], selectedFiles = new Set();

      function $(id) { return document.getElementById(id); }
      function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
      function toast(msg, type) { var el = $("toast-el"); el.textContent = msg; el.className = "toast " + type + " show"; clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800); }

      // ── 目录加载 ──
      function loadDirs() {
        fetch(API_BASE + "?action=dirs&source=" + currentSource, { credentials: "include" })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            var sel = $("dir-select"); sel.innerHTML = "";
            var dirs = (data.data || []);
            // 本地素材：始终显示根目录选项
            if (currentSource === "local" && dirs.indexOf("") === -1) dirs.unshift("");
            if (dirs.indexOf(currentDir) === -1 && currentDir) dirs.unshift(currentDir);
            dirs.forEach(function(d) {
              var displayName = d === "" ? "(根目录)" : d;
              var opt = document.createElement("option"); opt.value = d; opt.textContent = displayName; opt.selected = (d === currentDir); sel.appendChild(opt);
            });
            if (dirs.length && currentDir === undefined) currentDir = dirs[0];
            loadFiles();
          });
      }

      // ── 文件列表 ──
      function loadFiles() {
        selectedFiles.clear(); updateSelectUI();
        var grid = $("media-grid");
        grid.innerHTML = '<div class="text-center text-secondary" style="padding:40px;grid-column:1/-1;"><span class="spinner"></span></div>';
        currentPage = 0;
        var url = API_BASE + "?action=list&source=" + currentSource + "&count=" + pageSize + "&start=0";
        if (currentDir) url += "&dir=" + encodeURIComponent(currentDir);
        fetch(url, { credentials: "include" })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            var files = data?.files || data?.data?.files || [];
            if (!Array.isArray(files)) files = [];
            allFiles = files.filter(function(f) {
              var type = (f.metadata?.FileType || f.type || "").toLowerCase();
              return type.startsWith("image/") || type === "" || !type;
            });
            hasMore = files.length >= pageSize;
            renderGrid();
          }).catch(function(e) {
            grid.innerHTML = '<div class="text-center text-danger" style="padding:24px;grid-column:1/-1;">加载失败</div>';
          });
      }

      function renderGrid() {
        var grid = $("media-grid");
        if (!allFiles.length) { grid.innerHTML = '<div class="text-center text-tertiary" style="padding:40px;grid-column:1/-1;">该目录没有图片</div>'; $("pagination").classList.add("d-none"); return; }
        grid.innerHTML = "";
        allFiles.forEach(function(file) {
          var name = file.name || file.path || "";
          var url = file.url || (IMGBED_URL + "/file/" + name);
          var filename = name.split("/").pop() || name;
          var isSel = selectedFiles.has(name);
          var d = document.createElement("div");
          d.style.cssText = "position:relative;border:2px solid " + (isSel ? "var(--sidebar-accent)" : "var(--border)") + ";border-radius:var(--radius);overflow:hidden;cursor:pointer;aspect-ratio:1;background:var(--hover);";
          d.title = filename;
          d.innerHTML = '<img src="' + url + '" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;" onerror="this.parentElement.style.opacity=\'0.3\'" />' +
            '<div style="position:absolute;bottom:0;left:0;right:0;padding:3px 6px;background:linear-gradient(transparent,rgba(0,0,0,0.6));font-size:10px;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(filename) + '</div>' +
            (isSel ? '<div style="position:absolute;top:4px;right:4px;width:18px;height:18px;background:var(--sidebar-accent);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;">✓</div>' : '');
          d.addEventListener("click", function(e) {
            if (e.shiftKey || e.ctrlKey) { toggleSelect(name); } else { openCopyModal(name, url, filename); }
          });
          d.addEventListener("contextmenu", function(e) { e.preventDefault(); toggleSelect(name); });
          grid.appendChild(d);
        });
        $("pagination").classList.remove("d-none");
        $("page-info").textContent = "共 " + allFiles.length + " 张";
        $("btn-prev").disabled = currentPage === 0;
        $("btn-next").disabled = !hasMore;
      }

      // ── 选择 / 删除 ──
      function toggleSelect(name) {
        if (selectedFiles.has(name)) selectedFiles.delete(name); else selectedFiles.add(name);
        updateSelectUI(); renderGrid();
      }
      function updateSelectUI() {
        var cnt = selectedFiles.size;
        $("delete-count").style.display = cnt > 0 ? "" : "none";
        $("sel-count").textContent = cnt;
      }
      function deleteSelected() {
        if (!selectedFiles.size) return;
        if (!confirm("确定删除 " + selectedFiles.size + " 个文件？")) return;
        var files = Array.from(selectedFiles);
        var done = 0, err = 0;
        function delNext() {
          if (!files.length) { toast("删除完成: " + done + " 成功" + (err ? ", " + err + " 失败" : ""), err ? "err" : "ok"); selectedFiles.clear(); updateSelectUI(); loadFiles(); return; }
          var f = files.shift();
          fetch(API_BASE, { method: "DELETE", credentials: "include", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ path: f }) })
            .then(function(r) { return r.json(); })
            .then(function(data) { if (data.success) done++; else err++; delNext(); })
            .catch(function() { err++; delNext(); });
        }
        delNext();
      }

      // ── 复制弹窗 ──
      function openCopyModal(name, url, filename) {
        $("copy-modal").classList.remove("d-none");
        $("copy-modal").style.display = "flex";
        $("copy-preview").src = url;
        $("copy-url").value = url;
        $("copy-md").value = "![" + (filename || "image") + "](" + url + ")";
        $("copy-html").value = '<img src="' + url + '" alt="' + (filename || "") + '">';
      }
      function closeCopyModal() { $("copy-modal").classList.add("d-none"); $("copy-modal").style.display = "none"; }
      function copyText(fieldId) {
        var el = $(fieldId); el.select(); el.setSelectionRange(0, 99999);
        document.execCommand("copy"); toast("已复制 ✓", "ok");
      }

      // ── 上传 ──
      function triggerUpload() { $("file-input").click(); }
      $("file-input").addEventListener("change", function(e) {
        var files = e.target.files; if (!files || !files.length) return;
        uploadFiles(Array.prototype.slice.call(files));
        e.target.value = "";
      });

      async function uploadFiles(files) {
        $("upload-progress-card").classList.remove("d-none");
        $("upload-btn").disabled = true;
        var done = 0, ok = 0, err = 0;
        for (var i = 0; i < files.length; i++) {
          var file = files[i];
          $("upload-progress-text").textContent = "上传中 " + (done + 1) + "/" + files.length + ": " + file.name;
          try {
            var formData = new FormData();
            formData.append("file", file);
            if (currentDir) formData.append("folder", currentDir);
            var resp = await fetch(API_BASE, { method: "POST", credentials: "include", body: formData });
            var data = await resp.json();
            if (data.success) { ok++; toast(file.name + " ✓", "ok"); }
            else { err++; toast(file.name + ": " + (data.error || "失败"), "err"); }
          } catch (ex) { err++; toast(file.name + ": 网络错误", "err"); }
          done++;
          $("upload-progress-text").textContent = "完成 " + done + "/" + files.length + " (成功 " + ok + (err ? ", 失败 " + err : "") + ")";
        }
        $("upload-btn").disabled = false;
        setTimeout(function() { $("upload-progress-card").classList.add("d-none"); }, 2000);
        loadFiles();
      }

      // ── 分页 ──
      function prevPage() { if (currentPage <= 0) return; currentPage--; loadPage(); }
      function nextPage() { currentPage++; loadPage(); }
      function loadPage() {
        selectedFiles.clear(); updateSelectUI();
        var url = API_BASE + "?action=list&source=" + currentSource + "&count=" + pageSize + "&start=" + (currentPage * pageSize);
        if (currentDir) url += "&dir=" + encodeURIComponent(currentDir);
        fetch(url, { credentials: "include" })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            var files = data?.files || data?.data?.files || [];
            if (!Array.isArray(files)) files = [];
            allFiles = files.filter(function(f) {
              var type = (f.metadata?.FileType || f.type || "").toLowerCase();
              return type.startsWith("image/") || type === "" || !type;
            });
            hasMore = files.length >= pageSize;
            renderGrid();
          });
      }
      function changeDir() { currentDir = $("dir-select").value; loadFiles(); }

      window.triggerUpload = triggerUpload; window.loadFiles = loadFiles;
      window.deleteSelected = deleteSelected; window.closeCopyModal = closeCopyModal;
      window.copyText = copyText; window.prevPage = prevPage; window.nextPage = nextPage;
      window.changeDir = changeDir; window.openCopyModal = openCopyModal; window.switchSource = switchSource;

      (function() {
        if (sessionStorage.getItem("admin_auth") !== "1") { window.location.href = "/admin/"; return; }
        loadDirs();
      })();
    })();
  </script>
</AdminLayout>
