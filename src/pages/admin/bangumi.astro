---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="影视管理" activeItem="bangumi">
  <div class="content-split">
    <!-- 左：搜索 + 表单 -->
    <div>
      <div class="card" style="margin-bottom:16px;">
        <div class="card-header"><span class="card-title">搜索影视</span></div>
        <div class="card-body">
          <p class="form-hint" style="margin-bottom:8px;">同时搜索 TMDB、豆瓣、Bangumi，点击结果自动填充</p>
          <div class="input-group">
            <input type="text" class="form-input" id="search-input" placeholder="输入影视名称..." />
            <button class="btn btn-primary" id="search-btn" onclick="doSearch()" style="flex-shrink:0;">搜索</button>
          </div>
          <div id="search-results" class="d-none mt-2"></div>
        </div>
      </div>

      <div id="preview-area" class="card d-none" style="margin-bottom:16px;">
        <div class="card-body" style="display:flex;gap:12px;">
          <img id="preview-poster" src="" alt="" style="width:56px;height:78px;object-fit:cover;border-radius:var(--radius);flex-shrink:0;background:var(--hover);" />
          <div class="flex-1">
            <div id="preview-title" class="fw-600" style="font-size:14px;"></div>
            <div id="preview-meta" class="text-secondary mt-1" style="font-size:12px;"></div>
          </div>
        </div>
      </div>

      <div id="form-area" class="card d-none">
        <div class="card-header"><span class="card-title">填写信息</span></div>
        <div class="card-body">
          <div class="form-grid">
            <div class="form-group"><label class="form-label">标题（英文/原名）</label><input type="text" class="form-input" id="field-title" /></div>
            <div class="form-group"><label class="form-label">中文名</label><input type="text" class="form-input" id="field-name-cn" /></div>
            <div class="form-group"><label class="form-label">类型</label><select class="form-input" id="field-category"><option value="anime">动漫</option><option value="movie">电影</option><option value="tv">电视剧</option><option value="documentary">纪录片</option><option value="game">游戏</option></select></div>
            <div class="form-group"><label class="form-label">时间</label><input type="text" class="form-input" id="field-date" placeholder="YYYY-MM-DD" /></div>
            <div class="form-group"><label class="form-label">状态</label><select class="form-input" id="field-status"><option value="1">想看</option><option value="2" selected>看过</option><option value="3">在看</option><option value="4">搁置</option><option value="5">抛弃</option></select></div>
            <div class="form-group"><label class="form-label">评分 (0-10)</label><input type="text" class="form-input" id="field-score" value="0" /></div>
          </div>
          <div class="form-group"><label class="form-label">封面 URL</label><input type="text" class="form-input" id="field-image" /></div>
          <div class="form-group"><label class="form-label">标签（逗号分隔）</label><input type="text" class="form-input" id="field-tags" /></div>
          <div class="form-group"><label class="form-label">评价/备注</label><input type="text" class="form-input" id="field-comment" /></div>
          <div id="edit-bar" class="d-none" style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--hover);border-radius:var(--radius);font-size:13px;color:var(--text-2);margin-bottom:12px;">
            <span>编辑模式</span>
            <button class="btn btn-ghost btn-sm" onclick="cancelEdit()">取消</button>
          </div>
        </div>
        <div class="card-footer">
          <div class="d-flex gap-1">
            <button class="btn btn-primary flex-1" id="submit-btn" onclick="submitBangumi()">保存</button>
            <button class="btn" onclick="clearForm()">清空</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 右：列表 -->
    <div>
      <div class="card" id="bangumi-section">
        <div class="card-header">
          <span class="card-title">已添加的影视</span>
          <span id="list-count" class="text-tertiary" style="font-size:12px;"></span>
        </div>
        <div id="bangumi-list">
          <div class="text-center text-secondary" style="padding:24px;"><span class="spinner"></span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="toast-wrap"><div class="toast" id="toast-el"></div></div>

  <script src="/js/gh-client.js" is:inline></script>
  <script is:inline>
    (function() {
      var COLLECTION = "src/content/bangumi";
      var TMDB_KEY = "8a9a0dd41f7b6fe6d4d20f6cc9bd26f2";
      var searchResults = [], selectedIndex = -1;
      var cachedItems = [];
      var editingPath = null;

      function $(id) { return document.getElementById(id); }
      function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
      function toast(msg, type) { var el = $("toast-el"); el.textContent = msg; el.className = "toast " + type + " show"; clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800); }

      function doSearch() { var query = $("search-input").value.trim(); if (!query) { toast("请输入搜索关键词", "err"); return; } $("search-btn").disabled = true; $("search-btn").textContent = "搜索中..."; $("search-results").innerHTML = '<div class="text-center text-secondary" style="padding:12px;"><span class="spinner"></span> 搜索中...</div>'; $("search-results").classList.remove("d-none"); searchResults = []; selectedIndex = -1; Promise.all([searchTMDB(query).catch(function() { return []; }), searchDouban(query).catch(function() { return []; }), searchBangumi(query).catch(function() { return []; })]).then(function(results) { searchResults = results[0].concat(results[1]).concat(results[2]); renderSearchResults(); }).finally(function() { $("search-btn").disabled = false; $("search-btn").textContent = "搜索"; }); }
      function searchTMDB(q) { return fetch("https://api.themoviedb.org/3/search/multi?api_key=" + TMDB_KEY + "&language=zh-CN&query=" + encodeURIComponent(q)).then(function(r) { return r.json(); }).then(function(d) { return (d.results || []).filter(function(i) { return i.media_type === "movie" || i.media_type === "tv"; }).slice(0, 5).map(function(i) { return { title: i.title || i.name || "", year: (i.release_date || i.first_air_date || "").slice(0, 4), poster: i.poster_path ? "https://image.tmdb.org/t/p/w200" + i.poster_path : "", source: "TMDB", id: i.id, media_type: i.media_type }; }); }); }
      function searchDouban(q) { return fetch("https://movie.douban.com/j/subject_suggest?q=" + encodeURIComponent(q), { headers: { "Referer": "https://movie.douban.com/" } }).then(function(r) { return r.json(); }).then(function(d) { return d.filter(function(i) { return i.type === "movie" || i.type === "tv"; }).slice(0, 5).map(function(i) { return { title: i.title, year: i.year || "", poster: i.img || "", source: "豆瓣", id: i.id, sub_title: i.sub_title || "" }; }); }); }
      function searchBangumi(q) { return fetch("https://api.bgm.tv/search/subject/" + encodeURIComponent(q) + "?type=2&limit=5").then(function(r) { return r.json(); }).then(function(d) { return (d.data || []).slice(0, 5).map(function(i) { return { title: i.name_cn || i.name, original_title: i.name, year: (i.date || "").slice(0, 4), poster: (i.images || {}).large || "", source: "Bangumi", id: i.id }; }); }); }
      function renderSearchResults() { var c = $("search-results"); if (!searchResults.length) { c.innerHTML = '<div class="text-center text-secondary" style="padding:12px;">未找到结果</div>'; return; } c.innerHTML = ""; searchResults.forEach(function(item, i) { var d = document.createElement("div"); d.className = "list-row cursor-pointer"; d.setAttribute("data-index", i); d.onmouseenter = function() { d.style.background = "var(--hover)"; }; d.onmouseleave = function() { d.style.background = ""; }; var posterHtml = item.poster ? '<img src="' + esc(item.poster) + '" alt="" style="width:36px;height:50px;object-fit:cover;border-radius:2px;flex-shrink:0;">' : '<div style="width:36px;height:50px;background:var(--hover);border-radius:2px;flex-shrink:0;"></div>'; d.innerHTML = posterHtml + '<div class="flex-1 min-w-0"><div class="fw-500 text-truncate" style="font-size:14px;">' + esc(item.title) + (item.year ? " (" + item.year + ")" : "") + '</div><div class="text-secondary" style="font-size:12px;">' + esc(item.source) + (item.sub_title ? " · " + esc(item.sub_title) : "") + '</div></div>'; d.addEventListener("click", function() { selectResult(i); }); c.appendChild(d); }); }
      function selectResult(index) { selectedIndex = index; var item = searchResults[index]; document.querySelectorAll("#search-results .list-row").forEach(function(el) { el.style.outline = parseInt(el.getAttribute("data-index")) === index ? "1px solid var(--text-3)" : "none"; }); $("field-title").value = item.original_title || item.title || ""; $("field-name-cn").value = item.title || ""; $("field-image").value = item.poster || ""; if (item.source === "Bangumi") $("field-category").value = "anime"; else if (item.media_type === "tv") $("field-category").value = "tv"; else $("field-category").value = "movie"; if (item.source === "TMDB" && item.media_type) $("field-tags").value = item.media_type === "tv" ? "电视剧" : "电影"; $("preview-area").classList.remove("d-none"); $("preview-poster").src = item.poster || ""; $("preview-poster").style.display = item.poster ? "" : "none"; $("preview-title").textContent = item.title; $("preview-meta").textContent = (item.year || "") + " · " + item.source; $("form-area").classList.remove("d-none"); toast("已选择: " + item.title, "ok"); }

      // category 映射：表单值 → schema 值
      function mapCategory(formValue) {
        // movie/tv/documentary → anime + subcategory
        if (["movie", "tv", "documentary"].includes(formValue)) {
          return { category: "anime", subcategory: formValue };
        }
        // book/anime/music/game/real 直接
        return { category: formValue || "anime", subcategory: undefined };
      }

      function editBangumi(path) {
        var item = cachedItems.find(function(x) { return x._path === path; });
        if (!item) { toast("未找到", "err"); return; }
        editingPath = path;
        $("field-title").value = item.title || ""; $("field-name-cn").value = item.name_cn || "";
        // 表单类型：subcategory(movie/tv/documentary) 优先，否则 category
        $("field-category").value = item.subcategory || item.category || "anime";
        $("field-status").value = String(item.status || 2);
        $("field-score").value = String(item.score || 0); $("field-image").value = item.image || "";
        $("field-tags").value = (item.tags || []).join(", "); $("field-comment").value = item.comment || "";
        $("field-date").value = item.published ? String(item.published).slice(0, 10) : "";
        $("submit-btn").textContent = "保存修改"; $("edit-bar").classList.remove("d-none"); $("form-area").classList.remove("d-none");
        if (item.image) { $("preview-area").classList.remove("d-none"); $("preview-poster").src = item.image; $("preview-poster").style.display = ""; $("preview-title").textContent = item.name_cn || item.title; $("preview-meta").textContent = "编辑中"; }
        $("field-title").focus(); $("field-title").scrollIntoView({ behavior: "smooth", block: "center" });
        toast("正在编辑: " + (item.name_cn || item.title), "ok");
      }
      function cancelEdit() { editingPath = null; $("submit-btn").textContent = "保存"; $("edit-bar").classList.add("d-none"); clearForm(); }

      async function submitBangumi() {
        var title = $("field-title").value.trim(), nameCn = $("field-name-cn").value.trim();
        if (!title && !nameCn) { toast("请填写标题", "err"); return; }
        if (!GitHubAPI.isReady()) { toast("请先在仪表盘设置 GitHub Token", "err"); return; }
        var btn = $("submit-btn"), isEdit = !!editingPath; btn.disabled = true; btn.textContent = "保存中...";
        var displayTitle = title || nameCn;
        var mc = mapCategory($("field-category").value);
        var dateVal = $("field-date").value.trim();

        var fm = {
          title: displayTitle,
          category: mc.category,
          status: parseInt($("field-status").value) || 2,
          score: parseInt($("field-score").value) || 0,
          image: $("field-image").value.trim(),
          comment: $("field-comment").value.trim(),
        };
        if (nameCn && nameCn !== displayTitle) fm.name_cn = nameCn;
        if (mc.subcategory) fm.subcategory = mc.subcategory;
        var tags = ($("field-tags").value || "").split(",").map(function(s) { return s.trim(); }).filter(Boolean);
        if (tags.length) fm.tags = tags;
        if (dateVal) fm.published = dateVal;

        try {
          var api = GitHubAPI.get();
          if (isEdit) {
            var meta = await api.getFile(editingPath);
            await api.saveFile(editingPath, FrontmatterUtil.stringify(fm, fm.comment || ""), meta ? meta.sha : undefined);
            // 内存更新
            var idx = cachedItems.findIndex(function(i){return i._path===editingPath;});
            if (idx >= 0) cachedItems[idx] = Object.assign({}, cachedItems[idx], fm, { content: fm.comment || "" });
            toast("已保存 ✓", "ok"); cancelEdit(); renderBangumi();
          } else {
            var safe = displayTitle.replace(/[<>:"/\\|?*\x00-\x1f]/g, "").replace(/\s+/g, "-").substring(0, 100) || "untitled";
            var dirPath = COLLECTION + "/" + mc.category;
            if (mc.subcategory) dirPath += "/" + mc.subcategory;
            await api.saveFile(dirPath + "/" + safe + ".md", FrontmatterUtil.stringify(fm, fm.comment || ""));
            // 内存新增
            cachedItems.push(Object.assign({ _path: dirPath + "/" + safe + ".md" }, fm, { content: fm.comment || "" }));
            toast("保存成功 ✓", "ok"); cancelEdit(); renderBangumi();
          }
        } catch(e) { toast("保存失败: " + e.message, "err"); }
        btn.disabled = false; btn.textContent = isEdit ? "保存修改" : "保存";
      }

      function renderBangumi() {
        var list = $("bangumi-list");
        var oldMore = list.querySelector(".load-more-btn");
        if (oldMore) oldMore.remove();
        var pageFiles = allFilesB.slice(currentPageB*PAGE_SIZE_B, (currentPageB+1)*PAGE_SIZE_B);
        var pageItems = pageFiles.map(function(f) { return cachedItems.find(function(c) { return c._path === f.path; }); }).filter(Boolean);
        if (!pageItems.length && currentPageB === 0) { list.innerHTML = '<div class="text-center text-tertiary" style="padding:32px;">还没有影视数据</div>'; $("list-count").textContent = ""; return; }
        if (currentPageB === 0) list.innerHTML = "";
        $("list-count").textContent = allFilesB.length + " 部";
        var statusMap = { 1: "想看", 2: "看过", 3: "在看", 4: "搁置", 5: "抛弃" };
        pageItems.forEach(function(item) {
          var d = document.createElement("div"); d.className = "list-row";
          var posterHtml = item.image ? '<img src="' + esc(item.image) + '" alt="" style="width:32px;height:44px;object-fit:cover;border-radius:2px;flex-shrink:0;">' : '<div style="width:32px;height:44px;background:var(--hover);border-radius:2px;flex-shrink:0;"></div>';
          var displayTitle = item.name_cn || item.title;
          d.innerHTML = posterHtml + '<div class="flex-1 min-w-0"><div class="fw-500 text-truncate" style="font-size:13px;">' + esc(displayTitle) + '</div><div class="text-secondary" style="font-size:12px;">' + esc(statusMap[item.status] || "") + (item.score ? " · " + item.score + "分" : "") + '</div></div>' + '<div class="d-flex gap-1"><button class="btn btn-ghost btn-sm" onclick="editBangumi(\'' + esc(item._path) + '\')">编辑</button><button class="btn btn-ghost btn-sm btn-danger" onclick="deleteBangumi(\'' + esc(item._path) + '\')">删除</button></div>';
          list.appendChild(d);
        });
        var nextStart = (currentPageB + 1) * PAGE_SIZE_B;
        if (nextStart < allFilesB.length) {
          var more = document.createElement("div"); more.className = "load-more-btn";
          more.style.cssText = "text-align:center;padding:12px;";
          more.innerHTML = '<button class="btn" onclick="loadPageB('+(currentPageB+1)+')">加载更多 ('+(allFilesB.length-nextStart)+' 条剩余)</button>';
          list.appendChild(more);
        }
      }

      // ── 分页按需读取 ──
      var PAGE_SIZE_B = 20, allFilesB = [], currentPageB = 0;

      function loadBangumiList() {
        if (!GitHubAPI.isReady()) { $("bangumi-list").innerHTML = '<div class="text-center text-danger" style="padding:24px;">请先在仪表盘设置 GitHub Token</div>'; return; }
        var list = $("bangumi-list"); list.innerHTML = '<div class="text-center text-secondary" style="padding:24px;"><span class="spinner"></span>加载文件列表...</div>';
        $("bangumi-section").style.display = "";
        currentPageB = 0; cachedItems = [];
        GitHubAPI.get().listTree(COLLECTION).then(function(files) {
          files.sort(function(a,b) { return b.name.localeCompare(a.name); });
          allFilesB = files;
          if (!files.length) { cachedItems = []; renderBangumi(); return; }
          $("list-count").textContent = files.length + " 部";
          loadPageB(0);
        }).catch(function(e) { list.innerHTML = '<div class="text-center text-danger" style="padding:24px;">加载失败: '+esc(e.message)+'</div>'; });
      }

      function loadPageB(page) {
        currentPageB = page;
        var batch = allFilesB.slice(page*PAGE_SIZE_B, (page+1)*PAGE_SIZE_B);
        if (!batch.length) return;
        if (page === 0) $("bangumi-list").innerHTML = '<div class="text-center text-secondary" style="padding:24px;"><span class="spinner"></span>加载中...</div>';
        var api = GitHubAPI.get();
        Promise.all(batch.map(function(f) {
          return api.getContent(f.path).then(function(raw) {
            if (!raw) return null;
            var p = FrontmatterUtil.parse(raw);
            return Object.assign({ _path: f.path, _sha: f.sha }, p.frontmatter, { content: p.body });
          });
        })).then(function(items) {
          var arr = items.filter(Boolean);
          arr.forEach(function(m) {
            var idx = cachedItems.findIndex(function(c) { return c._path === m._path; });
            if (idx >= 0) cachedItems[idx] = m; else cachedItems.push(m);
          });
          renderBangumi();
        }).catch(function(e) { if (page === 0) $("bangumi-list").innerHTML = '<div class="text-center text-danger" style="padding:24px;">加载失败: '+esc(e.message)+'</div>'; });
      }

      async function deleteBangumi(path) {
        if (!confirm("确定删除？")) return;
        if (!GitHubAPI.isReady()) { toast("请先设置 Token", "err"); return; }
        var target = cachedItems.find(function(i) { return i._path === path; });
        try {
          await GitHubAPI.get().deleteFile(path, target._sha);
          cachedItems = cachedItems.filter(function(i) { return i._path !== path; });
          allFilesB = allFilesB.filter(function(i) { return i.path !== path; });
          toast("已删除", "ok"); renderBangumi();
        } catch(e) { toast("删除失败: " + e.message, "err"); }
      }
      function clearForm() { $("search-input").value = ""; $("search-results").classList.add("d-none"); $("search-results").innerHTML = ""; $("preview-area").classList.add("d-none"); $("form-area").classList.add("d-none"); $("field-title").value = ""; $("field-name-cn").value = ""; $("field-category").value = "anime"; $("field-status").value = "2"; $("field-score").value = "0"; $("field-image").value = ""; $("field-tags").value = ""; $("field-comment").value = ""; $("field-date").value = ""; searchResults = []; selectedIndex = -1; }
      $("search-input").addEventListener("keydown", function(e) { if (e.key === "Enter") { e.preventDefault(); doSearch(); } });

      window.doSearch = doSearch; window.submitBangumi = submitBangumi; window.editBangumi = editBangumi; window.cancelEdit = cancelEdit; window.deleteBangumi = deleteBangumi; window.clearForm = clearForm; window.loadPageB = loadPageB;
      (function() { if (sessionStorage.getItem("admin_auth") !== "1") { window.location.href = "/admin/"; return; } loadBangumiList(); })();
    })();
  </script>
</AdminLayout>
