---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="友链管理" activeItem="friends">
  <div class="content-split">
    <!-- 左：添加 -->
    <div>
      <div class="card">
        <div class="card-header"><span class="card-title">添加友链</span></div>
        <div class="card-body">
          <div class="form-group">
            <label class="form-label">粘贴友链信息</label>
            <p class="form-hint">格式：站点名称: xxx / 站点描述: xxx / 站点链接: xxx / 头像链接: xxx</p>
            <textarea class="form-input" id="paste-input" rows="6" placeholder="站点名称: 团子和蛋糕
站点描述: 如果你喜欢那么欢迎来到我的世界！
站点链接: https://blog.tsh520.cn
头像链接: /assets/ziyuan/tx.webp"></textarea>
          </div>
          <div id="preview-area" class="d-none">
            <label class="form-label">预览</label>
            <div style="display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--border);border-radius:var(--radius);margin-bottom:12px;">
              <img id="preview-avatar" src="" alt="" style="width:40px;height:40px;border-radius:50%;object-fit:cover;border:1px solid var(--border);flex-shrink:0;" />
              <div class="flex-1 min-w-0">
                <div id="preview-name" class="fw-600" style="font-size:14px;"></div>
                <div id="preview-desc" class="text-secondary text-truncate" style="font-size:13px;"></div>
                <div id="preview-url" class="text-truncate" style="font-size:12px;color:var(--text-3);"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="card-footer">
          <div class="d-flex gap-1">
            <button class="btn btn-primary flex-1" id="submit-btn" onclick="submitFriend()">添加友链</button>
            <button class="btn" onclick="clearForm()">清空</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 右：列表 -->
    <div>
      <div class="card" id="friends-section">
        <div class="card-header">
          <span class="card-title">已添加的友链</span>
          <span class="text-tertiary" id="list-count" style="font-size:12px;"></span>
        </div>
        <div id="friends-list">
          <div class="text-center text-secondary" style="padding:24px;"><span class="spinner"></span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="toast-wrap"><div class="toast" id="toast-el"></div></div>

  <script src="/js/gh-client.js" is:inline></script>
  <script is:inline>
    (function() {
      var COLLECTION = "src/content/friends";
      var cached = [];

      function $(id) { return document.getElementById(id); }
      function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
      function toast(msg, type) { var el = $("toast-el"); el.textContent = msg; el.className = "toast " + type + " show"; clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800); }

      function parsePastedText(text) {
        var result = { title: "", desc: "", siteurl: "", imgurl: "" };
        text.split("\n").map(function(s) { return s.trim(); }).filter(Boolean).forEach(function(line) {
          var m = line.match(/^(站点名称|名称|标题|title|name|我的名称)\s*[:：]\s*(.+)$/i); if (m) { result.title = m[2].trim(); return; }
          m = line.match(/^(站点描述|描述|desc|descr|description)\s*[:：]\s*(.+)$/i); if (m) { result.desc = m[2].trim(); return; }
          m = line.match(/^(站点链接|链接|url|link|siteurl|site_url|网站地址|地址)\s*[:：]\s*(.+)$/i); if (m) { result.siteurl = m[2].trim(); return; }
          m = line.match(/^(头像链接|头像|avatar|imgurl|img_url|image)\s*[:：]\s*(.+)$/i); if (m) { result.imgurl = m[2].trim(); return; }
        });
        return result;
      }

      function setupPasteListener() {
        $("paste-input").addEventListener("input", function() {
          var data = parsePastedText(this.value);
          if (data.title || data.siteurl) {
            $("preview-area").classList.remove("d-none");
            $("preview-name").textContent = data.title || "未识别到名称";
            $("preview-desc").textContent = data.desc || "未识别到描述";
            $("preview-url").textContent = data.siteurl || "未识别到链接";
            $("preview-avatar").src = data.imgurl || ""; $("preview-avatar").style.display = data.imgurl ? "" : "none";
          } else { $("preview-area").classList.add("d-none"); }
        });
      }

      // 读数据：/data/friends.json（EdgeOne CDN 秒开）
      function loadFriends() {
        var list = $("friends-list"); list.innerHTML = '<div class="text-center text-secondary" style="padding:24px;"><span class="spinner"></span>加载中...</div>';
        fetch("/data/friends.json")
          .then(function(r) { return r.json(); })
          .then(function(entries) {
            cached = entries.map(function(e) {
              return Object.assign({ _path: e.path }, e.frontmatter, { content: e.body });
            });
            if (!cached.length) { list.innerHTML = '<div class="text-center text-tertiary" style="padding:32px;">还没有友链</div>'; $("list-count").textContent = ""; return; }
            $("list-count").textContent = cached.length + " 个"; list.innerHTML = "";
            cached.forEach(function(f) {
              var d = document.createElement("div"); d.className = "list-row";
              var avatarHtml = f.imgurl ? '<img src="' + esc(f.imgurl) + '" alt="" style="width:36px;height:36px;border-radius:50%;object-fit:cover;flex-shrink:0;">' : '<div style="width:36px;height:36px;border-radius:50%;background:var(--hover);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--text-3);font-size:12px;">🔗</div>';
              d.innerHTML = avatarHtml + '<div class="flex-1 min-w-0"><div class="fw-500" style="font-size:14px;">' + esc(f.title) + '</div><div class="text-secondary text-truncate" style="font-size:13px;">' + esc(f.desc || f.siteurl) + '</div></div>' + '<button class="btn btn-ghost btn-sm btn-danger" onclick="deleteFriend(\'' + esc(f._path) + '\')">删除</button>';
              list.appendChild(d);
            });
          }).catch(function() { list.innerHTML = '<div class="text-center text-danger" style="padding:24px;">加载失败</div>'; });
      }

      // 写数据：GitHub API（需要 token）
      async function submitFriend() {
        var data = parsePastedText($("paste-input").value || "");
        if (!data.title) { toast("请输入站点名称", "err"); return; }
        if (!data.siteurl) { toast("请输入站点链接", "err"); return; }
        if (!GitHubAPI.isReady()) { toast("请先在仪表盘设置 GitHub Token", "err"); return; }
        var btn = $("submit-btn"); btn.disabled = true; btn.textContent = "保存中...";
        try {
          var api = GitHubAPI.get();
          // 查重
          var existing = await api.listDir(COLLECTION);
          var hasUrl = existing.some(function() { return false; });
          // 找下一个序号
          var mdFiles = existing.filter(function(e) { return e.name.endsWith(".md"); });
          var index = mdFiles.length + 1;
          var slug = data.title.toLowerCase().replace(/[^a-z0-9一-鿿]+/g, "-").replace(/^-|-$/g, "").substring(0, 60) || ("friend-" + index);
          var filename = String(index).padStart(2, "0") + "-" + slug + ".md";

          var fm = { title: data.title, imgurl: data.imgurl, desc: data.desc, siteurl: data.siteurl };
          await api.saveFile(COLLECTION + "/" + filename, FrontmatterUtil.stringify(fm, ""));
          toast("添加成功 ✓", "ok"); clearForm(); loadFriends();
        } catch(e) { toast("添加失败: " + e.message, "err"); }
        btn.disabled = false; btn.textContent = "添加友链";
      }

      async function deleteFriend(path) {
        if (!confirm("确定删除该友链？")) return;
        if (!GitHubAPI.isReady()) { toast("请先设置 Token", "err"); return; }
        var target = cached.find(function(f) { return f._path === path; });
        if (!target) { toast("未找到", "err"); return; }
        try {
          var meta = await GitHubAPI.get().getFile(target._path);
          if (!meta) { toast("文件不存在", "err"); return; }
          await GitHubAPI.get().deleteFile(target._path, meta.sha);
          toast("已删除", "ok"); loadFriends();
        } catch(e) { toast("删除失败: " + e.message, "err"); }
      }
      function clearForm() { $("paste-input").value = ""; $("preview-area").classList.add("d-none"); }

      window.submitFriend = submitFriend; window.clearForm = clearForm; window.deleteFriend = deleteFriend;
      (function() { if (sessionStorage.getItem("admin_auth") !== "1") { window.location.href = "/admin/"; return; } setupPasteListener(); loadFriends(); })();
    })();
  </script>
</AdminLayout>
