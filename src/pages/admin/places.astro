---
import { externalPlacesConfig } from "@/config/externalPlacesConfig";
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="足迹管理" activeItem="places">
  <div class="content-split">
    <!-- 左：表单 -->
    <div>
      <div class="card">
        <div class="card-header"><span class="card-title">创建新足迹</span></div>
        <div class="card-body">
          <p class="form-hint" style="margin-bottom:12px;">输入地点名称后点击「获取坐标」自动填充经纬度</p>
          <div class="form-grid">
            <div class="form-group"><label class="form-label">省份</label><input type="text" class="form-input" id="field-province" placeholder="如：河南" /></div>
            <div class="form-group"><label class="form-label">城市</label><input type="text" class="form-input" id="field-city" placeholder="如：商丘" /></div>
          </div>
          <div class="form-group"><label class="form-label">详细地址</label><input type="text" class="form-input" id="field-address" placeholder="如：睢县董店乡" /></div>
          <div class="form-group">
            <div class="d-flex gap-1 align-items-center" style="flex-wrap:wrap;">
              <div style="flex:1;min-width:100px;"><label class="form-label">纬度</label><input type="text" class="form-input" id="field-lat" placeholder="34.4608" /></div>
              <div style="flex:1;min-width:100px;"><label class="form-label">经度</label><input type="text" class="form-input" id="field-lng" placeholder="115.0718" /></div>
              <div style="align-self:flex-end;margin-bottom:1px;"><button class="btn btn-primary" onclick="fetchCoordinates()">获取坐标</button></div>
            </div>
            <p class="form-hint" style="margin-top:4px;">手动拾取坐标：<a href="https://lbs.amap.com/tools/picker" target="_blank" rel="noopener">高德地图坐标拾取器</a></p>
          </div>
          <div class="form-grid">
            <div class="form-group"><label class="form-label">日期</label><input type="date" class="form-input" id="field-date" /></div>
            <div class="form-group"><label class="form-label">到访次数</label><input type="number" class="form-input" id="field-count" value="1" min="1" /></div>
          </div>
          <div class="form-grid">
            <div class="form-group"><label class="form-label">链接文字</label><input type="text" class="form-input" id="field-url-label" placeholder="如：游记" /></div>
            <div class="form-group"><label class="form-label">链接 URL</label><input type="text" class="form-input" id="field-url" placeholder="https://..." /></div>
          </div>
          <div class="form-group"><label class="form-label">描述</label><textarea class="form-input" id="field-experience" rows="3" placeholder="说说你的经历..."></textarea></div>
          <div class="form-group">
            <label class="form-label">标签</label>
            <p class="form-hint">输入标签后按 Enter 添加</p>
            <div style="display:flex;flex-wrap:wrap;gap:4px;padding:6px 10px;border:1px solid var(--border);border-radius:var(--radius);min-height:36px;" id="tags-input">
              <div style="display:flex;gap:4px;flex:1;" id="tag-input-wrap">
                <input type="text" id="tag-input" placeholder="输入标签..." style="flex:1;border:none;background:none;outline:none;font-size:13px;padding:0;" />
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">照片</label>
            <div class="d-flex flex-wrap gap-1 mb-1" id="photos-list"></div>
            <div class="input-group">
              <input type="text" class="form-input" id="photo-input" placeholder="输入照片 URL..." />
              <button class="btn" onclick="addPhoto()" style="flex-shrink:0;">添加</button>
            </div>
            <div class="mt-1 d-flex gap-1 align-items-center">
              <button class="btn btn-ghost btn-sm" onclick="triggerPlaceUpload()" id="place-upload-btn">📤 上传图片</button>
              <input type="file" id="place-file-input" accept="image/png,image/jpeg,image/gif,image/webp" multiple style="display:none;" />
              <span class="text-tertiary" id="place-upload-status" style="font-size:12px;"></span>
            </div>
          </div>
          <div class="card d-none" id="preview-card" style="margin-bottom:0;">
            <div class="card-body" style="padding:8px 12px;">
              <div class="fw-600" id="preview-name" style="font-size:14px;"></div>
              <div class="text-secondary" id="preview-meta" style="font-size:12px;"></div>
            </div>
          </div>
        </div>
        <div class="card-footer">
          <div class="d-flex gap-1">
            <button class="btn btn-primary flex-1" id="submit-btn" onclick="submitPlace()">保存</button>
            <button class="btn" onclick="clearForm()">清空</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 右：列表 -->
    <div>
      <div class="card">
        <div class="card-header">
          <span class="card-title">已有的足迹</span>
          <span id="list-count" class="text-tertiary" style="font-size:12px;"></span>
        </div>
        <div id="places-list">
          <div class="text-center text-secondary" style="padding:24px;"><span class="spinner"></span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="toast-wrap"><div class="toast" id="toast-el"></div></div>

  <script is:inline
    data-gist-id={externalPlacesConfig.gistId || ""}
    data-file-name={externalPlacesConfig.fileName || "places"}
    data-amap-key={import.meta.env.PUBLIC_AMAP_KEY_PLACES || ""}
    data-imgbed-url={externalPlacesConfig.imageBedUrl || ""}
    data-imgbed-code={externalPlacesConfig.imageBedAuthCode || ""}
    data-imgbed-folder={externalPlacesConfig.imageBedFolder || ""}
    data-imgbed-token={externalPlacesConfig.imageBedApiToken || ""}>
    (function() {
      var _script = document.currentScript;
      var AMAP_KEY = _script.getAttribute("data-amap-key") || "";
      var GIST_ID = _script.getAttribute("data-gist-id") || "";
      var FILE_NAME = _script.getAttribute("data-file-name") || "places";
      var TOKEN = localStorage.getItem("gh_moments_token") || "";
      var API = "https://api.github.com";

      function $(id) { return document.getElementById(id); }
      function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
      function toast(msg, type) { var el = $("toast-el"); el.textContent = msg; el.className = "toast " + type + " show"; clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800); }
      function checkAndLoad() { if (!TOKEN) { toast("请先在仪表盘设置 Token", "err"); return; } loadPlacesList(); }

      var editingId = null;
      async function fetchGistEntries() { if (!TOKEN || !GIST_ID) return []; var gist = await fetch(API + "/gists/" + GIST_ID, { headers: { "Authorization": "Bearer " + TOKEN } }).then(function(r) { return r.json(); }); var file = gist.files[FILE_NAME]; if (!file) return []; var entries = []; try { entries = JSON.parse(file.content || "[]"); } catch(e) { return []; } return entries; }
      async function saveToGist(data, editId) { if (!TOKEN || !GIST_ID) { toast("请先设置 Token", "err"); return false; } try { var existing = await fetchGistEntries(); var entry = { id: editId || ("p-" + Date.now()), province: data.province || "", city: data.city || "", lat: data.lat || "", lng: data.lng || "", experience: data.experience || "", visitCount: data.visitCount || 1, date: data.date || new Date().toISOString().split("T")[0], tags: data.tags && data.tags.length > 0 ? data.tags : ["去过"], markerColor: data.markerColor || ["sunset", "ocean", "forest", "lavender", "sunshine", "rose"][existing.length % 6], url: data.url || "", urlLabel: data.urlLabel || "", photos: data.photos || [] }; if (editId) { var idx = existing.findIndex(function(e) { return e.id === editId; }); if (idx !== -1) { existing[idx] = entry; } else { existing.push(entry); } } else { existing.push(entry); } await fetch(API + "/gists/" + GIST_ID, { method: "PATCH", headers: { "Authorization": "Bearer " + TOKEN, "Content-Type": "application/json" }, body: JSON.stringify({ files: { [FILE_NAME]: { content: JSON.stringify(existing, null, 2) } } }) }); return true; } catch (e) { toast("保存失败: " + e.message, "err"); return false; } }
      async function deleteFromGist(entryId) { if (!TOKEN || !GIST_ID) return false; try { var existing = await fetchGistEntries(); existing = existing.filter(function(e) { return e.id !== entryId; }); await fetch(API + "/gists/" + GIST_ID, { method: "PATCH", headers: { "Authorization": "Bearer " + TOKEN, "Content-Type": "application/json" }, body: JSON.stringify({ files: { [FILE_NAME]: { content: JSON.stringify(existing, null, 2) } } }) }); return true; } catch (e) { return false; } }

      var tags = [];
      function renderTags() { var container = $("tags-input"), inputWrap = $("tag-input-wrap"); container.innerHTML = ""; tags.forEach(function(tag, i) { var d = document.createElement("span"); d.style.cssText = "display:inline-flex;align-items:center;gap:4px;padding:2px 8px;background:var(--hover);border-radius:4px;font-size:12px;"; d.innerHTML = esc(tag) + ' <span style="cursor:pointer;color:var(--text-3);" onclick="removeTag(' + i + ')">×</span>'; container.appendChild(d); }); container.appendChild(inputWrap); $("tag-input").value = ""; }
      function addTag() { var val = $("tag-input").value.trim(); if (val && !tags.includes(val)) { tags.push(val); renderTags(); } $("tag-input").value = ""; }
      function removeTag(index) { tags.splice(index, 1); renderTags(); }
      $("tag-input").addEventListener("keydown", function(e) { if (e.key === "Enter") { e.preventDefault(); addTag(); } });

      var photos = [];
      function renderPhotos() { var container = $("photos-list"); container.innerHTML = ""; photos.forEach(function(url, i) { var d = document.createElement("div"); d.style.cssText = "position:relative;width:56px;height:56px;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;flex-shrink:0;"; d.innerHTML = '<img src="' + esc(url) + '" alt="" style="width:100%;height:100%;object-fit:cover;">' + '<button onclick="removePhoto(' + i + ')" style="position:absolute;top:2px;right:2px;width:16px;height:16px;background:rgba(0,0,0,0.6);color:#fff;border:none;font-size:10px;cursor:pointer;border-radius:50%;display:flex;align-items:center;justify-content:center;">×</button>'; container.appendChild(d); }); }
      function addPhoto() { var val = $("photo-input").value.trim(); if (val) { photos.push(val); renderPhotos(); $("photo-input").value = ""; } }
      function removePhoto(index) { photos.splice(index, 1); renderPhotos(); }
      $("photo-input").addEventListener("keydown", function(e) { if (e.key === "Enter") { e.preventDefault(); addPhoto(); } });

      // ---- 图床上传（带查重） ----
      var IMGBED_URL = _script.getAttribute("data-imgbed-url") || "";
      var IMGBED_CODE = _script.getAttribute("data-imgbed-code") || "";
      var IMGBED_FOLDER = _script.getAttribute("data-imgbed-folder") || "";
      var IMGBED_TOKEN = _script.getAttribute("data-imgbed-token") || "";

      function triggerPlaceUpload() {
        if (!IMGBED_URL) { toast("未配置图床地址（PUBLIC_IMAGEBED_URL）", "err"); return; }
        $("place-file-input").click();
      }

      $("place-file-input").addEventListener("change", function(e) {
        var files = e.target.files;
        if (!files || !files.length) return;
        uploadPlaceFiles(Array.prototype.slice.call(files));
        e.target.value = "";
      });

      async function checkFileExists(filename) {
        if (!IMGBED_TOKEN) return null;
        try {
          // search 参数必须配合 dir 才能搜到文件
          var params = ["search=" + encodeURIComponent(filename), "count=10"];
          if (IMGBED_FOLDER) params.push("dir=" + encodeURIComponent(IMGBED_FOLDER));
          var url = IMGBED_URL + "/api/manage/list?" + params.join("&");
          var resp = await fetch(url, { headers: { "Authorization": "Bearer " + IMGBED_TOKEN } });
          if (!resp.ok) return null;
          var data = await resp.json();
          if (data.files && data.files.length > 0) {
            for (var i = 0; i < data.files.length; i++) {
              var file = data.files[i];
              // 优先用 metadata.FileName（原始文件名），因为 name 字段可能带时间戳前缀
              var serverName = (file.metadata && file.metadata.FileName) || (file.name || "").split("/").pop();
              if (serverName === filename) {
                return IMGBED_URL + "/file/" + file.name;
              }
            }
          }
        } catch (e) { /* 静默失败，走上传流程 */ }
        return null;
      }

      async function uploadPlaceFiles(files) {
        var btn = $("place-upload-btn"), status = $("place-upload-status");
        btn.disabled = true;
        status.textContent = "处理中 0/" + files.length;
        status.style.color = "var(--text-3)";
        var done = 0, ok = 0, reused = 0;

        for (var i = 0; i < files.length; i++) {
          var file = files[i];
          try {
            // 查重：检查图床是否已有同名文件
            var existingUrl = await checkFileExists(file.name);
            if (existingUrl) {
              photos.push(existingUrl);
              reused++;
            } else {
              var url = await uploadSinglePlaceImage(file);
              photos.push(url);
              ok++;
            }
            renderPhotos();
          } catch (err) {
            toast(file.name + ": " + err.message, "err");
          }
          done++;
          status.textContent = "处理中 " + done + "/" + files.length;
        }

        btn.disabled = false;
        var msg = [];
        if (ok > 0) msg.push(ok + " 张上传");
        if (reused > 0) msg.push(reused + " 张复用");
        if (msg.length > 0) {
          status.textContent = "✓ " + msg.join("，");
          status.style.color = "var(--success)";
          toast(msg.join("，") + " 成功", "ok");
        } else {
          status.textContent = "上传失败";
          status.style.color = "var(--danger)";
        }
        setTimeout(function() { status.textContent = ""; }, 4000);
      }

      function uploadSinglePlaceImage(file) {
        var formData = new FormData();
        formData.append("file", file);
        var params = ["returnFormat=full", "uploadNameType=origin"];
        if (IMGBED_CODE) params.push("authCode=" + encodeURIComponent(IMGBED_CODE));
        if (IMGBED_FOLDER) params.push("uploadFolder=" + encodeURIComponent(IMGBED_FOLDER));
        var url = IMGBED_URL + "/upload?" + params.join("&");
        return fetch(url, { method: "POST", body: formData }).then(function(r) {
          if (!r.ok) throw new Error("HTTP " + r.status);
          return r.json();
        }).then(function(data) {
          if (Array.isArray(data) && data.length > 0 && data[0].publicUrl) return data[0].publicUrl;
          if (Array.isArray(data) && data.length > 0 && data[0].src) return data[0].src;
          if (data && data.publicUrl) return data.publicUrl;
          if (data && data.src) return data.src;
          throw new Error("响应格式异常");
        });
      }

      async function fetchCoordinates() { var province = $("field-province").value.trim(), city = $("field-city").value.trim(), addr = $("field-address").value.trim(); if (!province && !city && !addr) { toast("请先填写地址", "err"); return; } var fullAddress = [province, city, addr].filter(Boolean).join(" "); var btn = document.querySelector('[onclick="fetchCoordinates()"]'); var origHtml = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spinner" style="width:12px;height:12px;"></span>'; try { var resp = await fetch("https://restapi.amap.com/v3/geocode/geo?address=" + encodeURIComponent(fullAddress) + "&key=" + AMAP_KEY); var data = await resp.json(); var lng = "", lat = "", rp = "", rc = ""; if (data.status === "1" && data.geocodes && data.geocodes.length > 0) { var loc = data.geocodes[0].location.split(","); lng = loc[0]; lat = loc[1]; rp = data.geocodes[0].province || ""; rc = data.geocodes[0].city || ""; } else { var poiResp = await fetch("https://restapi.amap.com/v3/place/text?keywords=" + encodeURIComponent(fullAddress) + "&key=" + AMAP_KEY + "&offset=1"); var poiData = await poiResp.json(); if (poiData.status === "1" && poiData.pois && poiData.pois.length > 0) { var pl = poiData.pois[0].location.split(","); lng = pl[0]; lat = pl[1]; } } if (lng && lat) { $("field-lng").value = lng; $("field-lat").value = lat; if (!province && rp) $("field-province").value = rp; if (addr) $("field-city").value = addr; else if (!city && rc) $("field-city").value = rc; toast("坐标获取成功 ✓", "ok"); updatePreview(); } else { toast("未找到该地点", "err"); } } catch (e) { toast("获取失败: " + e.message, "err"); } finally { btn.disabled = false; btn.innerHTML = origHtml; } }

      function updatePreview() { var name = [$("field-province").value.trim(), $("field-city").value.trim()].filter(Boolean).join(" · "); var card = $("preview-card"); if (name) { card.classList.remove("d-none"); $("preview-name").textContent = name; var m = []; if ($("field-date").value) m.push($("field-date").value); if ($("field-count").value) m.push("到访 " + $("field-count").value + " 次"); if ($("field-lat").value && $("field-lng").value) m.push("已获取坐标"); $("preview-meta").textContent = m.join(" · "); } else { card.classList.add("d-none"); } }
      ["field-province", "field-city", "field-date", "field-count", "field-lat", "field-lng"].forEach(function(id) { $(id).addEventListener("input", updatePreview); });

      async function submitPlace() { var province = $("field-province").value.trim(), city = $("field-city").value.trim(); var lat = $("field-lat").value.trim(), lng = $("field-lng").value.trim(); if (!province && !city) { toast("请填写省份或城市", "err"); return; } if (!lat || !lng) { toast("请获取或填写经纬度", "err"); return; } if (!TOKEN || !GIST_ID) { toast("请先设置 Token", "err"); return; } var btn = $("submit-btn"); btn.disabled = true; btn.textContent = "保存中..."; var success = await saveToGist({ province: province, city: city, lat: lat, lng: lng, date: $("field-date").value || new Date().toISOString().split("T")[0], experience: $("field-experience").value.trim(), tags: tags, url: $("field-url").value.trim(), urlLabel: $("field-url-label").value.trim(), photos: photos, visitCount: parseInt($("field-count").value) || 1 }, editingId); if (success) { toast(editingId ? "已更新 ✓" : "保存成功 ✓", "ok"); clearForm(); loadPlacesList(); } btn.disabled = false; btn.textContent = "保存"; }

      async function loadPlacesList() { var list = $("places-list"); list.innerHTML = '<div class="text-center text-secondary" style="padding:24px;"><span class="spinner"></span></div>'; if (!TOKEN || !GIST_ID) { list.innerHTML = '<div class="text-center text-tertiary" style="padding:24px;">请先设置 Token</div>'; $("list-count").textContent = ""; return; } try { var entries = await fetchGistEntries(); if (!entries || !entries.length) { list.innerHTML = '<div class="text-center text-tertiary" style="padding:32px;">还没有足迹数据</div>'; $("list-count").textContent = ""; return; } entries.sort(function(a, b) { return new Date(b.date) - new Date(a.date); }); $("list-count").textContent = entries.length + " 个"; list.innerHTML = ""; entries.forEach(function(item) { var d = document.createElement("div"); d.className = "list-row"; var name = [item.province, item.city].filter(Boolean).join(" · ") || "未命名"; var mp = [item.date]; if (item.visitCount) mp.push("到访 " + item.visitCount + " 次"); if (!item.lat || !item.lng) mp.push("缺少坐标"); if (item.tags && item.tags.length) mp.push(item.tags.join(", ")); d.innerHTML = '<div class="flex-1 min-w-0"><div class="fw-500" style="font-size:13px;">' + esc(name) + '</div>' + (item.experience ? '<div class="text-secondary text-truncate" style="font-size:12px;">' + esc(item.experience) + '</div>' : '') + '<div class="text-tertiary" style="font-size:11px;">' + mp.join(" · ") + '</div></div>' + '<div class="d-flex gap-1"><button class="btn btn-ghost btn-sm" onclick="editPlace(\'' + esc(item.id) + '\')">编辑</button><button class="btn btn-ghost btn-sm btn-danger" onclick="deletePlace(\'' + esc(item.id) + '\')">删除</button></div>'; list.appendChild(d); }); } catch (e) { list.innerHTML = '<div class="text-center text-danger" style="padding:24px;">加载失败</div>'; } }

      async function editPlace(entryId) { try { var entries = await fetchGistEntries(); var item = entries.find(function(e) { return e.id === entryId; }); if (!item) { toast("未找到", "err"); return; } editingId = entryId; $("field-province").value = item.province || ""; $("field-city").value = item.city || ""; $("field-address").value = ""; $("field-lng").value = item.lng || ""; $("field-lat").value = item.lat || ""; $("field-date").value = item.date || ""; $("field-count").value = item.visitCount || 1; $("field-experience").value = item.experience || ""; $("field-url").value = item.url || ""; $("field-url-label").value = item.urlLabel || ""; tags = item.tags || []; photos = item.photos || []; renderTags(); renderPhotos(); updatePreview(); $("submit-btn").textContent = "保存修改"; toast("正在编辑: " + ([item.province, item.city].filter(Boolean).join(" · ") || "未命名"), "ok"); window.scrollTo({ top: 0, behavior: "smooth" }); } catch (e) { toast("加载失败", "err"); } }
      async function deletePlace(entryId) { if (!confirm("确定删除这个足迹？")) return; var success = await deleteFromGist(entryId); if (success) { if (editingId === entryId) clearForm(); toast("已删除", "ok"); loadPlacesList(); } else { toast("删除失败", "err"); } }
      function clearForm() { editingId = null; $("field-province").value = ""; $("field-city").value = ""; $("field-address").value = ""; $("field-lat").value = ""; $("field-lng").value = ""; $("field-date").value = new Date().toISOString().split("T")[0]; $("field-count").value = "1"; $("field-experience").value = ""; $("field-url").value = ""; $("field-url-label").value = ""; $("photo-input").value = ""; tags = []; photos = []; renderTags(); renderPhotos(); $("preview-card").classList.add("d-none"); $("submit-btn").textContent = "保存"; }

      window.fetchCoordinates = fetchCoordinates; window.submitPlace = submitPlace; window.addTag = addTag; window.removeTag = removeTag; window.addPhoto = addPhoto; window.removePhoto = removePhoto; window.triggerPlaceUpload = triggerPlaceUpload; window.editPlace = editPlace; window.deletePlace = deletePlace; window.clearForm = clearForm;

      (function() { if (sessionStorage.getItem("admin_auth") !== "1") { window.location.href = "/admin/"; return; } $("field-date").value = new Date().toISOString().split("T")[0]; checkAndLoad(); })();
    })();
  </script>
</AdminLayout>
