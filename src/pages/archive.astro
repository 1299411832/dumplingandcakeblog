---
import ArchivePanel from "@components/controls/ArchivePanel.svelte";
import ArchiveHeatmap from "@components/widget/ArchiveHeatmap.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { getArchiveList, getSortedPostsList } from "@/utils/content-utils";

const archiveList = await getArchiveList();
const sortedPostsList = await getSortedPostsList();
const title = i18n(I18nKey.archive);

// 年份列表（与 ArchiveHeatmap 同源计算，用于标题行年份切换）
const yearsSet = new Set<number>();
for (const p of sortedPostsList) yearsSet.add(p.data.published.getFullYear());
const availableYears = Array.from(yearsSet).sort((a, b) => b - a);
const defaultYear = availableYears[0] ?? new Date().getFullYear();
---

<MainGridLayout title={title}>
  <div class="flex w-full overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
      <!-- 顶部一行（左上角）：归档标题 + 年份切换 -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-3">
        <div class="flex items-center gap-2">
          <Icon name="material-symbols:schedule-outline-rounded" class="text-[1.875rem]" />
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {title}
          </div>
        </div>
        <div class="heatmap-year-nav">
          {availableYears.map((y) => (
            <button
              class="heatmap-year-btn"
              data-active={y === defaultYear ? "" : undefined}
              data-year={y}
            >
              {y}
            </button>
          ))}
        </div>
      </div>
      <ArchiveHeatmap posts={sortedPostsList} showYearNav={false} />
      <ArchivePanel sortedPosts={archiveList} client:load />
    </div>
  </div>
</MainGridLayout>
