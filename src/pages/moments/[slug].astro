---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import MomentCard from "@/components/moments/MomentCard.astro";
import { commentConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

// 生成静态路径
export async function getStaticPaths() {
	const moments = await getCollection("moments");
	return moments.map((moment) => ({
		params: { slug: moment.id },
		props: { moment },
	}));
}

const { moment } = Astro.props;
await render(moment);
const { author, published } = moment.data;

const walineServerURL = commentConfig.waline?.serverURL || "";
---

<MainGridLayout
	title={`${author || "匿名"} 的说说 - ${formatDateToYYYYMMDD(published)}`}
	description={moment.body?.slice(0, 160) || "说说详情"}
>
	<div class="moment-detail-container">
		<!-- 返回按钮 -->
		<a href="/moments/" class="back-btn">
			<Icon name="material-symbols:arrow-back" class="back-icon" />
			<span>返回动态</span>
		</a>

		<!-- 复用 MomentCard，detail 模式下评论区始终展开 -->
		<MomentCard moment={moment} detail={true} />
	</div>
</MainGridLayout>

<script is:inline define:vars={{ walineServerURL }}>
	// 自动初始化详情页评论区，最低加载 3 秒
	(function () {
		if (!walineServerURL) return;

		var container = document.querySelector("[data-auto-init]");
		if (!container) return;

		var commentPath = container.getAttribute("data-auto-init");
		if (!commentPath) return;

		var loader = document.querySelector(".comment-loader");
		var commentSection = document.querySelector(".card-comment-section");
		var MIN_LOAD_TIME = 2000;
		var loaded = false;
		var timerDone = false;

		function tryShowComments() {
			if (!loader || !commentSection) return;
			if (loaded && timerDone) {
				// 隐藏加载动画
				loader.classList.add("is-hidden");
				// 展开评论区
				setTimeout(function () {
					commentSection.classList.add("is-expanded");
					setTimeout(function () {
						loader.remove();
					}, 400);
				}, 200);
			}
		}

		// 最低 3 秒计时
		setTimeout(function () {
			timerDone = true;
			tryShowComments();
		}, MIN_LOAD_TIME);

		// 加载样式
		if (!document.querySelector('link[href*="waline"]')) {
			var link = document.createElement("link");
			link.rel = "stylesheet";
			link.href = "https://unpkg.com/@waline/client@v3/dist/waline.css";
			document.head.appendChild(link);
		}

		// 初始化 Waline
		import("https://unpkg.com/@waline/client@v3/dist/waline.js").then(
			function (mod) {
				mod.init({
					el: "#" + container.id,
					serverURL: walineServerURL,
					path: commentPath,
					lang: "zh-CN",
					dark: "html.dark",
					wordLimit: [2, 300],
					pageview: true,
					comment: true,
				});

				// 轮询检查 Waline 是否渲染完成
				var checkCount = 0;
				var checkInterval = setInterval(function () {
					checkCount++;
					var wlCard = container.querySelector(".wl-card");
					if (wlCard || checkCount > 60) {
						clearInterval(checkInterval);
						loaded = true;
						tryShowComments();
					}
				}, 200);
			},
		).catch(function () {
			loaded = true;
			tryShowComments();
		});
	})();
</script>

<style>
	.moment-detail-container {
		padding: 1rem 0 2rem;
	}

	.back-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.5rem 1rem;
		margin-bottom: 1.5rem;
		color: var(--content-meta);
		font-size: 0.875rem;
		text-decoration: none;
		border-radius: var(--radius);
		transition: all 0.2s ease;
	}

	.back-btn:hover {
		color: var(--primary);
		background: var(--btn-regular-bg);
	}

	.back-icon {
		width: 1.125rem;
		height: 1.125rem;
	}

	@media (max-width: 480px) {
		.moment-detail-container {
			padding: 0.75rem 0 1.5rem;
		}
	}
</style>
